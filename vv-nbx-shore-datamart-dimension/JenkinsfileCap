def workSpaceDir = "/var/lib/jenkins/workspace/${JOB_NAME}-${params.environment}"
def jenkinsGlobalProps = "/var/lib/jenkins/workspace/vv-bigdata-global-jenkins-properties/jenkins-properties/jenkins_file.properties"
def props = null

def branchVerion = "feature"
def nbx_jar_build_location = "/var/lib/jenkins/nbx_gcp_build_jars"

pipeline {

  agent {
      node {
          label 'master'
      }
  }

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }

  stages {
		
        stage('Checkout') {
            steps {
                echo "*********** ${params.environment} DEPLOYMENT STARTED FROM BRANCH ${branch} ***********************"
				cleanWs()
                checkout([$class: 'GitSCM',
					branches: [[name: "${branch}"]],
					extensions: [[$class: 'RelativeTargetDirectory', 
						relativeTargetDir: workSpaceDir]],
					userRemoteConfigs: [[
					credentialsId: 'jenkins-cicd',
					url: 'git@bitbucket.org:VirginVoyages/bigdata-nbx-shore-etl.git']]
				])
				echo "tagetdir :${workSpaceDir}"	
				script {	
					props = readProperties file: "${jenkinsGlobalProps}"
					echo "Jobserver : ${props.jobServerdev}"
					def branchVTemp = "${branch}" =~ /(\bSprint.*\b)/
					branchVerion = branchVTemp[0][1]
				}
			}
		}

        stage('Build') {

            steps {

              withMaven(maven: 'M2_HOME', mavenOpts: '-Xmx4096m -Xms4096m') {
                sh "ls -la"
                sh "pwd"
                sh "mvn -B -f ${workSpaceDir}/vv-nbx-shore-datamart-dimension/pom.xml clean install -DskipTests=true"
              }

            }
        }

        stage('Copy artifacts - DEV') {
			when {
			  expression { params.environment == 'dev' } 
			}
            steps {
			
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/*/target/*.jar jenkins@${props.jobServerdev}:/data/apps/talend/shared/scripts/nbx/Dim/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-wearable-dim/resource/*dev.conf  jenkins@${props.jobServerdev}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-cti-skill-dim/resources/*Dev.conf  jenkins@${props.jobServerdev}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-venue-availability-dim/resources/*dev.conf  jenkins@${props.jobServerdev}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-charge-dim/resources/*dev.conf  jenkins@${props.jobServerdev}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-team-dim/resources/*dev.conf  jenkins@${props.jobServerdev}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-campaign-dim/resources/*dev.conf  jenkins@${props.jobServerdev}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				echo 'Copy stage successful!'
              }
       }
	   
	   stage('Copy artifacts - INT') {
			when {
			  expression { params.environment == 'int' } 
			}
            steps {
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/*/target/*.jar jenkins@${props.jobServerint}:/data/apps/talend/shared/scripts/nbx/Dim/"
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-wearable-dim/resource/*integration.conf  jenkins@${props.jobServerint}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-cti-skill-dim/resource/*Integration.conf  jenkins@${props.jobServerint}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-venue-availability-dim/resource/*integration.conf  jenkins@${props.jobServerint}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-charge-dim/resource/*integration.conf  jenkins@${props.jobServerint}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-team-dim/resource/*integration.conf  jenkins@${props.jobServerint}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-campaign-dim/resource/*integration.conf  jenkins@${props.jobServerint}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				echo 'Copy stage successful!'
              }
       }
	   
	   stage('Copy artifacts - QA') {
			when {
			  expression { params.environment == 'qa' } 
			}
            steps {
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/*/target/*.jar jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Dim/"
				//sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-wearable-dim/resource/*qa.conf  //jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-cti-skill-dim/resources/*QA.conf  jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-venue-availability-dim/resources/*qa.conf  jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-charge-dim/resources/*qa.conf  jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-team-dim/resources/*qa.conf  jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-campaign-dim/resources/*qa.conf  jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				// Config copy
				sh "scp ${workSpaceDir}/configs/dimension_configs/qa/* jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/configs/ingestion_configs/qa/* jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Ship-to-shore/config/"
				
				sh "scp ${workSpaceDir}/configs/seaware_ing_configs/qa/* jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Ship-to-shore/seaware_config/"
				
				sh "scp ${workSpaceDir}/configs/debezium_config/qa/* jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/Ship-to-shore/debezium_config/"
				
				
				echo 'Copy stage successful!'
				
				echo "uploading jar to google storage"
				
			    echo "branch Version : ${branchVerion}"
				
			    sh "mkdir -p /var/lib/jenkins/nbx_gcp_build_jars/${branchVerion}/dims/"
				
			    sh "cp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/*/target/*.jar ${nbx_jar_build_location}/${branchVerion}/dims/"
				
			    sh "source ~/.bash_profile && gsutil cp -r ${nbx_jar_build_location} gs://nbx-nonprod-build-jars/"
				
			    sh "rm ${nbx_jar_build_location}/${branchVerion}/dims/*.jar"
              }
       }
	   
	   
	   stage('Copy artifacts - STG') {
			when {
			  expression { params.environment == 'stage' } 
			}
            steps {
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/*/target/*.jar jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Dim/"
				//sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-wearable-dim/resource/*stage.conf  //jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-cti-skill-dim/resources/*stage.conf  jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				//sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-venue-availability-dim/resources/*stage.conf  jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-charge-dim/resources/*stage.conf  jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-team-dim/resources/*stage.conf  jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-dimension/vv-nbx-datamart-campaign-dim/resources/*stage.conf  jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				// Config copy
				sh "scp ${workSpaceDir}/configs/dimension_configs/stage/* jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Dim/config/"
				
				sh "scp ${workSpaceDir}/configs/ingestion_configs/stage/* jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Ship-to-shore/config/"
				
				sh "scp ${workSpaceDir}/configs/seaware_ing_configs/stage/* jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Ship-to-shore/seaware_config/"
				
				sh "scp ${workSpaceDir}/configs/debezium_config/stage/* jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/Ship-to-shore/debezium_config/"
				
				echo 'Copy stage successful!'
              }
       }
    }
}	
