			<version>0.0.1-SNAPSHOT</version>
			<scope>provided</scope>
			<!--<scope>system</scope>
			<systemPath>C:\VV_GCP_jars\virginvoyages_shore_metadata-0.0.1-SNAPSHOT-jar-with-dependencies.jar</systemPath> -->
		</dependency>

		<dependency>
			<groupId>com.virginvoyages.shore.scd</groupId>
			<artifactId>shore-datamart-scd</artifactId>
			<version>0.0.1-SNAPSHOT</version>
			<scope>provided</scope>
			<!--<scope>system</scope>
			<systemPath>C:\VV_GCP_jars\shore-datamart-scd-0.0.1-SNAPSHOT.jar</systemPath>-->
		</dependency>

		<!-- https://mvnrepository.com/artifact/org.apache.spark/spark-sql -->
