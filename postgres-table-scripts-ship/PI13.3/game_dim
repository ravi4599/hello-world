CREATE TABLE hive_schema_stg.game_dim (
	voyage_id text NULL,
	game_skey bigint NOT NULL,
	game_id text NOT NULL,
	game_name text NOT null,
	game_master_prom text NULL,
	game_is_bet_type_flag boolean NULL,
	load_dt timestamp NULL,
	upd_dt timestamp NULL,
	primaryhash text NULL,
	md5_hash text NULL
);


create view shipdw.game_dim as select * from hive_schema_stg.game_dim;