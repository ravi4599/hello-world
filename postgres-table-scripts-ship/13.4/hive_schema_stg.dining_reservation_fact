DROP TABLE hive_schema_stg.dining_reservation_fact;

CREATE TABLE hive_schema_stg.dining_reservation_fact (
	voyage_id text NULL,
	voyage_skey int8 NULL,
	ship_code text NULL,
	dining_reservation_detail_skey int8 NULL,
	venue_skey int8 NULL,
	reservation_booked_datetime_utc timestamp NULL,
	reservation_datetime timestamp NULL,
	reservation_upcoming_datetime timestamp NULL,
	reservation_waitlist_datetime timestamp NULL,
	reservation_seated_datetime timestamp NULL,
	reservation_completed_datetime timestamp NULL,
	reservation_canceled_datetime timestamp NULL,
	reservation_upcoming_datetime_utc timestamp NULL,
	reservation_waitlist_datetime_utc timestamp NULL,
	reservation_seated_datetime_utc timestamp NULL,
	reservation_completed_datetime_utc timestamp NULL,
	reservation_canceled_datetime_utc timestamp NULL,
	wait_time_in_seconds int4 NULL,
	waitlist_delay int4 NULL,
	table_turn_time_in_seconds int4 NULL,
