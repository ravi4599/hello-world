    drf.reservation_upcoming_datetime_utc,
    drf.reservation_waitlist_datetime_utc,
    drf.reservation_seated_datetime_utc,
    drf.reservation_completed_datetime_utc,
    drf.reservation_canceled_datetime_utc,
    drf.wait_time_in_seconds,
    drf.waitlist_delay,
    drf.table_turn_time_in_seconds,
    drf.reservation_number_of_guests,
    drf.total_party_size,
    drf.reservation_checkout_datetime_utc,
    drf.party_size_seated,
    drf.dining_session_skey,
    drf.expected_duration,
    drf.load_dt,
