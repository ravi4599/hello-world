	item_plu_number text  NOT NULL,
	item_name text  NULL,
	item_plu_group_number text NULL,
	item_plu_group_name text NULL,
	item_plu_category_number int8 NULL,
	item_plu_category_name text NULL,
	ship_code text NULL,
	src_updated_datetime timestamp NULL,
	src_deleted_flag boolean NULL,
	src_active_flag boolean NULL,
	item_plu_type text NULL,
	load_dt timestamp NULL,
	upd_dt timestamp NULL,
