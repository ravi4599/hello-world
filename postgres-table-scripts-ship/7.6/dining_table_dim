DROP VIEW IF EXISTS shipdw.dining_table_dim;
DROP TABLE hive_schema_stg.dining_table_dim;

CREATE TABLE hive_schema_stg.dining_table_dim (
	dining_table_skey bigint ,
	voyage_id text ,
	dining_table_id text ,
	table_number text ,
	table_size int ,
	table_created_utc timestamp ,
	load_dt timestamp ,
	upd_dt timestamp ,
	primaryhash text ,
	md5_hash text 
);

CREATE OR REPLACE VIEW shipdw.dining_table_dim AS SELECT * FROM hive_schema_stg.dining_table_dim ;