DROP VIEW IF EXISTS shipdw.dining_reservation_fact;
DROP TABLE hive_schema_stg.dining_reservation_fact;

CREATE TABLE hive_schema_stg.dining_reservation_fact (
	voyage_id text ,
	voyage_skey bigint,
	dining_reservation_detail_skey bigint,
	venue_skey bigint,
	reservation_booked_datetime_utc timestamp ,
	reservation_datetime timestamp ,
	reservation_upcoming_datetime timestamp ,
	reservation_waitlist_datetime timestamp ,
	reservation_seated_datetime timestamp ,
	reservation_completed_datetime timestamp ,
	reservation_canceled_datetime timestamp ,
	reservation_upcoming_datetime_utc timestamp ,
	reservation_waitlist_datetime_utc timestamp ,
	reservation_seated_datetime_utc timestamp ,
	reservation_completed_datetime_utc timestamp ,
	wait_time_in_seconds int ,
	waitlist_delay int ,
	table_turn_time_in_seconds int,
	reservation_number_of_guests int ,
	total_party_size int ,
	load_dt timestamp ,
	upd_dt timestamp ,
	part_dt date 
);

CREATE OR REPLACE VIEW shipdw.dining_reservation_fact AS SELECT * FROM hive_schema_stg.dining_reservation_fact ;
