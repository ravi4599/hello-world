	<repositories>
		<repository>
		  <id>confluent</id>
		  <url>http://packages.confluent.io/maven/</url>
		  <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
		</repository>
	</repositories>

	<dependencies>

	
		<dependency>
			<groupId>com.virginvoyages.metadataframework</groupId>
	<artifactId>virginvoyages_shore_metadata</artifactId>
			<version>0.0.1-SNAPSHOT</version>
			 <scope>provided</scope>
