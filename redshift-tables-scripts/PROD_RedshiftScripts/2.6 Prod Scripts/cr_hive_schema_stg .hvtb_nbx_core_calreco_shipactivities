CREATE EXTERNAL TABLE hive_schema_stg.hvtb_nbx_core_calreco_shipactivities
(
  activity_id varchar(10), 
  activity_title varchar(100), 
  type varchar(20), 
  activity_description varchar(256),
  venue varchar(50),
  day_time varchar(50),
  capacity varchar(50),
  visible_to_sailor varchar(50),
  hero_events varchar(50),
  bookable varchar(50),
  love_listed varchar(50),
  invite_only varchar(50),
  vip_only varchar(50),
  rainy_day varchar(50),
  fee varchar(50),
  waitlist varchar(50),
  standby varchar(50),
  notification varchar(50),
   tribe varchar(20),
   sub_tribe varchar(20)
  )
ROW FORMAT SERDE 
  'org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe' 
WITH SERDEPROPERTIES ( 
  'field.delim'=',', 
  'line.delim'='\n', 
  'serialization.format'=',') 
STORED AS INPUTFORMAT 
  'org.apache.hadoop.mapred.TextInputFormat' 
OUTPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat'
LOCATION
  's3://vv-prod-emr-cluster/data/core/calendar_recommendation/activity_list'
;
