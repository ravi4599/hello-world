CREATE EXTERNAL TABLE hive_schema_stg.venue_dim(
voyage_id varchar(100),
venue_skey int4,
venue_id varchar(100),
venue_name varchar(100),
venue_sector_name varchar(100),
data_src varchar(100),
density_threshold_1 int,
density_threshold_2 int,
ship_code varchar(10),
load_dt timestamp,
upd_dt timestamp,
primaryhash varchar(100),
md5_hash varchar(100))
STORED AS PARQUET LOCATION 's3://vv-dev-emr-cluster/data/mart/hvtb_mart_dim_venue';

CREATE OR REPLACE VIEW shipdw.venue_dim as select * from hive_schema_stg.venue_dim with no schema binding;

