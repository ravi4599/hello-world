CREATE EXTERNAL TABLE hive_schema_stg.pos_item_dim(
	voyage_id varchar(100),
	item_skey bigint,
	item_plu_number varchar(100),
	item_name varchar(500),
	item_plu_group_number varchar(100),
	item_plu_group_name varchar(500),
	item_plu_category_number varchar(100),
	item_plu_category_name varchar(500),
	ship_code varchar(10),
	src_updated_datetime timestamp,
	src_deleted_flag boolean,
	src_active_flag boolean,
	item_plu_type char(1),
	load_dt timestamp,
    upd_dt timestamp,
    primaryhash varchar(100),
    md5_hash varchar(100)
	)STORED AS PARQUET LOCATION 's3://vv-prod-emr-cluster/data/mart/hvtb_mart_dim_pos_item';





create or replace view shipdw.pos_item_dim as select * from hive_schema_stg.pos_item_dim with no schema binding;


