  <value>tez</value>
</property>

  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://ip-10-3-100-145.ec2.internal:8020</value>
  </property>


  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://ip-10-3-100-145.ec2.internal:9083</value>
    <description>JDBC connect string for a JDBC metastore</description>
  </property>

  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:mysql://emr-dev-hive-metastore.cbduemg5i5w8.us-east-1.rds.amazonaws.com:3306/setsaildb</value>
