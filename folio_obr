	spark.sql(""" insert overwrite table shipdw.FOLIO_OBR
 SELECT Person_Account_Items.PERSON_ACCOUNT_DETAIL_ID as Transaction_ID, Person_Account_Items.*
,Org_Units.ORG_UNIT_NAME AS CreatedAtInstallation
,orgunitquickcodes.ORG_UNIT_QUICK_NAME
,Org_Structure.ORG_STRUCTURE_NAME
,Cruise.CRUISE_NUMBER
,Persons.PERSON_EXTERNAL2_ID as Seaware_Client_ID
,Person_Booking.EXTERNAL_BOOKING_ID
,CONCAT(Persons.PERSON_FIRST_NAME,' ',Persons.PERSON_LAST_NAME) as Sailor_Name
FROM (select * from (select *, row_number() over (partition by PERSON_ACCOUNT_DETAIL_ID,PERSON_ACCOUNT_ID order by last_changed desc) as r from  shipdw.hvtb_parse_mxp_person_account_items)t where r = 1 )Person_Account_Items
LEFT OUTER JOIN (select * from (select *, row_number() over (partition by person_id,PERSON_ACCOUNT_ID order by last_changed desc) as r from  shipdw.hvtb_parse_mxp_person_account)t where r = 1 )  Person_Accounts ON Person_Account_Items.PERSON_ACCOUNT_ID = Person_Accounts.PERSON_ACCOUNT_ID
LEFT OUTER JOIN (select * from (select *, row_number() over (partition by CRUISE_ID order by last_changed desc) as r from  shipdw.hvtb_parse_mxp_cruise)t where r = 1 )  Cruise ON Person_Account_Items.PERIOD_ID = Cruise.CRUISE_ID
left join (select * from (select *,row_number() over (partition by org_unit_quick_code_id,org_unit_quick_code order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_orgunitquickcodes where rec_deleted = false) where rn = 1) orgunitquickcodes on (Person_Account_Items.org_unit_quick_code_id = orgunitquickcodes.org_unit_quick_code_id)
LEFT OUTER JOIN (select * from (select *, row_number() over (partition by ORG_STRUCTURE_ID,ORG_UNIT_ID order by last_changed desc) as r from  shipdw.hvtb_parse_mxp_org_structure)t where r = 1 )  Org_Structure ON Person_Account_Items.ORG_STRUCTURE_ID = Org_Structure.ORG_STRUCTURE_ID
LEFT OUTER JOIN (select * from (select *, row_number() over (partition by ORG_UNIT_ID order by last_changed desc) as r from  shipdw.hvtb_parse_mxp_org_units)t where r = 1 )  Org_Units ON cast(Person_Account_Items.CREATED_AT_ID as int) = Org_Units.ORG_UNIT_ID 
LEFT OUTER JOIN (select * from (select *, row_number() over (partition by person_id order by last_changed desc) as r from  shipdw.hvtb_parse_mxp_persons)t where r = 1 and rec_deleted = false)  Persons ON Person_Accounts.PERSON_ID = Persons.PERSON_ID 
LEFT OUTER JOIN (select * from (select *, row_number() over (partition by person_id,person_booking_id order by last_changed desc) as r from  shipdw.hvtb_parse_mxp_person_booking where person_booking_id > 0)t where r = 1 )  Person_Booking ON Persons.PERSON_ID = Person_Booking.PERSON_ID 
--where Person_Account_Items.person_account_id = 20326630
ORDER BY Person_Account_Items.CREATED""")

