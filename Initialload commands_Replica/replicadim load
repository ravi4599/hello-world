val srcDF = spark.sql("""select res_promo_id,res_id,guest_id,package_id,addon_id,cardeck_id as carddeck_id,shorex_id,hotel_id,promotion_id,rec_start_dttm,rec_end_dttm,is_active,is_excluded,promo_mode,etl_ld_status,etl_ld_dt,etl_upd_dt from (select rp.res_promo_id as res_promo_id,rp.res_id as res_id,rp.guest_id as guest_id,pk.package_id as package_id,rp.promo_code as promo_code from vv_db.hvtb_parse_sw_rpl_res_promotion rp left join vv_db.hvtb_parse_sw_rpl_res_package pk on rp.res_package_id = pk.res_package_id and rp.guest_id = pk.guest_id) srcq join (select pd.addon_id,pd.cardeck_id,pd.shorex_id,pd.hotel_id,pd.promotion_id,pd.rec_start_dttm,pd.rec_end_dttm,pd.is_active,pd.is_excluded,pd.promo_mode,pd.etl_ld_status,pd.etl_ld_dt,pd.etl_upd_dt,rd.src_res_id, gd.src_guest_id, pk.src_package_id, pl.promo_code from vv_db.hvtb_nbx_core_sw_promotion_dim pd left join vv_db.hvtb_nbx_core_sw_reservation_dim rd on pd.res_id=rd.res_id left join vv_db.hvtb_nbx_core_sw_guest_dim gd on pd.guest_id=gd.guest_id left join vv_db.hvtb_nbx_core_sw_package_dim pk on pk.package_id=pd.package_id left join vv_db.hvtb_nbx_core_sw_promotion_lkp pl on pd.promotion_id=pl.promotion_id) tgtq on srcq.res_id = tgtq.src_res_id and srcq.guest_id = tgtq.src_guest_id and srcq.package_id = tgtq.src_package_id and srcq.promo_code = tgtq.promo_code""")
