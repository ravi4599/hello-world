def workSpaceDir = "/var/lib/jenkins/workspace/${JOB_NAME}-${params.environment}"
def jenkinsGlobalProps = "/var/lib/jenkins/workspace/vv-bigdata-global-jenkins-properties/jenkins-properties/jenkins_file.properties"
def props = null
def branchVerion = "feature"
def nbx_jar_build_location = "/var/lib/jenkins/nbx_gcp_build_jars"

pipeline {

  agent {
      node {
          label 'master'
      }
  }

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }

  stages {

        stage('Checkout') {

            steps {
                cleanWs()
				checkout([$class: 'GitSCM',
					branches: [[name: "${branch}"]],
					extensions: [[$class: 'RelativeTargetDirectory', 
						relativeTargetDir: workSpaceDir]],
					userRemoteConfigs: [[
					credentialsId: 'jenkins-cicd',
					url: 'git@bitbucket.org:VirginVoyages/bigdata-nbx-shore-etl.git']]
				])
				echo "tagetdir :${workSpaceDir}"	
				script {	
					props = readProperties file: "${jenkinsGlobalProps}"
					echo "Jobserver : ${props.jobServerdev}"
					def branchVTemp = "${branch}" =~ /(\bSprint.*\b)/
					branchVerion = branchVTemp[0][1]
				}
        	}
        }

        stage('Build') {

            steps {

              withMaven(maven: 'M2_HOME', mavenOpts: '-Xmx4096m -Xms4096m') {
                sh "ls -la"
                sh "pwd"
                sh "mvn -B -f ${workSpaceDir}/vv-nbx-shore-datamart-scd/pom.xml install -DskipTests=true"
              }

            }
        }

        stage('Copy artifacts - DEV') {
			when {
			  expression { params.environment == 'dev' } 
			}
            steps {
              echo 'Copy stage successful!'
			  sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-scd/target/*.jar jenkins@${props.jobServerdev}:/data/apps/talend/shared/scripts/nbx/SCD/"
           }
        }
		
		stage('Copy artifacts - INT') {
			when {
			  expression { params.environment == 'int' } 
			}
            steps {
              echo 'Copy stage successful!'
			  sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-scd/target/*.jar jenkins@${props.jobServerint}:/data/apps/talend/shared/scripts/nbx/SCD/"
           }
        }
		
		stage('Copy artifacts - QA') {
			when {
			  expression { params.environment == 'qa' } 
			}
            steps {
              echo 'Copy stage successful!'
			  sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-scd/target/*.jar jenkins@${props.jobServerqa}:/data/apps/talend/shared/scripts/nbx/SCD/"
			  
			  echo "uploading jar to google storage"
				
			  echo "branch Version : ${branchVerion}"
				
			  sh "mkdir -p /var/lib/jenkins/nbx_gcp_build_jars/${branchVerion}/scd/"
				
			  sh "cp ${workSpaceDir}/vv-nbx-shore-datamart-scd/target/*.jar ${nbx_jar_build_location}/${branchVerion}/scd/"
				
			  sh "source ~/.bash_profile && gsutil cp -r ${nbx_jar_build_location} gs://nbx-nonprod-build-jars/"
				
			  sh "rm ${nbx_jar_build_location}/${branchVerion}/scd/*.jar"
           }
        }
		
		stage('Copy artifacts - STG') {
			when {
			  expression { params.environment == 'stage' } 
			}
            steps {
              echo 'Copy stage successful!'
			  sh "scp ${workSpaceDir}/vv-nbx-shore-datamart-scd/target/*.jar jenkins@${props.jobServerstage}:/data/apps/talend/shared/scripts/nbx/SCD/"
           }
        }
    }
}
