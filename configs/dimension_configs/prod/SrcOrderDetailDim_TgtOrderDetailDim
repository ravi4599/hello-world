spark.source.sql select NVL(A.VoyageId,-1) as voyage_id, A.orderID as order_id, B.name as order_venue_name,C.ordertypeid as order_type_id, c.name as order_type_name, D.name as order_category, A.status as order_status_num,  (CASE when A.status = 1 then 'Received' when A.status = 2 then 'Prepared' when A.status = 3 then 'Bumped' when A.status = 4 then 'Delivered' when A.status = 5 then 'Canceled' when A.status = 21 then 'PreOrderScheduled' else null end) as order_status_desc, A.ordernumber as order_number, A.BatchTime, A.Part_Date from (select * from (select *,row_number() over(partition by orderid,ordertypeid,orderoriginid,venueID order by batchtime desc ) rn from shipdw.hvtb_parse_vxp_foodnbev_order )order where order.rn=1 ) A left outer join  (select venueid,name from (select venueid,name,row_number() over(partition by venueid order by batchtime desc ) rn from shipdw.hvtb_parse_vxp_foodnbev_venue )venue where venue.rn=1 ) B on A.venueID = B.venueid left outer join (select ordertypeid,name from (select ordertypeid,name,row_number() over(partition by ordertypeid order by lastmodifieddate desc ) rn from shipdw.hvtb_parse_vxp_foodnbev_ordertype )ordertype where ordertype.rn=1 ) C  on A.ordertypeid = C.ordertypeid left outer join  (select orderoriginid,name from (select orderoriginid,name,row_number() over(partition by orderoriginid order by lastmodifieddate desc ) rn from shipdw.hvtb_parse_vxp_foodnbev_orderorigin )orderorigin where orderorigin.rn=1 )D on A.orderoriginid = D.orderoriginid where A.status !=0
