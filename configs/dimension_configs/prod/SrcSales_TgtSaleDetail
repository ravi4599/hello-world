spark.source.sql select check_id as sale_id,check_status,receipt_nr as receipt_number,operator_nr as sale_operator_num,operator_name as sale_operator_name,period.period_code as sales_voyagenumber, sales_group_desc as sale_group_description ,batchtime,part_date,voyageid as voyage_id from ( select * from ( select sales_group_id,operator_id,receipt_nr,check_status,check_id , rec_changed , sales_group_id ,period_id,batchtime,part_date,voyageid, row_number() over ( partition by check_id order by rec_changed desc ) rn from shipdw.hvtb_parse_mxp_checks ) where rn = 1 and check_status in ('C', 'V')) checks left join (select * from (select period_code,period_id,rec_deleted, row_number() over ( partition by period_id order by rec_changed desc) rn from shipdw.hvtb_parse_mxp_periods ) a where rn = 1  ) period on checks.period_id = period.period_id and period.rec_deleted=0 left join (select * from (select operator_nr,operator_name,operator_id,rec_deleted ,row_number() over ( partition by operator_id order by rec_changed desc) rn from shipdw.hvtb_parse_mxp_operators ) where rn = 1  ) operators on checks.operator_id=operators.operator_id and operators.rec_deleted=0 left join (select * from (select sales_group_desc,sales_group_id,rec_deleted, row_number() over ( partition by sales_group_id order by rec_changed desc) rn from  shipdw.hvtb_parse_mxp_pos_sales_groups ) where rn = 1  ) sales_groups on checks.sales_group_id = sales_groups.sales_group_id and sales_groups.rec_deleted=0

spark.source.columns voyage_id,batchtime,part_date,sale_id,sale_operator_num,sale_operator_name,receipt_number,check_status,sales_voyagenumber,sale_group_description

spark.pond.allColumns sale_detail_skey as pond_sale_detail_skey, voyage_id as pond_voyage_id, sale_id as pond_sale_id, sale_operator_num as pond_sale_operator_num,sale_operator_name as pond_sale_operator_name,receipt_number as pond_receipt_number,check_status as pond_check_status,sales_voyagenumber as pond_sales_voyagenumber,sale_group_description as pond_sale_group_description,load_dt as pond_load_dt,upd_dt as pond_upd_dt, primaryhash as pond_primaryhash, md5_hash as pond_md5_hash
    

