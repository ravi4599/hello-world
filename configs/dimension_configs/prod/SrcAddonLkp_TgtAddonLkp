spark.source.sql select NVL(addon_lkp.amenity_code,-1) as res_addon_code, addon_lkp.amenity_name as addon_name,NVL(addon_lkp.am_category,'') as addon_category,NVL(addon_lkp.amenity_type,'') as addon_type,concat(  (case when addon_lkp.amenity_code = 'null' or trim(addon_lkp.amenity_code) is null or length(trim(addon_lkp.amenity_code)) = 0 then "" else lower(regexp_replace(trim(addon_lkp.amenity_code)," ","")) end),  (case when addon_lkp.am_category = 'null' or trim(addon_lkp.am_category) is null or length(trim(addon_lkp.am_category)) = 0 then "" else lower(regexp_replace(trim(addon_lkp.am_category)," ","")) end),  (case when addon_lkp.amenity_type = 'null' or trim(addon_lkp.amenity_type) is null or length(trim(addon_lkp.amenity_type)) = 0 then "" else lower(regexp_replace(trim(addon_lkp.amenity_type)," ","")) end),  (case when addon_lkp.amenity_name = 'null' or trim(addon_lkp.amenity_name) is null or length(trim(addon_lkp.amenity_name)) = 0 then "" else lower(regexp_replace(trim(addon_lkp.amenity_name)," ","")) end)  )as concat_pk,addon_lkp.batchtime as batchtime, addon_lkp.Part_date as Part_date,(CASE WHEN addon_lkp.amenity_code=delete.amenity_code  THEN 'n' ELSE 'y' end) as is_active from (select * from (select *, row_number()over(partition by amenity_code,amenity_name,am_category,amenity_type order by ts_ms desc, lsn desc) as rn from vv_db.hvtb_parse_sw_rpl_am_code *whereclause*) add where add.rn=1) addon_lkp  left join (select  amenity_code from vv_db.hvtb_parse_sw_rpl_am_code where op ='d') delete on addon_lkp.amenity_code=delete.amenity_code

