spark.query select sh.sail_id as Sail_ID, sh.sail_code as Sail_Code, pd.package_type as Package_Type, sh.route_code as Route_Code, sh.ship_code as Ship, DATEDIFF(sh.sail_date_to, sh.sail_date_from) as Days, sh.sail_date_from as Sail_Start, sh.sail_date_to as Sail_End, sh.port_from as Port_From, sh.port_to as Port_To, sh.is_fake as Fake, sh.is_active as Active, sh.season_code as Season, sh.sail_status as Status from (select * from (select *,row_number() over(partition by sail_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_sail_header) p where p.rn=1) sh join vv_db.hvtb_nbx_core_sw_package_dim pd on pd.src_sail_id = sh.sail_id and pd.package_class = 'VOYAGE' and pd.rec_end_dttm = '9999-12-31 00:00:00' where sh.ship_code in ('SC', 'VL') and sh.is_fake = 'N' and sh.is_active = 'Y' and sh.sail_status = 'BK'

