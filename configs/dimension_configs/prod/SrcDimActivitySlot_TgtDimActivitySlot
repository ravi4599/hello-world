_deleted_flg,       ars_meetingloc.deckcode AS meeting_location_deck_code,       ars_meetingloc.directioncode AS meeting_location_direction_code,       ars_meetingloc.sectioncode AS meeting_location_section_code,       price AS selling_price,       ars_activityslot.BatchTime AS BatchTime,       ars_activityslot.Part_Date AS Part_Date,       ars_activitypersonbooking.personid	 from 	( 	select 		* 	from 		( 		 SELECT           voyageid,           activityslotid,           activityid,           code,           startdatetime,           enddatetime,           type,           iswaitlistenable,           iscancelled,           isdeleted,           BatchTime,           Part_Date,           capacityid,           status,           ROW_NUMBER() OVER(PARTITION BY activitycode,activityslotid ORDER BY lastmodifieddate DESC) rn         FROM           shipdw.hvtb_parse_vxp_ars_activityslot 		) 	where 		rn = 1) ars_activityslot left join ( 	select 		* 	from 		( 		select 			totalcapacity, 			holdcapacity, 			minimumselling, 			maximumwaitlistcount, 			capacityid, 			row_number() over(partition by capacityid 		order by 			lastmodifieddate desc) rn 		from 			shipdw.hvtb_parse_vxp_ars_capacity) 	where 		rn = 1) ars_capacity on 	trim(ars_capacity.capacityid) = trim(ars_activityslot.capacityid) left join ( 	select 		* 	from 		( 		select 			status, 			activityslotcode, 			activitybookingid, 			activitycode, 			row_number() over(partition by activitybookingid,activityslotcode,activitycode 		order by 			lastmodifieddate desc) rn 		from 			shipdw.hvtb_parse_vxp_ars_activitybooking 		) a 	where 		rn = 1 and upper(a.status) not in ('CANCELLED','RESERVATION_CANCELLED','FAILED')) ars_activitybooking on 	(trim(ars_activityslot.code) = trim(ars_activitybooking.activityslotcode)) left join ( 		select 			activitybookingid, 			personid 		from 			( 			select 				activitybookingid, 				personid, 				row_number() over(partition by activitypersonbookingid,personid 				order by 				lastmodifieddate desc) rn 			from 				shipdw.hvtb_parse_vxp_activitypersonbooking) 		where 			rn = 1) ars_activitypersonbooking on 	trim(ars_activitybooking.activitybookingid) = trim(ars_activitypersonbooking.activitybookingid) left join ( 	select 		* 	from 		( 		select 			deckcode, 			sectioncode, 			directioncode, 			activityslotid, 			activityid, 			row_number() over(partition by activityslotid 		order by 			lastmodifieddate desc) rn 		from 			shipdw.hvtb_parse_vxp_ars_meetinglocation) 	where 		rn = 1) ars_meetingloc on 	trim(ars_meetingloc.activityslotid) = trim(ars_activityslot.activityslotid) left join ( 	select 		* 	from 		( 		select 			price, 			activityslotid, 			activityid, 			row_number() over(partition by activityslotid 		order by 			lastmodifieddate desc) rn 		from 			shipdw.hvtb_parse_vxp_ars_sellingprice) 	where 		rn = 1) sellingprice on 	ars_activityslot. activityslotid = sellingprice. activityslotid 	) slot GROUP BY     slot.voyage_id,     slot.activity_slot_id,     slot.activity_id,     slot.activity_slot_code,     slot.slot_start_timestamp,     slot.slot_end_timestamp,     slot.total_capacity,     slot.minimum_party_size,     slot.maximum_party_size,     slot.activity_slot_status,     slot.type,     slot.waitlist_enable_flg,     slot.cancelled_flg,     slot.src_deleted_flg,     slot.meeting_location_deck_code,     slot.meeting_location_direction_code,     slot.meeting_location_section_code,     slot.selling_price,     slot.BatchTime,     slot.Part_Date) slot1


