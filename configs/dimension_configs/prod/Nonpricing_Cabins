spark.query select cabinCategory.ship_code as Ship_Code, cabin.cabin_number as Cabin_Number, cabin.deck_number as Cabin_Deck_Number, cabinCategory.cabin_category as Cabin_Category, cabinCategory.category_capacity as Cabin_Capacity from (select * from (select *,row_number() over(partition by cabin_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_ship_cabin) p where p.rn=1)cabin join (select * from (select *,row_number() over(partition by cabin_category_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_cabin_category) p where p.rn=1) cabinCategory on cabin.cabin_id = cabinCategory.cabin_category_id where cabinCategory.ship_code in ('SC', 'VL', 'RS')

