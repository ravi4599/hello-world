.org_unit_id) left join (select company_name,contact_id from (select company_name,contact_id,rec_deleted,row_number() over (partition by contact_id order by last_changed desc) as rn from  shipdw.hvtb_parse_mxp_contacts )contacts_tb where contacts_tb.rn=1 and contacts_tb.rec_deleted=false )mxp_contacts on(bookin.booking_contact_id==mxp_contacts.contact_id)


spark.lookupitemsMega.sql select lookup_items_tb.display_code as booking_vip_tier,lookup_items_tb.mega_rockstar_flag,lookup_items_tb.lookup_item_name as booking_vip_status,lookup_items_tb.lookup_item_id as lookup_item_id_mega from (select lookup_item_name,display_code,case when lookup_item_name='Mega RockStar' then true else false end as mega_rockstar_flag ,lookup_item_id,lookup_sub_category_id,active,rec_deleted,row_number() over (partition by lookup_item_id order by last_changed desc) as rn from  shipdw.hvtb_parse_mxp_lookup_items)lookup_items_tb  inner join (select lookup_sub_category_id,lookup_sub_category_name from (select lookup_sub_category_id,lookup_sub_category_name,row_number() over (partition by lookup_sub_category_id order by last_changed desc) as rn from  shipdw.hvtb_parse_mxp_lookup_sub_categories) lookup_sub where lookup_sub.rn=1)lookup_subcategories on lookup_items_tb.lookup_sub_category_id=lookup_subcategories.lookup_sub_category_id and lookup_subcategories.lookup_sub_category_name='VIP Status' where lookup_items_tb.rn=1 and lookup_items_tb.active=true and lookup_items_tb.rec_deleted=false
