spark.booking.sql select bookin.charge_id as person_booking_charge_id,org_units.org_unit_abbreviation as person_booking_ship_code,mxp_contacts.company_name as crew_manning_agent,bookin.booking_vip_status_id,dim_voyage.voyage_number as booking_cruise_number,dim_voyage.voyage_skey as voyage_skey,person_id as person_id_in_booking,ARRIVAL_DATE as booking_arrival_date,DEPARTURE_DATE as booking_departure_date,BOOKING_ROOM_NO as cabin_number,BOOKING_ARRIVAL_STATUS as booking_arrival_status,person_booking_status_id as booking_status, EMBARKATION_CITY_ID as booking_embarkation_city_id,DEBARKATION_CITY_ID as booking_debarkation_city_id,person_booking_id as booking_id,last_changed as booking_lastchanged,case when NVL(booking_vip_status_id,0)==0  then 'N' else 'Y' end as  vip_flag,BOOKING_REFERENCE as booking_reference ,lower(GUID) as reservationguest_guid,bookin.MANIFEST_TYPE as booking_manifest_type,external_booking_id,position_id,bookin.ts_ms,mxp_contacts.contact_code as crew_manning_agent_code,currency.CURRENCY_ABB as crew_salary_currency,bookin.departure_status_id,bookin.op as personbooking_op from  (select * from (select *,row_number() over (partition by person_booking_id,person_id order by ts_ms desc) as rn from  shipdw.hvtb_parse_mxp_person_booking where person_booking_id > 0 and person_id > 0 )perbook where perbook.rn=1) bookin left join (select cruise_number,cruise_id from (select cruise_number,cruise_id,row_number() over (partition by cruise_id order by last_changed desc) as rn from  shipdw.hvtb_parse_mxp_cruise where active=true and deleted=false and cruise_type='C')cruise_tb where cruise_tb.rn=1)cruise on(cruise.cruise_id==bookin.cruise_id) left join (select voyage_number,voyage_skey from shipdw.hvtb_mart_dim_voyage where src_active_flag=true and src_deleted_flag=false)dim_voyage on(cruise.cruise_number ==dim_voyage.voyage_number) left join (select org_unit_id,org_unit_abbreviation from (select org_unit_id,org_unit_abbreviation,row_number() over (partition by org_unit_id order by last_changed desc) as rn from  shipdw.hvtb_parse_mxp_org_units )org_units_tb where org_units_tb.rn=1 )org_units on(bookin.org_unit_id==org_units.org_unit_id) left join (select company_name,contact_id,contact_code,contact_default_currency from (select company_name,contact_id,rec_deleted,contact_code,contact_default_currency,row_number() over (partition by contact_id order by last_changed desc) as rn from  shipdw.hvtb_parse_mxp_contacts )contacts_tb where contacts_tb.rn=1 and contacts_tb.rec_deleted=false )mxp_contacts on(bookin.booking_contact_id==mxp_contacts.contact_id) left join (select CURRENCY_ID,CURRENCY_ABB from (select CURRENCY_ID,CURRENCY_ABB,row_number() over (partition by CURRENCY_ID order by last_changed desc) as rn from  shipdw.hvtb_parse_mxp_currencies )currency_tb where currency_tb.rn=1) currency on mxp_contacts.contact_default_currency==currency.CURRENCY_ID


