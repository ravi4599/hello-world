spark.source.sql SELECT sr.res_id as src_res_id,sr.guest_id as src_guest_id,coalesce(rd.res_id, - 1) res_id ,coalesce(gd.guest_id, - 1) guest_id ,coalesce(pd.package_id, - 1) package_id,sr.PRICE_CATEGORY ,cc_price.cabin_category_rank AS PRICE_CATEGORY_RANK ,rp.CABIN_CATEGORY_BERTH AS BERTH_CATEGORY ,cc_berth.cabin_category_rank AS BERTH_CATEGORY_RANK ,ia.CABIN_CATEGORY AS ASSIGNED_CATEGORY ,cc_assigned.cabin_category_rank AS ASSIGNED_CATEGORY_RANK ,cm.CABIN_CATEGORY_GENERIC AS GENERIC_CATEGORY ,coalesce(ia.ALLOCATION_ID, - 1) allocation_id ,coalesce(cm.CABIN_ID, - 1) cabin_id ,coalesce(scrd.sail_cabin_reserve_id, - 1) AS SAIL_CABIN_RESERVE_ID ,sr.BatchTime AS BatchTime ,sr.Part_Date AS Part_Date ,sr.ts_ms AS ts_ms_sr ,ia.ts_ms AS ts_ms_ia ,rp.ts_ms AS ts_ms_rp ,rp.ts_ms AS ts_ms_pt ,cc_price.ts_ms AS ts_ms_cc_price ,sh.ts_ms AS ts_ms_sh FROM ( select * from (SELECT *,row_number() over (partition by SHIP_REQUEST_ID order by ts_ms desc,lsn desc) as rn FROM vv_db.hvtb_parse_sw_rpl_RES_SHIP_REQUEST )sr1 where rn = 1 and op!='d'  ) sr  LEFT JOIN ( select * from (SELECT *,row_number() over (partition by ALLOCATION_ID order by ts_ms desc,lsn desc) as rn FROM vv_db.hvtb_parse_sw_rpl_SHIP_INVENTORY_ALLOC ) ia1 where rn = 1 and op!='d'  ) ia ON sr.allocation_id = ia.allocation_id LEFT JOIN ( select * from (SELECT *,row_number() over (partition by RES_PACKAGE_ID order by ts_ms desc,lsn desc) as rn FROM vv_db.hvtb_parse_sw_rpl_RES_PACKAGE ) rp1 where rn = 1  )  rp ON sr.res_id = rp.res_id AND sr.guest_id = rp.guest_id AND rp.package_class = 'VOYAGE' LEFT JOIN ( select * from (SELECT *,row_number() over (partition by SHIP_CODE, CABIN_CATEGORY order by ts_ms desc,lsn desc) as rn FROM vv_db.hvtb_parse_sw_cabin_category ) cc_price1 where rn = 1  ) cc_price ON sr.price_category = cc_price.cabin_category AND sr.ship_code = cc_price.ship_code LEFT JOIN ( select * from (SELECT *,row_number() over (partition by SHIP_CODE, CABIN_CATEGORY order by ts_ms desc,lsn desc) as rn FROM vv_db.hvtb_parse_sw_cabin_category ) cc_assigned1 where rn = 1  )  cc_assigned ON ia.cabin_category = cc_assigned.cabin_category AND ia.ship_code = cc_assigned.ship_code LEFT JOIN ( select * from (SELECT *,row_number() over (partition by SHIP_CODE, CABIN_CATEGORY order by ts_ms desc,lsn desc) as rn FROM vv_db.hvtb_parse_sw_cabin_category ) cc_berth1 where rn = 1  ) cc_berth ON rp.cabin_category_berth = cc_berth.cabin_category AND rp.ship_code = cc_berth.ship_code LEFT JOIN ( select * from (SELECT *,row_number() over (partition by SAIL_ID order by ts_ms desc,lsn desc) as rn FROM vv_db.hvtb_parse_sw_rpl_SAIL_HEADER ) cc_berth1 where rn = 1  )  sh ON rp.DEP_REF_ID = sh.DEP_REF_ID AND rp.ARR_REF_ID = sh.ARR_REF_ID AND rp.SHIP_CODE = sh.SHIP_CODE JOIN vv_db.hvtb_nbx_core_sw_reservation_dim rd ON sr.res_id = rd.src_res_id AND rd.rec_end_dttm = '9999-12-31' JOIN vv_db.hvtb_nbx_core_sw_guest_dim gd ON sr.guest_id = gd.src_guest_id AND gd.rec_end_dttm = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_package_dim pd ON rp.package_id = pd.src_package_id AND pd.rec_end_dttm = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_sail_cabin_reserve_dim scrd ON scrd.src_sail_id = sh.sail_id AND scrd.cabin_number = ia.cabin_number LEFT JOIN vv_db.hvtb_nbx_core_sw_cabin_master cm ON ia.cabin_number = cm.cabin_number AND ia.ship_code = cm.ship LEFT JOIN vv_db.hvtb_nbx_core_sw_allocation_lkp alkp ON ia.allocation_id = alkp.src_allocation_id AND ia.INVENTORY_RESULT_TYPE = alkp.allocation_inv_result

