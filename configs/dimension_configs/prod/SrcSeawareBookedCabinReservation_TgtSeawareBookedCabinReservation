 ia.ship_code = cc_assigned.ship_code LEFT JOIN ( select * from (SELECT *,row_number() over (partition by SHIP_CODE, CABIN_CATEGORY order by ts_ms desc) as rn FROM vv_db.hvtb_parse_sw_cabin_category ) cc_berth1 where rn = 1  ) cc_berth ON rp.cabin_category_berth = cc_berth.cabin_category AND rp.ship_code = cc_berth.ship_code LEFT JOIN ( select * from (SELECT *,row_number() over (partition by SAIL_ID order by ts_ms desc) as rn FROM vv_db.hvtb_parse_sw_rpl_SAIL_HEADER ) cc_berth1 where rn = 1  )  sh ON rp.DEP_REF_ID = sh.DEP_REF_ID AND rp.ARR_REF_ID = sh.ARR_REF_ID AND rp.SHIP_CODE = sh.SHIP_CODE JOIN vv_db.hvtb_nbx_core_sw_reservation_dim rd ON sr.res_id = rd.src_res_id AND rd.rec_end_dttm = '9999-12-31' JOIN vv_db.hvtb_nbx_core_sw_guest_dim gd ON sr.guest_id = gd.src_guest_id AND gd.rec_end_dttm = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_package_dim pd ON rp.package_id = pd.src_package_id AND pd.rec_end_dttm = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_sail_cabin_reserve_dim scrd ON scrd.src_sail_id = sh.sail_id AND scrd.cabin_number = ia.cabin_number LEFT JOIN vv_db.hvtb_nbx_core_sw_cabin_master cm ON ia.cabin_number = cm.cabin_number AND ia.ship_code = cm.ship LEFT JOIN vv_db.hvtb_nbx_core_sw_allocation_lkp alkp ON ia.allocation_id = alkp.src_allocation_id AND ia.INVENTORY_RESULT_TYPE = alkp.allocation_inv_result WHERE coalesce(ia.ship_code,'') <> 'XE'

