spark.source.sql select csd.record_id as src_record_id,current_timestamp as rec_start_dttm,if(act.op='d',current_timestamp() - INTERVAL 1 SECOND,to_timestamp('9999-12-31')) as rec_end_dttm,case when cd.entity_type='RES' then res.res_id else null end res_id,act.res_action_type action_type,csd.charge_id charge_id,cd.charge_component_code charge_component_code,cd.charge_state charge_state,csd.guest_seqn guest_seqn,csd.amount amount,csd.amount_in_hdr_curr amount_in_hdr_curr,csd.explanation explanation,csd.change_area change_area,act.action_timestamp action_timestamp,act.is_added_manually is_added_manually,csd.package_id as src_package_id,act.is_paid as is_paid,act.paid_timestamp paid_timestamp,cd.comments as comments,act.batchtime as batchtime,act.part_date as part_date from (select * from (select *,row_number() over(partition by action_id order by ts_ms desc) as rn from vv_db.hvtb_nbx_parse_sw_rpl_res_chargeable_action) p where p.rn=1) act inner join (select * from (select *,row_number() over(partition by action_id,charge_id order by ts_ms desc) as rn from vv_db.hvtb_nbx_parse_sw_rpl_res_charge_detail) p where p.rn=1) cd on act.action_id=cd.action_id inner join (select * from (select *,row_number() over(partition by record_id order by ts_ms desc,lsn desc) as rn from vv_db.hvtb_nbx_parse_sw_rpl_res_charge_subdetail) p where p.rn=1) csd on cd.charge_id=csd.charge_id left join vv_db.hvtb_nbx_core_sw_reservation_dim res on cd.entity_id=res.src_res_id and to_date(res.rec_end_dttm)='9999-12-31'  

 

 
