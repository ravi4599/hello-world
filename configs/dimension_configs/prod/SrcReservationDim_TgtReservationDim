spark.source.sql SELECT rh.res_id AS src_res_id, rh.res_init_date, rh.res_guest_count, rh.res_mode, cx.cancellation_date, rh.res_status, perf.performer AS operator, rh.res_type, ag.is_internal, rh.source_code, rp.effective_date, op.vip_status__c AS vip_status, op.stagename AS stage, op.bookingsource__c AS booking_source, op.lastmodifiedbyid AS last_modifiedby_id, CASE WHEN rhtl.res_id IS NOT NULL AND rh.res_status='BK' THEN 'Y' ELSE 'N' END AS hotel_flag, sh.src_sail_id, agency.seaware_agency_id__c AS seaware_agency_id, agent.seaware_agent_id__c AS seaware_agent_id, CASE WHEN tran.src_res_id IS NOT NULL THEN 'Y' ELSE 'N' END AS opted_fvc, cc.case_name AS cancellation_case, rh.group_id AS src_group_id, rh.currency_code AS currency, CAST(rh.currency_rate AS double), rh.batchtime AS batchtime, rh.part_date AS part_date, rh.ts_ms AS ts_ms_rh, cx.ts_ms_cx, perf.ts_ms_perf, rp.ts_ms_rp, rhtl.ts_ms_rhtl, tran.ts_ms_tran, ag.ts_ms_ag, sh.ts_ms_sh, op.ts_ms_op, agency.ts_ms_agency, agent.ts_ms_agent, cc.ts_ms_cc FROM vv_db.hvtb_parse_sw_rpl_res_header rh LEFT JOIN ( SELECT res_id, event_timestamp AS cancellation_date, ts_ms AS ts_ms_cx FROM ( SELECT res_id, event_timestamp, ts_ms, ROW_NUMBER() OVER (PARTITION BY res_id ORDER BY ts_ms DESC,lsn DESC) rn FROM vv_db.hvtb_parse_sw_rpl_res_event WHERE event_timestamp IN ( SELECT MIN(event_timestamp) FROM vv_db.hvtb_parse_sw_rpl_res_event WHERE new_status='CX' GROUP BY res_id) AND new_status='CX') WHERE rn=1) cx ON (rh.res_id=cx.res_id) LEFT JOIN ( SELECT res_id, performer, ts_ms AS ts_ms_perf FROM ( SELECT res_id, performer, ts_ms, ROW_NUMBER() OVER (PARTITION BY res_id ORDER BY ts_ms DESC,lsn DESC) rn FROM vv_db.hvtb_parse_sw_rpl_res_history WHERE trans_timestamp IN ( SELECT MAX(trans_timestamp) FROM vv_db.hvtb_parse_sw_rpl_res_history GROUP BY res_id)) WHERE rn=1)perf ON (rh.res_id=perf.res_id) LEFT JOIN ( SELECT effective_date, res_id, ts_ms AS ts_ms_rp FROM ( SELECT effective_date, res_id, ts_ms, ROW_NUMBER() OVER (PARTITION BY res_id ORDER BY ts_ms DESC,lsn DESC) rn FROM vv_db.hvtb_parse_sw_rpl_res_package WHERE effective_date IN ( SELECT MAX(effective_date) AS effective_date FROM vv_db.hvtb_parse_sw_rpl_res_package GROUP BY res_id)) WHERE rn=1) rp ON rh.res_id=rp.res_id LEFT JOIN ( SELECT res_id, ts_ms AS ts_ms_rhtl FROM ( SELECT res_id, ts_ms, ROW_NUMBER() OVER (PARTITION BY res_id ORDER BY ts_ms DESC,lsn DESC) rn FROM vv_db.hvtb_parse_sw_rpl_res_hotel_request WHERE res_id IN ( SELECT res_id FROM vv_db.hvtb_parse_sw_rpl_res_hotel_request GROUP BY res_id)) WHERE rn=1) rhtl ON rh.res_id = rhtl.res_id LEFT JOIN ( SELECT CASE WHEN a.source_entity_type='RES' THEN a.source_entity_id ELSE CASE WHEN a.dest_entity_type='RES' THEN a.dest_entity_id END END AS src_res_id, ts_ms AS ts_ms_tran FROM vv_db.hvtb_parse_sw_rpl_acc_trans_detail a WHERE (a.source_entity_type='RES' OR a.dest_entity_type='RES') AND a.form_of_trans='CPN' AND a.trans_status IN ('OK', 'PENDING REFUND') AND a.trans_type IN ('PMNT', 'REFUND')) tran ON rh.res_id = tran.src_res_id LEFT JOIN ( SELECT agency_id, is_internal, ts_ms AS ts_ms_ag FROM vv_db.hvtb_parse_sw_rpl_agency ) ag ON rh.agency_id=ag.agency_id LEFT JOIN ( SELECT ship_code, dep_ref_id, arr_ref_id, sail_id AS src_sail_id, ts_ms AS ts_ms_sh FROM vv_db.hvtb_parse_sw_rpl_sail_header) sh ON rh.ship_code=sh.ship_code AND rh.dep_ref_id=sh.dep_ref_id AND rh.arr_ref_id=sh.arr_ref_id LEFT JOIN ( SELECT vip_status__c, stagename, bookingsource__c, lastmodifiedbyid, reservation_number__c, agencyname__c, agentname__c, load_data_timestamp AS ts_ms_op FROM vv_db.hvtb_nbx_core_crm_opportunity) op ON rh.res_id=op.reservation_number__c LEFT JOIN ( SELECT CAST(seaware_agency_id__c AS int), id, rec_end_dttm, lastmodifieddate AS ts_ms_agency FROM vv_db.hvtb_nbx_core_crm_agency_master_dim) agency ON op.agencyname__c = agency.id AND to_date(agency.rec_end_dttm) ='9999-12-31' LEFT JOIN ( SELECT CAST(seaware_agent_id__c AS int), id, rec_end_dttm, load_dt AS ts_ms_agent FROM vv_db.hvtb_nbx_core_crm_agent_master_dim) agent ON op.agentname__c = agent.id AND to_date(agent.rec_end_dttm) ='9999-12-31' LEFT JOIN ( SELECT case_name, case_id, ts_ms AS ts_ms_cc FROM vv_db.hvtb_parse_sw_rpl_cancellation_case) cc ON rh.cancellation_case=cc.case_id 


