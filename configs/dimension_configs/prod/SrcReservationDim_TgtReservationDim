kage where effective_date in (select  max(effective_date) as effective_date from vv_db.hvtb_parse_sw_rpl_res_package group by res_id)) where rn=1) rp on rh.res_id=rp.res_id   left join (select res_id,ts_ms as ts_ms_rhtl from (select res_id,ts_ms,row_number() over (partition by res_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_res_hotel_request where res_id in (select res_id from vv_db.hvtb_parse_sw_rpl_res_hotel_request group by res_id)) where rn=1) rhtl on rh.res_id = rhtl.res_id  left join (select case when a.source_entity_type='RES' then a.source_entity_id else case when a.dest_entity_type='RES' then  a.dest_entity_id end end as src_res_id,ts_ms as ts_ms_tran  from vv_db.hvtb_parse_sw_rpl_acc_trans_detail  a where (a.source_entity_type='RES' or a.dest_entity_type='RES') and a.form_of_trans='CPN' and a.trans_status in ('OK','PENDING REFUND') and a.trans_type in ('PMNT','REFUND')) tran on rh.res_id = tran.src_res_id  left join (select agency_id,is_internal,ts_ms as ts_ms_ag from vv_db.hvtb_parse_sw_rpl_agency ) ag on rh.agency_id=ag.agency_id  left join (select ship_code,dep_ref_id,arr_ref_id,sail_id as src_sail_id,ts_ms as ts_ms_sh from vv_db.hvtb_parse_sw_rpl_sail_header) sh on rh.ship_code=sh.ship_code and rh.dep_ref_id=sh.dep_ref_id and rh.arr_ref_id=sh.arr_ref_id   left join (select vip_status__c,stagename,bookingsource__c,lastmodifiedbyid,reservation_number__c,agencyname__c,agentname__c,load_data_timestamp as ts_ms_op from vv_db.hvtb_nbx_core_crm_opportunity) op on rh.res_id=op.reservation_number__c  left join (select cast(seaware_agency_id__c as int),id,rec_end_dttm,lastmodifieddate as ts_ms_agency from vv_db.hvtb_nbx_core_crm_agency_master_dim) agency on op.agencyname__c = agency.id and to_date(agency.rec_end_dttm) ='9999-12-31'   left join (select cast(seaware_agent_id__c as int),id,rec_end_dttm,load_dt as ts_ms_agent from vv_db.hvtb_nbx_core_crm_agent_master_dim) agent on op.agentname__c = agent.id and to_date(agent.rec_end_dttm) ='9999-12-31'  