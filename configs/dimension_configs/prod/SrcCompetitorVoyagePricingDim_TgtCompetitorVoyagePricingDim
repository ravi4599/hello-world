N_CATEGORY, comp.batchtime FROM ( SELECT to_date(SUBSTRING(REGEXP_REPLACE(rate_inquiry_date,'-','/'), 1, 9), 'MM/dd/yy') AS rate_inquiry_date, cruise_line_code, cruise_line_name, ship_code, source_ship_name AS ship_name, cruise_duration, CAST(embarkation_date AS date) AS embarkation_date, CAST(disembark_date AS date) AS disembarkation_date, embarkation_port, embarkationportun_locode, disembarkation_port, disembarkationportun_locode, source_itinerary_name, cabin_type, (CASE WHEN cabin_type = 'Balcony' THEN 'TR' WHEN cabin_type = 'Suite' THEN 'SS' ELSE NULL END ) AS VV_CABIN_CATEGORY, cabin_category, source_currency, taxes_and_fees, tax_exclusive_rate_pp AS taxes_exclusive_rate_pp, SUBSTRING(embarkationportun_locode, 3, 5) AS embark_port, SUBSTRING(disembarkationportun_locode, 3, 5) AS debark_port, date_format(CAST(embarkation_date AS date), "y")|| date_format(CAST(embarkation_date AS date), "w")AS year_week, batchtime FROM ( select *,row_number() over(partition by rate_inquiry_date,cruise_line_code,ship_code,embarkation_date,cruise_duration,cabin_category order by to_date(SUBSTRING(REGEXP_REPLACE(rate_inquiry_date,'-','/'), 1, 9),'MM/dd/yy') desc) as rn from vv_db.hvtb_lnd_comp_shop ) where rn =1)comp LEFT JOIN ( SELECT DISTINCT(Meta_Product) AS Meta_Product, embark_port_code, debark_port_code FROM vv_db.hvtb_nbx_core_sw_competitor_product_lkp) cpl_meta ON cpl_meta.embark_port_code = comp.embark_port AND cpl_meta.debark_port_code = comp.debark_port LEFT JOIN ( SELECT DISTINCT(sub_product) AS sub_product, embark_port_code, debark_port_code, sail_days_min, sail_days_max, includes_chrismas, includes_nye FROM vv_db.hvtb_nbx_core_sw_competitor_product_lkp) cpl_sub ON cpl_sub.embark_port_code = comp.embark_port AND cpl_sub.debark_port_code = comp.debark_port AND comp.cruise_duration >= cpl_sub.sail_days_min AND comp.cruise_duration <= cpl_sub.sail_days_max AND ( (CASE WHEN date_format(CAST(embarkation_date AS date), "y")|| '-12-25' BETWEEN comp.embarkation_date AND comp.di