spark.source.sql SELECT vw_header_id, src_res_id, header_is_matched, vw_type, res_is_matched, is_main, batchtime, part_date, rec_start_dttm, rec_end_dttm FROM ( SELECT b.vw_header_id AS vw_header_id, b.entity_id AS src_res_id, a.is_matched AS header_is_matched, a.trw_type AS vw_type, b.is_matched AS res_is_matched, b.is_main AS is_main, a.batchtime AS batchtime, a.part_date AS part_date, current_timestamp AS rec_start_dttm, if(a.op='d',current_timestamp() - INTERVAL 1 SECOND,to_timestamp('9999-12-31')) AS rec_end_dttm FROM ( SELECT * FROM ( SELECT trw_header_id as vw_header_id, is_matched, trw_type, part_date, batchtime,op, ROW_NUMBER() OVER (PARTITION BY trw_header_id ORDER BY ts_ms DESC ) rn FROM vv_db.hvtb_parse_sw_rpl_trw_header) WHERE rn = 1 ) a LEFT JOIN ( SELECT * FROM ( SELECT entity_id, trw_header_id as vw_header_id, is_matched, is_main, entity_type, part_date, batchtime, ROW_NUMBER() OVER (PARTITION BY trw_header_id,entity_id ORDER BY ts_ms DESC ) rn FROM vv_db.hvtb_nbx_parse_sw_rpl_trw_detail ) WHERE rn = 1 ) b ON a.vw_header_id = b.vw_header_id AND b.entity_type='RES')a *whereclause*
 
