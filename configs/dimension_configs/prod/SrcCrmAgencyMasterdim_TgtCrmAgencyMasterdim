rn=1 ) as account  LEFT JOIN  (select sub_agency_id, max(parent_agency) as parent_agency  from (  select al.sub_agency_id , case when al.link_type ='STANDARD' then al.up_agency_id else 0 end as parent_agency  from vv_db.hvtb_parse_sw_rpl_agency_link al where sub_agency_id in ( select ag.sub_agency_id  from vv_db.hvtb_parse_sw_rpl_agency_link ag group by sub_agency_id having count(*)>1) ) group by sub_agency_id union  select al.sub_agency_id , al.up_agency_id as parent_agency    from vv_db.hvtb_parse_sw_rpl_agency_link al where sub_agency_id in ( select sub_agency_id  from vv_db.hvtb_parse_sw_rpl_agency_link  group by sub_agency_id having count(*)=1) ) as sw_parent_agency on  sw_parent_agency.sub_agency_id = account.seaware_agency_id__c where accountrecordtype = 'Agency'

