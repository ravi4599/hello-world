spark.source.sql SELECT pro.res_promo_id, rd.res_id, gd.guest_id, pd.package_id, al.addon_id, -1 AS carddeck_id, -1 AS shorex_id, -1 AS hotel_id, promo_lkp.promotion_id AS promotion_id , current_timestamp AS rec_start_dttm, CASE WHEN pro.op == 'd' THEN current_timestamp ELSE to_timestamp('9999-12-31 00:00:00') END AS rec_end_dttm, pro.is_active, pro.is_excluded, CASE WHEN pro.is_manual = 'Y' THEN 'FORCED' WHEN pro.is_manual = 'N' THEN 'AUTO' WHEN pro.is_manual = 'E' THEN 'QUALIFIED' END AS promo_mode, pro.batchtime AS batchtime, pro.part_date AS part_date FROM ( SELECT * FROM ( SELECT res_promo_id, is_active, is_excluded, is_manual, res_package_id, res_id, guest_id, promo_code, batchtime, part_date, op, ROW_NUMBER() OVER(PARTITION BY res_promo_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_promotion )respro WHERE respro.rn = 1) pro LEFT JOIN ( SELECT * FROM ( SELECT res_package_id, res_addon_id, package_id, ROW_NUMBER() OVER(PARTITION BY res_package_id ORDER BY ts_ms DESC ,lsn desc) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_package)respack WHERE respack.rn = 1) pkg ON pro.res_package_id = pkg.res_package_id LEFT JOIN ( SELECT * FROM ( SELECT res_addon_id, res_addon_code, ROW_NUMBER() OVER(PARTITION BY res_addon_id ORDER BY ts_ms DESC ,lsn desc) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_addon)resaddon WHERE resaddon.rn = 1) addon ON pkg.res_addon_id = addon.res_addon_id LEFT JOIN vv_db.hvtb_nbx_core_sw_reservation_dim rd ON pro.res_id = rd.src_res_id AND rd.rec_end_dttm = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_guest_dim gd ON pro.guest_id = gd.src_guest_id AND gd.rec_end_dttm = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_package_dim pd ON pkg.package_id = pd.src_package_id AND pd.rec_end_dttm = '9999-12-31' LEFT JOIN ( SELECT NVL(am_code.amenity_code, -1) AS res_addon_code, am_code.amenity_name AS addon_name, NVL(am_code.am_category, '') AS addon_category, NVL(am_code.amenity_type, '') AS addon_type , am_code.concat_pk, addon_lkp.addon_id FROM ( SELECT amenity_code, amenity_name, am_category, amenity_type, concat( (CASE WHEN amenity_code = 'null' OR trim(amenity_code) IS NULL OR LENGTH(trim(amenity_code)) = 0 THEN "" ELSE lower(regexp_replace(trim(amenity_code), " ", "")) END), (CASE WHEN am_category = 'null' OR trim(am_category) IS NULL OR LENGTH(trim(am_category)) = 0 THEN "" ELSE lower(regexp_replace(trim(am_category), " ", "")) END), (CASE WHEN amenity_type = 'null' OR trim(amenity_type) IS NULL OR LENGTH(trim(amenity_type)) = 0 THEN "" ELSE lower(regexp_replace(trim(amenity_type), " ", "")) END), (CASE WHEN amenity_name = 'null' OR trim(amenity_name) IS NULL OR LENGTH(trim(amenity_name)) = 0 THEN "" ELSE lower(regexp_replace(trim(amenity_name), " ", "")) END) ) AS concat_pk FROM ( SELECT amenity_code, amenity_name, am_category, amenity_type, ROW_NUMBER() OVER(PARTITION BY amenity_code, amenity_name, am_category, amenity_type ORDER BY ts_ms DESC,lsn desc) AS rn FROM vv_db.hvtb_parse_sw_rpl_am_code ) ADD WHERE add.rn = 1 ) am_code LEFT JOIN vv_db.hvtb_nbx_core_sw_addon_lkp addon_lkp ON addon_lkp.concat_pk = am_code.concat_pk) al ON addon.res_addon_code = al.res_addon_code LEFT JOIN ( SELECT * FROM ( SELECT pap_code, pap_name, promo_group, ROW_NUMBER() OVER(PARTITION BY pap_id ORDER BY ts_ms DESC,lsn desc) AS rn FROM vv_db.hvtb_parse_sw_rpl_pap_master) pap WHERE pap.rn = 1) pap_master ON pap_master.pap_code = pro.promo_code LEFT JOIN (select promotion_id,promo_code,promo_name,promo_group from (select promotion_id,promo_code,promo_name,promo_group,row_number() over(partition by nvl(promo_code,''),nvl(promo_group,''),nvl(promo_name,'') order by load_dt desc,upd_dt desc)as rn from vv_db.hvtb_nbx_core_sw_promotion_lkp) where rn=1) promo_lkp ON (pap_master.pap_code = promo_lkp.promo_code AND nvl(pap_master.pap_name,'') = nvl(promo_lkp.promo_name,'') AND nvl(pap_master.promo_group,'') = nvl(promo_lkp.promo_group,''))

