spark.source.sql SELECT venues.VoyageId as voyage_id, venues.global_venue_id as venue_id, venues.name as venue_name, sector.name as venue_sector_name, 'VXP' as data_src, lkup.threshold1 as density_threshold_1, lkup.threshold2 as density_threshold_2, org.org_unit_abbreviation as ship_code, venues.batchtime as batchtime, venues.part_date as part_date from ( select * from ( select VoyageId,global_venue_id,sector_id,name,batchtime,part_date, row_number() over ( partition by global_venue_id order by batchtime desc) as rn from shipdw.hvtb_parse_vxp_locationcon_venues)a where a.rn = 1 and a.global_venue_id <> '')venues left join ( select * from ( select id,name,sim_id,batchtime, row_number() over ( partition by id order by batchtime desc) as rn from shipdw.hvtb_parse_vxp_locationconstruct_sectors )b where b.rn = 1)sector on (venues.sector_id == sector.id) left join shipdw.hvtb_mart_lkp_venue_density_threshold lkup on (venues.global_venue_id == lkup.venue_id) left join( select * from ( select id,name,batchtime, row_number() over( partition by id order by batchtime desc) as rn from shipdw.hvtb_parse_vxp_locationconstruct_sims)c where c.rn = 1) sims on (sims.id == sector.sim_id) left join shipdw.hvtb_mart_dim_org_unit org on (sims.name == org.org_unit_name)
