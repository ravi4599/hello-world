spark.source.sql select course.person_id as person_id, course.person_course_id as person_course_id, course.training_program_course_id as training_program_course_id, course.course_date_started as course_date_started, course.course_date_completed as course_date_completed, course.person_course_certificate_notification as person_course_certificate_notification, ptpro.person_training_program_started as person_training_program_started, ptpro.person_training_program_completed as person_training_program_completed, tpcour.training_program_course_title as course_title, tpcour.course_tier as course_tier_id, tpctier.training_program_course_tier_title as course_tier_title,part_date,batchtime from (select * from (select person_id,person_course_id,training_program_course_id,course_date_started,course_date_completed,person_course_certificate_notification,part_date,batchtime ,row_number() over(partition by person_course_id order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_person_courses where person_course_id > 0 )crse where crse.rn=1)course left join (select * from (select person_id,person_course_id,min(person_training_program_started) as person_training_program_started, max(person_training_program_completed) as person_training_program_completed ,row_number() over(partition by person_id,person_course_id order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_person_training_programs where rec_deleted = false group by person_id,person_course_id,last_changed )ptp where ptp.rn=1) ptpro on (course.person_id = ptpro.person_id and course.person_course_id = ptpro.person_course_id) left join (select * from (select training_program_course_title, course_tier, training_program_course_id,row_number() over(partition by training_program_course_id order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_training_program_courses )tpc where tpc.rn=1) tpcour on (tpcour.training_program_course_id = course.training_program_course_id) left join (select * from (select training_program_course_tier_title, training_program_course_tier_id,row_number() over(partition by training_program_course_tier_id order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_training_program_course_tiers )tpct where tpct.rn=1) tpctier on (tpctier.training_program_course_tier_id = tpcour.course_tier) *whereclause*

spark.source.columns person_id,person_course_id,training_program_course_id,course_date_started,course_date_completed,person_course_certificate_notification,person_training_program_started,person_training_program_completed,course_title,course_tier_id,course_tier_title

