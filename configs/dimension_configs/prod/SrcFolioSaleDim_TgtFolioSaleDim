spark.source.sql select per.voyageid AS voyage_id, per.PERSON_ACCOUNT_DETAIL_ID AS sale_id , cruise.cruise_number AS sales_voyagenumber, orgstr.ORG_STRUCTURE_NAME AS location, syslkp.SYS_LOOKUP_ITEM_NAME AS line_type, CASE WHEN per.STATUS_ID = 3 THEN 'Voided' ELSE '' END AS line_Status, per.ACCOUNT_RECORD_DESCRIPTION AS line_description, CASE WHEN  per.REC_DELETED = 1 THEN TRUE ELSE FALSE END AS src_deleted_flag, per.batchtime AS batchtime, per.part_date AS part_date,per.account_record_type_id as account_record_type_id ,per.created_at_id as created_at_id FROM ( SELECT * FROM ( SELECT voyageid, batchtime, part_date, PERSON_ACCOUNT_DETAIL_ID, STATUS_ID, ACCOUNT_RECORD_DESCRIPTION, REC_DELETED, period_id, org_structure_id, ACCOUNT_RECORD_TYPE_ID,created_at_id, ORG_UNIT_QUICK_CODE, ROW_NUMBER() OVER (PARTITION BY person_account_detail_id ORDER BY last_changed DESC) rn FROM shipdw.hvtb_parse_mxp_person_account_items  where last_changed>='2024-02-01 00:00:00') pac WHERE pac.rn = 1 ) per LEFT JOIN ( SELECT * FROM ( SELECT cruise_number, CRUISE_ID, ROW_NUMBER() OVER (PARTITION BY CRUISE_ID ORDER BY last_changed DESC) rn FROM shipdw.hvtb_parse_mxp_cruise) cr WHERE cr.rn = 1)cruise ON per.period_id = cruise.cruise_id LEFT JOIN ( SELECT * FROM ( SELECT ORG_STRUCTURE_NAME, org_structure_id , ROW_NUMBER() OVER (PARTITION BY ORG_STRUCTURE_ID ORDER BY last_changed DESC) rn FROM shipdw.hvtb_parse_mxp_org_structure) org WHERE org.rn = 1)orgstr ON per.org_structure_id = orgstr.org_structure_id LEFT JOIN ( SELECT * FROM ( SELECT SYS_LOOKUP_ID, SYS_LOOKUP_ITEM_NAME, SYS_LOOKUP_CATEGORY_ID, ROW_NUMBER() OVER (PARTITION BY SYS_LOOKUP_ITEMS_ID ORDER BY last_changed DESC) rn FROM shipdw.hvtb_parse_mxp_sys_lookup_items WHERE SYS_LOOKUP_ACTIVE = 1)sys WHERE sys.rn = 1)syslkp ON per.ACCOUNT_RECORD_TYPE_ID = syslkp.SYS_LOOKUP_ID INNER JOIN ( SELECT * FROM ( SELECT SYS_LOOKUP_CATEGORY_ID , SYS_LOOUP_CATEGORY_NAME, ROW_NUMBER() OVER (PARTITION BY SYS_LOOKUP_CATEGORY_ID ORDER BY last_changed DESC) rn FROM shipdw.hvtb_parse_mxp_sys_lookup_categories WHERE SYS_LOOUP_CATEGORY_NAME = 'Account Line Type')syscat WHERE syscat.rn = 1)syscatlkp ON syslkp.SYS_LOOKUP_CATEGORY_ID = syscatlkp.SYS_LOOKUP_CATEGORY_ID



spark.source.columns voyage_id,batchtime,part_date,sale_id,sales_voyagenumber,location,line_type,line_Status,line_description,src_deleted_flag,account_record_type_id,created_at_id


