spark.query select ship_code as Ship_Code, cabin_category as Category_Code, cabin_category_rank as Category_Rank, is_active as Active, cabin_capacity as Max_Category_Capacity, comments as Category_Name from (select * from (select *,row_number() over(partition by cabin_category_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_cabin_category) p where p.rn=1) cabinCategory where ship_code in ('SC', 'VL', 'RS', 'BR') and cabin_category not in ('SCH', 'SCM', 'SCL', 'SAH', 'SAM', 'SAL')

