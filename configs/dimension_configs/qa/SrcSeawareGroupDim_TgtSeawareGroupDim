spark.source.sql select gb.group_id as src_group_id,gb.group_init_date,gb.group_status,gb.group_type,gb.group_name,gb.group_mode,case when gb.source_code = 'IN HOUSE' then 'Y' else 'N' end as is_internal,gb.source_code,gb.office_code,gh.operator_id as operator,gb.n_of_guests,case when gb.group_status ='CX' then gh.time_stamp else null end as cancellation_date,gb.comments,agencydim.agency_id,agentmaster.agent_id,gb.sail_date_from,gb.sail_date_to,ship.ship_id,case when gb.is_active = 'Y' then True else False end as is_active,case when gb.is_valid = 'Y' then True else False end as is_valid,gb.currency_code,agencydim_sec.agency_id as sec_agency_id ,case when gb.is_charter = 'Y' then True else False end as is_charter,cast(gb.currency_rate as float) as currency_rate,gb.first_full_payment_processed,agentmaster_sec.agent_id as sec_agent_id,cast(gb.client_id as bigint) as client_id,packagedim.package_id,gb.batchtime as batchtime, gb.part_date as part_date,gb.ts_ms as ts_ms_gb,gh.ts_ms as ts_ms_gh from (select * from (select *,row_number() over (partition by group_id order by ts_ms desc, lsn desc) rn from vv_db.hvtb_parse_sw_rpl_group_booking)where rn = 1) gb left join (select group_id, max(group_update_id) as group_update_id from vv_db.hvtb_parse_sw_rpl_group_history_header group by group_id) gh_max on gb.group_id = gh_max.group_id left join (select * from ( select operator_id,time_stamp,group_update_id,ts_ms, row_number() over (partition by group_update_id order by ts_ms desc, lsn desc) as rn from vv_db.hvtb_parse_sw_rpl_group_history_header)hh where hh.rn = 1 ) gh on gh_max.group_update_id = gh.group_update_id left join (select * from vv_db.hvtb_nbx_core_sw_agency_dim where  date(rec_end_dttm) = '9999-12-31')agencydim on gb.agency_id=agencydim.src_agency_id left join (select * from vv_db.hvtb_nbx_mart_crm_agent_master_dim  where  date(rec_end_dttm) = '9999-12-31') agentmaster on gb.agent_id=agentmaster.seaware_agent_id__c left join (select * from vv_db.hvtb_nbx_core_sw_agency_dim where  date(rec_end_dttm) = '9999-12-31') agencydim_sec on gb.sec_agency_id=agencydim_sec.src_agency_id left join (select * from vv_db.hvtb_nbx_mart_crm_agent_master_dim  where  date(rec_end_dttm) = '9999-12-31') agentmaster_sec on gb.sec_agent_id=agentmaster_sec.seaware_agent_id__c left join vv_db.hvtb_nbx_core_sw_ship_dim ship on gb.ship_code =ship.ship left join(select * from vv_db.hvtb_nbx_core_sw_package_dim where date(rec_end_dttm) = '9999-12-31') packagedim on gb.vt_package_id=packagedim.src_package_id

