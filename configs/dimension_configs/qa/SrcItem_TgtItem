spark.source.sql select plu_items.voyageid as voyage_id,cast(plu_items.Plu_Nr as string)as item_plu_number,plu_items.Plu_Desc as item_name,cast(plu_groups.plu_group_nr as string) as item_plu_group_number,plu_groups.plu_group_desc as item_plu_group_name, plu_category.plu_categ_nr as item_plu_category_number,plu_category.plu_categ_desc as item_plu_category_name,cast(null as string) as ship_code, plu_items.Rec_Changed as src_updated_datetime,plu_items.rec_deleted as src_deleted_flag,plu_items.active as src_active_flag,plu_items.PLU_Type as item_plu_type,plu_items.batchtime,plu_items.part_date from ( select * from ( select voyageid,Plu_ID,Plu_Nr,Plu_Desc,PLU_Group_ID,Rec_Changed,rec_deleted,PLU_Type,active,batchtime,part_date,guid,row_number() over(partition by Plu_Nr order by ts_ms desc)rn from shipdw.hvtb_parse_mxp_plu_items where Plu_Nr is not null) where rn = 1)plu_items left join ( select * from ( select active, rec_deleted,PLU_Group_ID,plu_group_nr,plu_group_desc,plu_category_id,row_number() over(partition by PLU_Group_ID order by ts_ms desc)rn from shipdw.hvtb_parse_mxp_pos_plu_groups where rec_deleted = 0 and active = 1 ) where rn = 1)plu_groups ON (plu_items.PLU_Group_ID = plu_groups.PLU_Group_ID) left join ( select * from ( select plu_categ_id, plu_categ_nr,plu_categ_desc,rec_deleted,active,row_number() over(partition by plu_categ_id order by ts_ms desc)rn from shipdw.hvtb_parse_mxp_plu_categories where rec_deleted = 0 and active = 1) where rn = 1)plu_category ON plu_groups.plu_category_id = plu_category.plu_categ_id



