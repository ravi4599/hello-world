spark.source.sql select NVL(pa.VoyageId, -1) as voyage_id,pa.person_address_id as address_id,coun.country_name as address_country,sli.sys_lookup_item_name as address_type,pa.person_is_mailing_address as address_mailing_flg,pa.person_street_1 as address_line1,pa.person_street_2 as address_line2,pa.person_street_3 as address_line3,pa.person_city_name as address_city,pa.person_state as address_state,pa.person_postal_code as address_postal_code,pa.person_phone as phone_number,pa.person_mobile_phone as mobile_phone_number,pa.person_fax as fax_number,pa.person_e_mail as email_address,pa.person_adderss_comment as address_comment,pa.preferred_airport as home_airport,pa.BatchTime,pa.Part_Date from (select * from (select *, row_number() over (partition by person_address_id order by last_changed desc) rn  from shipdw.hvtb_lnd_mxp_Person_Address) where rn = 1) pa left join  (select * from (select *, row_number() over (partition by country_id order by last_changed desc) rn  from shipdw.hvtb_lnd_mxp_Countries) where rn = 1) coun on pa.person_country_id= coun.country_id left join (select * from (select *, row_number() over (partition by sys_lookup_items_id order by last_changed desc) rn  from shipdw.hvtb_lnd_mxp_sys_lookup_items) where rn = 1) sli on pa.person_address_type_id = sli.sys_lookup_id left join (select * from (select *, row_number() over (partition by sys_lookup_category_id order by last_changed desc) rn  from shipdw.hvtb_lnd_mxp_sys_lookup_categories) where rn = 1) slc on sli.sys_lookup_category_id=slc.sys_lookup_category_id and slc.sys_looup_category_name='Address Types'
spark.source.columns voyage_id,address_id,address_country,address_type,address_mailing_flg,address_line1,address_line2,address_line3,address_city,address_state,address_postal_code,phone_number,mobile_phone_number,fax_number,email_address,address_comment,home_airport
