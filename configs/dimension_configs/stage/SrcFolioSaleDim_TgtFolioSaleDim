spark.source.sql select per.voyageid as voyage_id,per.PERSON_ACCOUNT_DETAIL_ID as sales_id ,'FOLIO' as sale_detail_src,'N/A' as sale_operator_num,'N/A' as receipt_number,'N/A' as check_status,cruise.cruise_number as sales_voyagenumber,orgstr.ORG_STRUCTURE_NAME as location,syslkp.SYS_LOOKUP_ITEM_NAME as line_type,CASE WHEN per.STATUS_ID = 3 THEN 'Voided' ELSE '' END as line_Status,per.ACCOUNT_RECORD_DESCRIPTION as line_description,per.REC_DELETED as src_deleted_flag,per.batchtime as batchtime,per.part_date as part_date,'N/A' as sale_group_description from (select * from (select voyageid,batchtime,part_date,PERSON_ACCOUNT_DETAIL_ID,STATUS_ID,ACCOUNT_RECORD_DESCRIPTION,REC_DELETED,period_id,org_structure_id,ACCOUNT_RECORD_TYPE_ID,ORG_UNIT_QUICK_CODE,row_number() over (partition by person_account_detail_id order by last_changed desc) rn  from shipdw.hvtb_parse_mxp_person_account_items where ORG_UNIT_QUICK_CODE in (select category_value from shipdw.hvtb_mart_lkp_revenue_category_rel where category_type = 'FOLIO_QUICKCODE')) pac where pac.rn = 1 ) per left join (select * from (select cruise_number,CRUISE_ID,row_number() over (partition by CRUISE_ID order by last_changed desc) rn  from shipdw.hvtb_parse_mxp_cruise) cr where cr.rn = 1)cruise on per.period_id = cruise.cruise_id left join (select * from (select ORG_STRUCTURE_NAME,org_structure_id ,row_number() over (partition by ORG_STRUCTURE_ID order by last_changed desc) rn  from shipdw.hvtb_parse_mxp_org_structure) org where org.rn = 1)orgstr on per.org_structure_id = orgstr.org_structure_id left join (select * from (select SYS_LOOKUP_ID,SYS_LOOKUP_ITEM_NAME,SYS_LOOKUP_CATEGORY_ID,row_number() over (partition by SYS_LOOKUP_ITEMS_ID order by last_changed desc) rn  from shipdw.hvtb_parse_mxp_sys_lookup_items  where SYS_LOOKUP_ACTIVE = 1)sys where sys.rn = 1)syslkp on per.ACCOUNT_RECORD_TYPE_ID = syslkp.SYS_LOOKUP_ID inner join (select * from (select SYS_LOOKUP_CATEGORY_ID ,SYS_LOOUP_CATEGORY_NAME,row_number() over (partition by SYS_LOOKUP_CATEGORY_ID order by last_changed desc) rn  from shipdw.hvtb_parse_mxp_sys_lookup_categories where SYS_LOOUP_CATEGORY_NAME = 'Account Line Type')syscat where syscat.rn = 1)syscatlkp on syslkp.SYS_LOOKUP_CATEGORY_ID = syscatlkp.SYS_LOOKUP_CATEGORY_ID
spark.source.columns voyage_id,batchtime,part_date,sales_id,sale_detail_src,sale_operator_num,receipt_number,check_status,sales_voyagenumber,location,line_type,line_Status,line_description,src_deleted_flag,sale_group_description

