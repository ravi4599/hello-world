spark.source.sql select pr.VoyageId as voyage_id,pr.PERSON_SPECIAL_REQUEST_ID as specialrequest_id,pr.PERSON_ID as person_id,pr.GUID as specialrequest_guid,lkpit.LOOKUP_ITEM_NAME as specialrequest_type,lkpit.DISPLAY_CODE as specialrequest_type_code,pr.PERSON_SPECIAL_REQUEST_DATE as specialrequest_date,pr.PERSON_SPECIAL_REQUEST_DESCRIPTION as specialrequest_description,pr.PERSON_SPECIAL_REQUEST_COMMENT as specialrequest_comment,pr.LAST_CHANGED as specialrequest_upd_date,case when pr.REC_DELETED=1 then true else false end as src_deleted_flag, pr.BatchTime as BatchTime , pr.Part_date as Part_date from (select * from (select *,row_number()over(partition by person_special_request_id order by last_changed desc,ts_ms desc) as rn  from shipdw.hvtb_parse_mxp_person_special_requests *whereclause*)psr where psr.rn=1)pr left join (select * from (select *,row_number()over(partition by lookup_item_id order by last_changed desc,ts_ms desc) as rn  from shipdw.hvtb_parse_mxp_lookup_items)lkpitem where lkpitem.rn=1) lkpit on (pr.PERSON_SPECIAL_REQUEST_TYPE_ID = lkpit.LOOKUP_ITEM_ID and lkpit.ACTIVE=1 )inner join (select * from (select *,row_number()over(partition by lookup_sub_category_id order by last_changed desc,ts_ms desc) as rn  from shipdw.hvtb_parse_mxp_lookup_sub_categories)lkpsubcat where lkpsubcat.rn=1) lkpsc on (lkpit.LOOKUP_SUB_CATEGORY_ID = lkpsc.LOOKUP_SUB_CATEGORY_ID and lkpsc.LOOKUP_SUB_CATEGORY_NAME in ('Special Request Categories','Off Site Restrictions'))

#select voyageid as voyage_id,batchtime, part_date, NVL(person_skey,-1) as person_skey, special_request_id as specialrequest_id,null specialrequest_guid,special_request_type specialrequest_type,cast(special_request_date as timestamp) as specialrequest_date,special_request_description specialrequest_description,null specialrequest_comment, null as specialrequest_upd_date from(select * from  (select voyageid,batchtime, part_date,NVL(dim_person.person_skey,-1) person_skey,special_request_id,special_request_type,special_request_date,special_request_description, row_number() over (partition by special_request_id order by last_modified_date desc) rn    from shipdw.hvtb_lnd_mxp_sailor_crew_data special_req left JOIN shipdw.hvtb_mart_dim_person dim_person on ( special_req.voyageid == dim_person.voyage_id and special_req.person_id==dim_person.person_id)) t where rn = 1 and special_request_id is not null )d 

spark.source.columns voyage_id,specialrequest_id,person_id,specialrequest_guid,specialrequest_type,specialrequest_type_code,specialrequest_date,specialrequest_description,specialrequest_comment,specialrequest_upd_date,src_deleted_flag
