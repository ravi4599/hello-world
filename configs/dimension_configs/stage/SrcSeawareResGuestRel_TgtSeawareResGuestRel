spark.source.sql select rd.res_id , gd.guest_id , rg.guest_seqn,current_timestamp as rec_start_dttm,case when rg.op == 'd' then current_timestamp else to_timestamp('9999-12-31 00:00:00') end as rec_end_dttm,rg.batchtime as batchtime, rg.Part_date as Part_date from (select * from (select *, row_number()over(partition by guest_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_res_guest *whereclause*)resg where resg.rn=1) rg join vv_db_mig.hvtb_nbx_core_sw_reservation_dim rd on (rg.res_id==rd.src_res_id and to_date(rd.rec_end_dttm) ='9999-12-31') join vv_db_mig.hvtb_nbx_core_sw_guest_dim gd on (rg.guest_id == gd.src_guest_id and to_date(gd.rec_end_dttm )='9999-12-31')

#select rd.res_id , gd.guest_id , rg.guest_seqn,current_timestamp as rec_start_dttm,case when rg.op == 'd' then current_timestamp else to_timestamp('9999-12-31 00:00:00') end as rec_end_dttm,rg.batchtime as batchtime, rg.Part_date as Part_date from (select * from (select *, row_number()over(partition by guest_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_res_guest *whereclause*)resg where resg.rn=1) rg join (select src_res_id, res_id from(select src_res_id, res_id, row_number() over (partition by src_res_id order by rec_end_dttm desc) as rownum from vv_db_mig.hvtb_nbx_core_sw_reservation_dim) res where rownum = 1) rd on (rg.res_id==rd.src_res_id) join (select src_guest_id, guest_id from(select src_guest_id, guest_id, row_number() over (partition by src_guest_id order by rec_end_dttm desc) as rownum from vv_db_mig.hvtb_nbx_core_sw_guest_dim) res where rownum = 1) gd on (rg.guest_id == gd.src_guest_id)


