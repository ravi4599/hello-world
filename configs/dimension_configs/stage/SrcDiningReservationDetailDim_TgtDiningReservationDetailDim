spark.resaction.sql select resact.reservation_id as reservation_id,resact.status as resstatus,resact.created as reservation_created,resact.addeddate as reservation_created_utc, resact.source as source from (select * from (select *, row_number() over (partition by reservation_id ,status  order by lastmodifieddate desc) rn  from shipdw.hvtb_parse_vxp_table_management_reservationaction) where rn = 1)resact


