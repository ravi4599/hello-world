spark.source.sql select a.agency_id as src_agency_id, a.agency_name, a.agency_code, ac.agency_classification_code as agency_market, ac.agency_classification_code as agency_class, r.region_code as agency_sales_region, r.region_code as agency_sales_district, ad.country_code as agency_country, ad.state_code as agency_state, ad.zip as agency_zip, a.batchtime as batchtime, a.part_date as part_date, a.ts_ms as ts_ms_a,ac.ts_ms as ts_ms_ac,arl.ts_ms as ts_ms_arl, r.ts_ms as ts_ms_r, ad.ts_ms as ts_ms_ad from vv_db.hvtb_parse_sw_rpl_agency a left join vv_db.hvtb_parse_sw_rpl_agency_classification_link ac on a.agency_id=ac.agency_id and (ac.agency_class_type='MARKET' and ac.agency_class_type='AGENCY CLASS') left join vv_db.hvtb_parse_sw_rpl_agency_region_link arl on a.agency_id=arl.agency_id and now() between arl.DATE_FROM and arl.DATE_TO left join vv_db.hvtb_parse_sw_rpl_region r on arl.region_id= r.region_id and (r.region_type in ('REGION','DISTRICT') and r.district_type='SALES' and r.is_active='Y') left join vv_db.hvtb_parse_sw_rpl_agency_address ad on a.agency_id=ad.agency_id and ad.address_type='PRIMARY' 

