spark.source.sql select chk.guestId as vxp_guest_id,cast(chk.reservationnumber as integer) as src_res_id,chk.reservationguestid ,preinf.precruiseinfo_transportationtypecode as rts_transfer_response,case when preinf.precruiseinfo_transportationtypecode='FLT_CAR_PRK'  then 'Air' when preinf.precruiseinfo_transportationtypecode='FLT' then 'Air' when preinf.precruiseinfo_transportationtypecode='FLT_CHF' then 'Air' when preinf.precruiseinfo_transportationtypecode='FLT_NO_CAR_PRK'  then 'Air' when preinf.precruiseinfo_transportationtypecode='FLT_NO_CHF'  then 'Air'  else null end as arrival_transportation_mode,null as arrival_booking_source,preinf.precruiseinfo_flightnumber as arrival_flight_number,cast(chk.reservationembarkdate as date) as arrival_transportation_date, preinf.precruiseinfo_arrivaltime as arrival_transportation_time ,case when postinfo.postcruiseinfo_flyingoutplancode = 'FLT_OUT' and postinfo.postcruiseinfo_isopted = true then 'Air' else null end as departure_transportation_mode,null as departure_booking_source,postinfo.postcruiseinfo_flightnumber as departure_flight_number, cast(chk.reservationdebarkdate as date) as departure_transportation_date,preinf.precruiseinfo_departuretime as departure_transportation_time,case when preinf.precruiseinfo_transportationtypecode='CAR_PRK'  then 'Y' when preinf.precruiseinfo_transportationtypecode='FLT_CAR_PRK' then 'Y' when preinf.precruiseinfo_transportationtypecode='FLT_NO_CAR_PRK' then 'Y'  else null end as parking_at_port_flg,chk.statuscode,chk.paymentstatuscode,chk.guestmoderationstatus,chk.guestoveralldocumentstatus,chk.isguestonboard,chk.isvalidated,chk.isassociatedflightBooking,chk.isitineraryrulesapplied,case when chk.checkinguestDetails_security_photo = 1 then 'COMPLETED' when chk.checkinguestDetails_security_photo = 0 then 'PENDING' else null end as security_photo_checkin_status,case when chk.health_questions = 1 then 'COMPLETED' when chk.health_questions = 0 then 'PENDING' else null end as health_questions_checkin_status,case when chk.checkinguestdetails_emergency_contact = 1 then 'COMPLETED' when chk.checkinguestdetails_emergency_contact = 0 then 'PENDING' else null end as emergency_contact_checkin_status,case when chk.checkinguestdetails_travel_documents = 1 then 'COMPLETED' when chk.checkinguestdetails_travel_documents = 0 then 'PENDING' else null end as travel_documents_checkin_status,case when chk.post_voyage = 1 then 'COMPLETED' when chk.post_voyage = 0 then 'PENDING' else null end as post_voyage_checkin_status,case when chk.checkinguestdetails_embarkation_slot = 1 then 'COMPLETED' when chk.checkinguestdetails_embarkation_slot = 0 then 'PENDING' else null end as embarkation_slot_checkin_status,case when chk.checkinguestdetails_voyage_contract = 1 then 'COMPLETED' when chk.checkinguestdetails_voyage_contract = 0 then 'PENDING' else null end as voyage_contract_checkin_status,case when chk.checkinguestdetails_payment_method = 1 then 'COMPLETED' when chk.checkinguestdetails_payment_method = 0 then 'PENDING' else null end as payment_method_checkin_status,case when chk.checkinguestdetails_pregnancy = 1 then 'COMPLETED' when chk.checkinguestdetails_pregnancy = 0 then 'PENDING' else null end as pregnency_checkin_status,chk.percentageCheckinStatus_security_photo as security_photo_checkin_percentage ,chk.percentageCheckinStatus_emergency_contact as emergency_contact_checkin_percentage,chk.percentagecheckinstatus_travel_documents as travel_documents_checkin_percentage,chk.percentagecheckinstatus_embarkation_slot as embarkation_slot_checkin_percentage,chk.percentagecheckinstatus_payment_method as payment_method_checkin_percentage,chk.percentagecheckinstatus_voyage_contract as voyage_contract_checkin_percentage,chk.checkinguestdetails_totalpercentagecheckinstatus as checkin_status_total_percentage,chk.voyageid as voyageid,chk.batchtime as batchtime,chk.part_date as part_date from (select * from (select *, row_number()over(partition by guestId,reservationnumber order by batchtime desc) as rn from vv_db.hvtb_parse_rts_checkinguestdetails *whereclause* )check where check.rn=1 and check.n = 'checkin-party-detail') chk  left join (select * from (select *, row_number()over(partition by guestId,reservationnumber order by batchtime desc) as rn from vv_db.hvtb_parse_rts_precruiseinfo)pre where pre.rn=1 )  preinf on (chk.guestId == preinf.guestId and chk.reservationnumber == preinf.reservationnumber and chk.precruiseinfo_prepostcruiseid == preinf.precruiseinfo_prepostcruiseid) left join (select * from (select *, row_number()over(partition by guestId,reservationnumber order by batchtime desc) as rn from vv_db.hvtb_parse_rts_postcruiseinfo) post where post.rn=1) postinfo on (chk.guestId == postinfo.guestId and chk.reservationnumber == postinfo.reservationnumber and chk.postcruiseinfo_prepostcruiseid == postinfo.postcruiseinfo_prepostcruiseid)

