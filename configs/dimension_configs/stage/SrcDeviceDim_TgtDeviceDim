spark.source.sql SELECT NVL(device.voyageid, - 1) AS voyage_id , device.DEVID AS device_id , daily.DEVTYPID AS device_type_id , daily.DEVTYPNAME AS device_type_name , device.MODELNAME AS device_sub_type_name , device.ASSETNUM AS device_machine_number , device.CATEGORYID AS device_category_id , device.CATEGORYNAME AS device_category_name , device.SUBCATEGORYID AS device_sub_category_id , device.SUBCATEGORYNAME AS device_sub_category_name , device.CABTYPID AS device_cab_type_id , device.CABTYPNAME AS device_cab_type_name , device.SERIALNUM AS device_serial_number , device.ZONEID AS device_zone_id , device.ZONENAME AS device_zone_name , device.BANKID AS bank_id , device.BANKNAME AS bank_name , device.HASBILLACCEPTOR AS bill_acceptor_flg , device.HASCOINACCEPTOR AS coin_acceptor_flg , device.ISLOCKDOWN AS lock_down_flg , device.ISVIDEOPOKER AS video_poker_flg , device.SHIFTID AS shift_id , device.MIXTYPEID AS mix_type_id , device.MIXTYPENAME AS mix_type_name , device.DEVTHEME AS device_theme_name , device.MFRID AS manufacturer_id , device.MFRNAME AS manufacturer_name , device.GSTID AS game_site_id , device.GSTNAME AS game_site_name , device.ISACTIVE AS active_flg , device.DATEINPLACE AS device_start_dt , device.DATESOLD AS device_sold_Dt , device.CURRENCYNAME AS currency_name , device.DEVMODEID AS device_mode_id , device.DEVMODENAME AS device_mode_name , device.GAMINGDAY AS device_operating_dt , device.ONLINEADDR AS online_addr_id , device.ONLINEMAC AS online_mac_id , device.POINTCALCPACKAGE AS calc_package_name , device.POINTCALCPKGID AS calc_package_id , device.FREEPLAYENABLED AS free_play_enabled_flg , device.CWAENABLED AS cwa_enabled_flg , gamesite.GSTNAME AS gstname , gamesite.GSTID AS gstid , CASE WHEN gamesite.gstname = 'Virgin Voyages Scarlet Lady' THEN 'SC' WHEN gamesite.gstname = 'Virgin Voyages Valiant Lady' THEN 'VL' ELSE -1 END as ship_code , daily.batchtime AS Batchtime , daily.part_date AS Part_Date FROM ( SELECT * FROM ( SELECT DEVID , MODELNAME , ASSETNUM , CATEGORYID , CATEGORYNAME , SUBCATEGORYID , SUBCATEGORYNAME , CABTYPID , CABTYPNAME , SERIALNUM , ZONEID , ZONENAME , BANKID , BANKNAME , cast(HASBILLACCEPTOR AS boolean) , cast(HASCOINACCEPTOR AS boolean) , cast(ISLOCKDOWN AS boolean) , cast(ISVIDEOPOKER AS boolean) , SHIFTID , MIXTYPEID , MIXTYPENAME , DEVTHEME , MFRID , MFRNAME , GSTID , GSTNAME , cast(ISACTIVE AS boolean) , DATEINPLACE , DATESOLD , CURRENCYNAME , DEVMODEID , DEVMODENAME , GAMINGDAY , ONLINEADDR , ONLINEMAC , POINTCALCPACKAGE , POINTCALCPKGID , cast(FREEPLAYENABLED AS boolean) , cast(CWAENABLED AS boolean) , lastmoddate , voyageid , row_number() OVER ( PARTITION BY DEVID ORDER BY lastmoddate DESC ) rn FROM shipdw.hvtb_parse_konami_vw_odbc_device ) WHERE rn = 1 ) device LEFT JOIN ( SELECT * FROM ( SELECT voyage_id , DEVID , DEVTYPID , DEVTYPNAME , GSTID , lastmoddate , Batchtime , Part_Date , row_number() OVER ( PARTITION BY DEVID ORDER BY cast(lastmoddate AS TIMESTAMP) DESC ) rn FROM shipdw.hvtb_parse_konami_vw_odbc_dailyptnrtg ) WHERE rn = 1 ) daily ON device.DEVID = daily.DEVID and device.gstid = daily.gstid LEFT JOIN ( SELECT * FROM ( SELECT gstid, gstname, lastmoddate, row_number() over(partition by gstid order by lastmoddate desc) rn from shipdw.hvtb_parse_konami_vw_odbc_gamesite) where rn = 1 ) gamesite on device.gstid = gamesite.gstid

