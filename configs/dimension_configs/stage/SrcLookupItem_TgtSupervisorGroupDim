spark.source.sql SELECT item.voyageid AS voyage_id,item.lookup_item_id AS supervisor_group_id,item.display_code AS supervisor_group_code,item.lookup_item_name AS supervisor_group_name,item.active AS src_active_flag,item.rec_deleted AS src_deleted_flag,item.batchtime,item.part_date FROM (SELECT * FROM (SELECT lookup_item_id, lookup_sub_category_id, display_code, lookup_item_name, active, rec_deleted, voyageid, batchtime, part_date, row_number() over (partition by lookup_item_id order by last_changed desc) as rn FROM shipdw.hvtb_parse_mxp_lookup_items) WHERE rn = 1) item INNER JOIN (SELECT * FROM (SELECT lookup_sub_category_id, lookup_sub_category_name, row_number() over (partition by lookup_sub_category_id order by last_changed desc) as rn FROM shipdw.hvtb_parse_mxp_lookup_sub_categories) WHERE rn = 1) sub_category ON item.lookup_sub_category_id = sub_category.lookup_sub_category_id AND sub_category.lookup_sub_category_name = 'Supervisor Groups'
spark.source.columns voyage_id,supervisor_group_id,supervisor_group_code,supervisor_group_name,src_active_flag,src_deleted_flag,batchtime
spark.pond.allColumns voyage_id AS pond_voyage_id,supervisor_group_skey AS pond_supervisor_group_skey,supervisor_group_id AS pond_supervisor_group_id,supervisor_group_code AS pond_supervisor_group_code,supervisor_group_name AS pond_supervisor_group_name,src_active_flag AS pond_src_active_flag,src_deleted_flag AS pond_src_deleted_flag,load_dt AS pond_load_dt,upd_dt AS pond_upd_dt,primaryhash AS pond_primaryhash,md5_hash AS pond_md5_hash
