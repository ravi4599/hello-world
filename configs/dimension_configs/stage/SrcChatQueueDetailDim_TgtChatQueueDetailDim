spark.source.sql select NVL(A.VoyageId, -1) as voyage_id, A.id as chat_queue_id,B.iam_user_id, A.subject as chat_subject, case when A.status=1 then 'New' when A.status=2 then 'In Progess' when A.status=3 then 'Resolved' else null end as chat_status,A.loyalty_level, A.BatchTime, A.Part_Date from (select zs.id,zs.subject,zs.status,zs.loyalty_level,zs.sailor_id,zs.VoyageId,zs.BatchTime,zs.Part_Date from (select *, row_number() over (partition by id order by Batchtime desc) rn  from shipdw.hvtb_parse_zulip_zerver_supportqueue)zs where zs.rn = 1) A left join (select zu.id,zu.iam_user_id from (select *, row_number() over (partition by id order by BatchTime desc) rn  from shipdw.hvtb_parse_zulip_zerver_userprofile) zu where zu.rn = 1) B on A.sailor_id=B.id

spark.source.columns voyage_id,chat_queue_id,iam_user_id,chat_subject,chat_status,loyalty_level

