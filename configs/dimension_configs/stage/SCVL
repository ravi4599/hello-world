spark.query select sh.sail_id AS Sail_ID, sh.sail_code AS Sail_Code, pd.package_type AS Package_Type, sh.route_code AS Route_Code, sh.ship_code AS Ship, DATEDIFF(sh.sail_date_to, sh.sail_date_from) AS Days, sh.sail_date_from as Sail_Start, sh.sail_date_to AS Sail_End, sh.port_from AS Port_From, sh.port_to AS Port_To, sh.is_fake AS Fake, sh.is_active AS Active, sh.season_code AS Season, sh.sail_status AS Status from vv_db.hvtb_nbx_landing_sw_rpl_sail_header sh join vv_db.hvtb_nbx_core_sw_package_dim pd on pd.src_sail_id=sh.sail_id and pd.package_class='VOYAGE' and pd.rec_end_dttm = '9999-12-31 00:00:00' where sh.ship_code IN ('SC', 'VL') and sh.is_fake = 'N' and sh.is_active = 'Y' and sh.sail_status = 'BK'
spark.temp s3://agency-flat-files-stage/temp
spark.location s3://agency-flat-files-stage/
spark.filename _itinerary_SCVL_sailings
