spark.source.sql   select voyage_id,batchtime,source,allergy_id,parent_allergy_id,allergy_code,allergy_name,src_active_flg,part_date from (select p.VoyageId as voyage_id,p.batchtime,'Table_Management' as source,cast(p.public_id as STRING) as allergy_id,null as parent_allergy_id, p.code as allergy_code, p.name as allergy_name, p.active as src_active_flg,p.part_date from shipdw.hvtb_parse_vxp_table_management_guests_preference p join shipdw.hvtb_parse_vxp_table_management_guests_preferencetype  pt on p.type_id = pt.public_id where pt.code='ALLERGEN' UNION select c.VoyageId as voyage_id,c.batchtime,'Food_Bevarages' as source,c.allergyid as allergy_id,parentallergyid as parent_allergy_id, c.code as allergy_code, c.name as allergy_name, true as src_active_flg,c.part_date from shipdw.hvtb_parse_vxp_foodandbeverage_allergy c)a
   
spark.source.columns   voyage_id,batchtime,source,allergy_id,parent_allergy_id,allergy_code,allergy_name,src_active_flg,part_date
   
spark.pond.allColumns   allergy_skey as pond_allergy_skey,voyage_id as pond_voyage_id,source as pond_source,allergy_id as pond_allergy_id,parent_allergy_id as pond_parent_allergy_id,allergy_code as pond_allergy_code,allergy_name as pond_allergy_name,src_active_flg as pond_src_active_flg,load_dt as pond_load_dt,upd_dt as pond_upd_dt,primaryhash as pond_primaryhash, md5_hash as pond_md5_hash

