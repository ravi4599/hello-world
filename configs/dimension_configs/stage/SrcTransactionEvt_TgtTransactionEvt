spark.source.sql select acc_trans_det.trans_id AS src_trans_id,(CASE WHEN acc_trans_det.SOURCE_ENTITY_TYPE ='RES' then acc_trans_det.SOURCE_ENTITY_ID else case WHEN acc_trans_det.DEST_ENTITY_TYPE ='RES' THEN acc_trans_det.DEST_ENTITY_ID end end) as res_id ,acc_trans_det.trans_status AS trans_status, acc_trans_det.form_of_trans AS form_of_trans, acc_trans_det.trans_type AS trans_type, (case when acc_trans_det.SOURCE_ENTITY_TYPE ='RES' then acc_trans_det.DEST_ENTITY_TYPE else case when acc_trans_det.DEST_ENTITY_TYPE ='RES' then  acc_trans_det.SOURCE_ENTITY_TYPE end end) as entity_type, (case when acc_trans_det.SOURCE_ENTITY_TYPE ='RES' then acc_trans_det.DEST_ENTITY_ID else case when acc_trans_det.DEST_ENTITY_TYPE ='RES' then  acc_trans_det.SOURCE_ENTITY_ID end end) as entity_id,acc_trans_det.trans_time_stamp as trans_time_stamp,  acc_trans_det.currency_trans as  currency_trans, acc_trans_det.amount_full_trans as amount_full_trans, acc_trans_det.rate_transprice as rate_transprice, acc_trans_det.currency_price as currency_price, acc_trans_det.amount_full_price as amount_full_price, acc_trans_det.rate_pricebase as rate_pricebase, acc_trans_det.user_id as operator, acc_trans_det.external_ident as coupon_id,(case when acc_trans_det.SOURCE_ENTITY_TYPE='RES' then 'Y' else case when acc_trans_det.DEST_ENTITY_TYPE='RES' then 'N' end end) as is_dest_entity  from (select * from vv_db.hvtb_parse_sw_rpl_acc_trans_detail where SOURCE_ENTITY_TYPE='RES' or DEST_ENTITY_TYPE='RES' AND form_of_trans='CPN') acc_trans_det left join (select * from vv_db.hvtb_nbx_core_sw_reservation_dim where rec_end_dttm='9999-12-31') rd on acc_trans_det.user_id=rd.src_res_id left join (select * from vv_db.hvtb_nbx_core_sw_coupon_dim  where rec_end_dttm='9999-12-31') cd on cd.src_coupon_id=acc_trans_det.trans_group_id


spark.source.columns src_trans_id,res_id,trans_status,form_of_trans,trans_type,entity_type,entity_id,trans_time_stamp,currency_trans,amount_full_trans,rate_transprice,currency_price,amount_full_price,rate_pricebase,operator,coupon_id,is_dest_entity

