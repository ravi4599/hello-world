spark.source.sql select pm.res_payment_due_item_id as src_res_payment_due_item_id,rd.res_id as res_id, gd.guest_id as guest_id,pm.pmnt_due_item_type as payment_type,current_timestamp as rec_start_dttm,case when pm.op == 'd' then current_timestamp() else to_timestamp('9999-12-31 00:00:00') end as rec_end_dttm,cast(pm.due_date as date) as due_date,pm.amount  as amount,pm.batchtime as batchtime,pm.part_date as part_date from (select * from (select res_payment_due_item_id,pmnt_due_item_type,guest_id,res_id,due_date,amount,batchtime,part_date,op,row_number() over (partition by res_payment_due_item_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_res_payment_due_item )where rn = 1 ) pm left join vv_db_mig.hvtb_nbx_core_sw_reservation_dim rd on pm.res_id=rd.src_res_id and rd.rec_end_dttm=to_timestamp('9999-12-31 00:00:00') left join vv_db_mig.hvtb_nbx_core_sw_guest_dim gd on pm.guest_id=gd.src_guest_id and gd.rec_end_dttm=to_timestamp('9999-12-31 00:00:00') *whereclause*

