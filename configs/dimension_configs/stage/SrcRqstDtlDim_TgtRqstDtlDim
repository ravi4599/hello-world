spark.source.sql   select r.VoyageId as voyage_id,r.public_id as request_id,r.public_id as request_guid, r.description as request_description, r.priority as request_priority, cast(rtc.id as int) as request_category_id, rtc.name as request_category_name, cast(rt.id as int) as request_type_id, rt.name as request_type_name, cast(rt.priority as int) as request_type_priority,r.BatchTime, r.Part_Date from ( select * from (select * , row_number() over(partition by public_id order by batchtime desc) rn from shipdw.hvtb_parse_vxp_housekeeping_requests ) where rn = 1) r left join (select * from (select * , row_number() over(partition by id order by batchtime desc) rn from shipdw.hvtb_parse_vxp_housekeeping_request_types ) where rn = 1) rt on r.request_type = rt.id left join (select * from (select * , row_number() over(partition by id order by batchtime desc) rn from shipdw.hvtb_parse_vxp_housekeeping_req_types_category ) where rn = 1) rtc on rt.category_id = rtc.id

