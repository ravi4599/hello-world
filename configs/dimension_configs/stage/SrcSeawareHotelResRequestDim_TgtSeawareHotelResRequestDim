spark.source.sql select  r.hotel_request_id as src_hotel_res_req_id,r.res_id as src_res_id,ir.guest_id as src_guest_id,r.hotel_request_type as request_type,cast(r.date_from as timestamp) as start_date,cast(r.date_to as timestamp) as end_date,r.city_code as city_code,r.hotel_id as hotel_id,r.hotel_category as hotel_category,r.room_seq_number as room_seq_number,r.hotel_room_category as room_category,r.hotel_room_type as room_type,r.occupancy as occupancy,r.hotel_space_type as hotel_space_type,r.allocation_id as allocation_id,r.inventory_result_type as inv_result,case r.hotel_request_type when 'LAND' then 'Y' when 'SEA' then 'Y' else 'N' end as is_land_component,rr.hotel_bed_type as hotel_bed_type,r.batchtime,r.part_date from  (select * from (select  hotel_request_id,res_id,hotel_request_type,date_from,date_to,city_code,hotel_id,hotel_category,room_seq_number,hotel_room_category,hotel_room_type,occupancy,hotel_space_type,allocation_id,inventory_result_type,batchtime,part_date,row_number() over (partition by hotel_request_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_res_hotel_request )where rn = 1 ) r left join (select * from (select  res_id,room_seq_number,hotel_bed_type,row_number() over (partition by room_request_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_res_room_request )where rn = 1 ) rr on r.res_id=rr.res_id and r.room_seq_number=rr.room_seq_number left join (select * from (select guest_id,room_seq_number,res_id,row_number() over (partition by record_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_res_guest_in_room )where rn = 1 ) ir on r.res_id=ir.res_id and r.room_seq_number=ir.room_seq_number left join (select * from (select allocation_id,row_number() over (partition by allocation_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_hotel_inv_allocation )where rn = 1 ) a on r.allocation_id=a.allocation_id *whereclause*

