spark.source.sql select pro.res_promo_id, rd.res_id, gd.guest_id, pd.package_id, al.addon_id,-1 as carddeck_id,-1 as shorex_id,-1 as hotel_id, pl.promotion_id as promotion_id ,current_timestamp as rec_start_dttm,case when pro.op == 'd' then current_timestamp else to_timestamp('9999-12-31 00:00:00') end as rec_end_dttm, pro.is_active,pro.is_excluded,case when pro.is_manual='Y' then 'FORCED' when pro.is_manual='N' then 'AUTO' when pro.is_manual='E' then 'QUALIFIED' end as promo_mode,pro.batchtime as batchtime,pro.part_date as part_date from (select * from (select *, row_number()over(partition by res_promo_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_res_promotion *whereclause*)respro where respro.rn=1) pro left join (select * from (select *, row_number()over(partition by res_package_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_res_package)respack where respack.rn=1) pkg on pro.res_package_id = pkg.res_package_id left join (select * from (select *, row_number()over(partition by res_addon_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_res_addon)resaddon where resaddon.rn=1) addon on pkg.res_addon_id = addon.res_addon_id left join vv_db_mig.hvtb_nbx_core_sw_reservation_dim rd on pro.res_id=rd.src_res_id and rd.rec_end_dttm='9999-12-31' left join vv_db_mig.hvtb_nbx_core_sw_guest_dim gd on pro.guest_id=gd.src_guest_id and gd.rec_end_dttm='9999-12-31' left join vv_db_mig.hvtb_nbx_core_sw_package_dim pd on pkg.package_id=pd.src_package_id and pd.rec_end_dttm='9999-12-31' left join vv_db_mig.hvtb_nbx_core_sw_addon_lkp al on addon.res_addon_code = al.res_addon_code left join vv_db_mig.hvtb_nbx_core_sw_promotion_lkp pl on pl.promo_code = pro.promo_code

spark.source.columns res_promo_id,res_id,guest_id,package_id,addon_id,carddeck_id,shorex_id,hotel_id,promotion_id,rec_start_dttm,rec_end_dttm,is_active,is_excluded,promo_mode
