spark.source.sql select ars_activityslot.voyageid as voyage_id,ars_activityslot.activityslotid as activity_slot_id,ars_activityslot.activityid as activity_id,ars_activityslot.code as activity_slot_code,ars_activityslot.startdatetime as slot_start_timestamp,ars_activityslot.enddatetime as slot_end_timestamp,(ars_capacity.totalcapacity+ars_capacity.holdcapacity) as total_capacity,(ars_capacity.totalcapacity+ars_capacity.holdcapacity - cnt) as available_capacity,ars_capacity.minimumselling as minimum_party_size,ars_capacity.maximumwaitlistcount as maximum_party_size,ars_activityslot.status as activity_slot_status,ars_activityslot.type as type,ars_activityslot.iswaitlistenable as waitlist_enable_flg,ars_activityslot.iscancelled as cancelled_flg,ars_activityslot.isdeleted as src_deleted_flg,ars_meetingloc.deckcode as meeting_location_deck_code, ars_meetingloc.directioncode as meeting_location_direction_code, ars_meetingloc.sectioncode as meeting_location_section_code, ars_activityslot.BatchTime as BatchTime,ars_activityslot.Part_Date as Part_Date from (select * from (select voyageid,activityslotid,activityid,code,startdatetime,enddatetime,type,iswaitlistenable,iscancelled,isdeleted,BatchTime,Part_Date,capacityid,status,row_number() over(partition by activityslotid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_ars_activityslot) where rn=1) ars_activityslot left join (select * from (select totalcapacity,holdcapacity,minimumselling,maximumwaitlistcount,capacityid,row_number() over(partition by capacityid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_ars_capacity) where rn=1)ars_capacity on trim(ars_capacity.capacityid) = trim(ars_activityslot.capacityid) left join (select * from (select activityslotcode,activitybookingid,row_number() over(partition by activitybookingid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_ars_activitybooking) where rn=1) ars_activitybooking on trim(ars_activityslot.code) = trim(ars_activitybooking.activityslotcode)  left join (select ars_activitypersonbooking.activitybookingid,cnt_tb.cnt from ((select activitybookingid,personid from (select activitybookingid,personid,row_number() over(partition by activitypersonbookingid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_activitypersonbooking) where rn=1) ars_activitypersonbooking inner join (select personid,count(distinct(personid)) as cnt from shipdw.hvtb_parse_vxp_activitypersonbooking group by personid)cnt_tb on ars_activitypersonbooking.personid=cnt_tb.personid)) ars_activitypersonbooking on trim(ars_activitybooking.activitybookingid) = trim(ars_activitypersonbooking.activitybookingid) left join (select * from(select deckcode,sectioncode,directioncode,activityslotid,row_number() over(partition by activityslotid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_ars_meetinglocation) where rn=1) ars_meetingloc on trim(ars_meetingloc.activityslotid) = trim(ars_activityslot.activityslotid)

