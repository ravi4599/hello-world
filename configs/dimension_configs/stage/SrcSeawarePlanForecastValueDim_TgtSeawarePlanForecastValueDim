spark.target.final_collist final_view.plan_forecast_value_id,final_view.plan_forecast_id,final_view.week_index,final_view.rec_start_dttm,final_view.rec_end_dttm,final_view.value,final_view.load_dt,final_view.upd_dt,final_view.primaryhash,final_view.md5_hash

