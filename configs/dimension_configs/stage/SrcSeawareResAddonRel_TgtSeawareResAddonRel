spark.source.sql SELECT ao.res_addon_id as res_addon_id , NVL(pl.promotion_id,null) as promotion_id, NVL(rd.res_id,null) as res_id, NVL(gd.guest_id,null) as guest_id, NVL(al.addon_id,null) as addon_id, NVL(ao.quantity,null) as quantity, NVL(ao.effective_date,null) as effective_date, NVL(ao.is_default,null) as is_default, NVL(ao.is_auto,null) as is_auto, NVL(ao.comments,null) as comments, NVL(ao.addon_status,null) as addon_status, NVL(ao.notes,null) as notes, NVL(ao.paid_date,null) as paid_date, current_timestamp as rec_start_dttm, (case when ao.op == 'd' then current_timestamp else to_timestamp('9999-12-31 00:00:00') end) as rec_end_dttm,ao.batchtime as batchtime,ao.part_date as part_date FROM ( select * from ( select res_addon_id,res_id,res_addon_code,guest_id, quantity, effective_date, is_default, is_auto, comments, addon_status, notes, paid_date,pap_code, op,batchtime,part_date,row_number() over(partition by res_addon_id order by effective_date desc) rn FROM vv_db.hvtb_parse_sw_rpl_res_addon *whereclause*) where rn = 1) ao JOIN vv_db_mig.hvtb_nbx_core_sw_reservation_dim rd ON ao.res_id = rd.src_res_id AND rd.rec_end_dttm = '9999-12-31' JOIN vv_db_mig.hvtb_nbx_core_sw_guest_dim gd ON ao.guest_id = gd.src_guest_id AND gd.rec_end_dttm = '9999-12-31' LEFT JOIN ( select * from ( select *, row_number() over(partition by record_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_am_code) where rn = 1) a ON ao.res_addon_code = a.AMENITY_CODE JOIN vv_db_mig.hvtb_nbx_core_sw_addon_lkp al ON a.amenity_code = al.res_addon_code AND a.am_category = al.addon_category AND a.amenity_type = al.addon_type AND a.amenity_name = al.addon_name LEFT JOIN ( SELECT * FROM ( SELECT * , ROW_NUMBER() OVER ( partition by promo_code ORDER by promotion_id DESC ) row_num FROM vv_db_mig.hvtb_nbx_core_sw_promotion_lkp ) d WHERE row_num = 1 ) pl ON ao.pap_code = pl.promo_code

