spark.source.sql select rg.guest_id as src_guest_id,rg.guest_seqn,rg.guest_type,rg.client_id,rg.age, rg.age_category,rg.gender, ha.address_line1,ha.address_line2,ha.address_city as city,ha.country_code as country,ha.zip,ha.state_code as state,cl.citizenship,ct.country_name as citizenship_name,cl.residence_country_code as residency,cl.last_name,cl.first_name,cl.middle_name,cl.sex,'null' as tier_level,cl.birthday,cl.passport_number, cast(cl.passport_exp_date as date) as passport_exp_date,cast(cl.passport_issue_date as date) as passport_issue_date,cl.passport_issue_place,ai.id_doc_type, ai.id_doc_number,cast(ai.id_doc_expiration_date as date) as id_doc_expiration_date,cast(ai.id_doc_issued_date as date) as id_doc_issue_date,ai.id_doc_issued_country as id_doc_issue_country,ai.id_doc_issued_city as id_doc_issue_city,ai.id2_doc_type,ai.id2_doc_number,cast(ai.id2_doc_expiration_date as date) as id2_doc_expiration_date,cast(ai.id2_doc_issued_date as date) as id2_doc_issue_date,ai.id2_doc_issued_country as id2_doc_issue_country,ai.id2_doc_issued_city as id2_doc_issue_city,cl.email,cl.mobile_intl_code as phone_intl_code,cl.mobile_phone_number as phone_number,cl.is_active as client_is_active, cm.cabin_id, rg.batchtime as batchtime, rg.part_date as part_date,rg.ts_ms as ts_ms_rg,cl.ts_ms as ts_ms_cl,ha.ts_ms as ts_ms_ha,ct.ts_ms as ts_ms_ct,ai.ts_ms as ts_ms_ai from (select * from(select guest_id,guest_seqn,guest_type,client_id,age,age_category,gender,batchtime,part_date,ts_ms,row_number() over (partition by guest_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_res_guest) where rn=1) rg left join (select * from(select citizenship,residence_country_code, last_name,first_name,middle_name,sex,birthday,passport_number,passport_exp_date,passport_issue_date,passport_issue_place,email,mobile_intl_code,mobile_phone_number,ts_ms,client_id,household_id,is_active,row_number() over (partition by client_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_client)where rn=1)cl on (rg.client_id == cl.client_id) left join ( select * from (select address_line1,address_line2,address_city,country_code,zip,state_code,ts_ms,household_id,address_type,household_addr_id, row_number() over(partition by household_addr_id order by household_addr_id desc, ts_ms desc) rn from ( select ha.address_line1,ha.address_line2,ha.address_city, ha.country_code,ha.zip,ha.state_code,ha.ts_ms,ha.household_id,ha.address_type,ha.household_addr_id from vv_db.hvtb_nbx_parse_sw_rpl_household_address ha inner join ( select household_id as ha_household_id, max(household_addr_id) as ha_household_addr_id from vv_db.hvtb_nbx_parse_sw_rpl_household_address where address_type = 'PRIMARY' group by household_id) ha1 on (ha.household_id = ha1.ha_household_id and ha.household_addr_id = ha1.ha_household_addr_id and ha.address_type = 'PRIMARY') ) ) where rn = 1) ha on (cl.household_id == ha.household_id ) left join (select * from (select country_name,ts_ms,country_code,row_number() over (partition by country_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_country) where rn=1) ct on (cl.citizenship = ct.country_code) left join(select * from (select client_id,id_doc_type,id_doc_number,id_doc_expiration_date,id_doc_issued_date,id_doc_issued_country, id_doc_issued_city, id2_doc_type, id2_doc_number,id2_doc_expiration_date,id2_doc_issued_date,id2_doc_issued_country,id2_doc_issued_city,ts_ms,row_number() over (partition by record_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_apis_info) where rn=1) ai on (cl.client_id == ai.client_id) left join (select sr.guest_id,ia.ship_code,ia.cabin_number,sr.allocation_id,ia.allocation_id from (select * from(select guest_id,allocation_id,ts_ms,row_number() over(partition by allocation_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_res_ship_request)where rn=1) sr left join (select * from(select ship_code,allocation_id,cabin_number,ts_ms,row_number() over(partition by allocation_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_ship_inventory_alloc)where rn=1) ia on sr.allocation_id = ia.allocation_id )cabin on rg.guest_id=cabin.guest_id left join vv_db.hvtb_nbx_core_sw_cabin_master cm on cm.cabin_number=cabin.cabin_number and cm.ship=cabin.ship_code 

