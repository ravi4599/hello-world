spark.source.sql select gb.group_id as src_group_id,gb.group_init_date,gb.group_status,gb.group_type,gb.group_name,gb.group_mode,case when gb.source_code = 'IN HOUSE' then 'Y' else 'N' end as is_internal,gb.source_code,gb.office_code,gh.operator_id as operator,gb.n_of_guests,case when gb.group_status ='CX' then gh.time_stamp else null end as cancellation_date,gb.batchtime as batchtime, gb.part_date as part_date,gb.ts_ms as ts_ms_gb,gh.ts_ms as ts_ms_gh from (select * from (select group_id,group_init_date,group_status,group_type,group_name,group_mode,source_code,office_code,n_of_guests,group_status,batchtime,part_date,ts_ms,row_number() over (partition by group_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_group_booking)where rn = 1) gb left join (select group_id, max(group_update_id) as group_update_id from vv_db.hvtb_parse_sw_rpl_group_history_header group by group_id) gh_max on gb.group_id = gh_max.group_id left join (select * from ( select operator_id,time_stamp,group_update_id,ts_ms, row_number() over (partition by group_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_group_history_header)hh where hh.rn = 1 ) gh on gh_max.group_update_id = gh.group_update_id *whereclause*

