spark.source.sql select sh.sail_id as src_sail_id, cast(datediff(sh.sail_date_to,sh.sail_date_from) as int) as sail_days, sh.route_code as sail_route_code, sh.port_from as sail_port_from, sh.port_to as sail_port_to, sh.geog_area_code as sail_geog_area_code, sh.dep_ref_id, sh.arr_ref_id, sa_act1.sail_event_date_time as sail_date_from, sa_act.sail_event_date_time as sail_date_to, sh.is_active, shipdim.ship_id, sh.is_fake, sh.BatchTime as BatchTime, sh.Part_Date as Part_Date, sh.ts_ms as ts_ms_sh, sa_act.ts_ms as ts_ms_sa_act, sa_act1.ts_ms as ts_ms_sa_act1 from (select * from (select sail_id,sail_date_to,sail_date_from,route_code,port_from,port_to,geog_area_code,dep_ref_id,arr_ref_id,is_active,is_fake,BatchTime,Part_Date,ship_code,ts_ms,row_number() over(partition by arr_ref_id order by ts_ms desc) rn from vv_db.hvtb_parse_sw_rpl_sail_header) where rn=1) sh left join (select * from (select sail_event_date_time,dep_arr_ref_id,ts_ms,row_number() over(partition by dep_arr_ref_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_sail_activity) where rn=1) sa_act on(sh.arr_ref_id == sa_act.dep_arr_ref_id) inner join (select * from (select sail_event_date_time,ts_ms,dep_arr_ref_id ,row_number() over(partition by dep_arr_ref_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_sail_activity ) where rn=1) sa_act1 on (sh.dep_ref_id == sa_act1.dep_arr_ref_id) left join vv_db.hvtb_nbx_core_sw_ship_dim shipdim on shipdim.ship = sh.ship_code

