spark.source.sql select ses.voyage_id as voyage_id,ses.public_id as dining_session_id,ses.name as dining_session_name, ses.day_name as session_day_name, voyages.code as session_voyage_number,ses.venue_id as venue_id, set.timeslot_duration as timeslot_duration_seconds,set.max_party_size as max_party_size,ses.batchtime as BatchTime,ses.part_date as Part_Date FROM (select * from (select voyage_id,public_id,name,day_name,venue_id,batchtime,part_date,settings_id,row_number() over (partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_sessions) where rn = 1 ) ses left join (select * from (select code,public_id,row_number() over(partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_voyages )where rn = 1 )voyages on ses.voyage_id=voyages.public_id left join (select * from (select timeslot_duration,public_id,max_party_size,row_number() over (partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_settings )where rn = 1 ) set on ses.settings_id=set.public_id *whereclause*
spark.source.columns voyage_id,dining_session_id,dining_session_name,session_day_name,session_voyage_number,venue_id,timeslot_duration_seconds,max_party_size,BatchTime

