spark.source.sql select cr_iti.voyageid as voyage_id,cr_iti.CRUISE_ID as iti_cruise_id, cr.ACTIVE,cr.CRUISE_TYPE,cr.NEXT_CRUISE_ID as next_cruise_id,cr.CRUISE_NUMBER as voyage_number, cr_iti.CRUISE_ITINERARY_ID as itinerary_id, lower(cr_iti.GUID) as voyage_itinerary_guid, cr.CRUISE_DESCRIPTION as itinerary_name, cr_iti.DAY_OF_CRUISE as itinerary_day, cr.START_DATE   as itinerary_embark_dt, cast(date_add(cr.END_DATE,1) as timestamp) as itinerary_debark_dt, cr_iti.ETA as gangway_open_time, cr_iti.ETD as gangway_close_time, cr_iti.FWE as itinerary_departure_time, cr_iti.SBE as itinerary_arrival_time, cr_iti.AT_SEA  as itinerary_isSeaDay, cr_iti.ITINERARY_DATE as itinerary_day_date, case when cr.ACTIVE <> 1 or cr.cruise_type <> 'C' then false else true end as src_active_flag, case when cr.DELETED = 1 or cr_iti.DELETED = 1 then true else false end as src_deleted_flag,cr_iti.batchtime,cr_iti.part_date from (select * from (select *,row_number() over ( partition by cruise_itinerary_id order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_cruise_itinerary) where rn=1)cr_iti left join (select  ACTIVE,DELETED,CRUISE_ID,NEXT_CRUISE_ID,CRUISE_NUMBER,CRUISE_DESCRIPTION,CRUISE_TYPE,START_DATE,END_DATE from (select *,row_number() over ( partition by cruise_id order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_cruise where ACTIVE = 1) c where c.rn=1) cr on cr.CRUISE_ID = cr_iti.CRUISE_ID

spark.iti.sql select  CRUISE_ID, DAY_OF_CRUISE,port_id,case when sorting_sequence is null then 1 else sorting_sequence end as sorting_sequence,DELETED from (select *,row_number() over ( partition by cruise_itinerary_id order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_cruise_itinerary) where rn=1

spark.cruise.sql select  next_cruise_id from (select *,row_number() over ( partition by cruise_id order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_cruise where ACTIVE = 1 and CRUISE_TYPE = 'C') where rn=1

spark.cities.sql select city_id,city_abbreviation from (select *,row_number() over ( partition by city_id order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_cities) where rn=1

spark.source.columns   voyage_id,voyage_number,itinerary_id,voyage_itinerary_guid,itinerary_name,itinerary_day,itinerary_embark_dt,itinerary_debark_dt,itinerary_embark_port_code,itinerary_debark_port_code,gangway_open_time,gangway_close_time,itinerary_departure_time,itinerary_arrival_time,itinerary_isSeaDay,itinerary_day_date,src_active_flag,src_deleted_flag


