spark.source.sql select pro.res_promo_id, rd.res_id, gd.guest_id, pd.package_id, al.addon_id,-1 as carddeck_id,-1 as shorex_id,-1 as hotel_id, promo_lkp.promotion_id as promotion_id ,current_timestamp as rec_start_dttm,case when pro.op == 'd' then current_timestamp else to_timestamp('9999-12-31 00:00:00') end as rec_end_dttm, pro.is_active,pro.is_excluded,case when pro.is_manual='Y' then 'FORCED' when pro.is_manual='N' then 'AUTO' when pro.is_manual='E' then 'QUALIFIED' end as promo_mode,pro.batchtime as batchtime,pro.part_date as part_date from (select * from (select res_promo_id,is_active,is_excluded,is_manual,res_package_id,res_id,guest_id,promo_code,batchtime,part_date,op,row_number()over(partition by res_promo_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_res_promotion *whereclause*)respro where respro.rn=1) pro left join (select * from (select res_package_id,res_addon_id,package_id,row_number()over(partition by res_package_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_res_package)respack where respack.rn=1) pkg on pro.res_package_id = pkg.res_package_id left join (select * from (select res_addon_id,res_addon_code,row_number()over(partition by res_addon_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_res_addon)resaddon where resaddon.rn=1) addon on pkg.res_addon_id = addon.res_addon_id left join vv_db.hvtb_nbx_core_sw_reservation_dim rd on pro.res_id=rd.src_res_id and rd.rec_end_dttm='9999-12-31' left join vv_db.hvtb_nbx_core_sw_guest_dim gd on pro.guest_id=gd.src_guest_id and gd.rec_end_dttm='9999-12-31' left join vv_db.hvtb_nbx_core_sw_package_dim pd on pkg.package_id=pd.src_package_id and pd.rec_end_dttm='9999-12-31' left join (select NVL(am_code.amenity_code,-1) as res_addon_code, am_code.amenity_name as addon_name,NVL(am_code.am_category,'') as addon_category,NVL(am_code.amenity_type,'') as addon_type ,am_code.concat_pk,addon_lkp.addon_id from ( select amenity_code,amenity_name,am_category,amenity_type,concat( (case when amenity_code = 'null' or trim(amenity_code) is null or length(trim(amenity_code)) = 0 then "" else lower(regexp_replace(trim(amenity_code)," ","")) end), (case when am_category = 'null' or trim(am_category) is null or length(trim(am_category)) = 0 then "" else lower(regexp_replace(trim(am_category)," ","")) end), (case when amenity_type = 'null' or trim(amenity_type) is null or length(trim(amenity_type)) = 0 then "" else lower(regexp_replace(trim(amenity_type)," ","")) end), (case when amenity_name = 'null' or trim(amenity_name) is null or length(trim(amenity_name)) = 0 then "" else lower(regexp_replace(trim(amenity_name)," ","")) end) ) as concat_pk from (select amenity_code,amenity_name,am_category,amenity_type, row_number()over(partition by amenity_code,amenity_name,am_category,amenity_type order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_am_code ) add where add.rn=1 ) am_code left join vv_db.hvtb_nbx_core_sw_addon_lkp addon_lkp on addon_lkp.concat_pk = am_code.concat_pk) al on addon.res_addon_code = al.res_addon_code left join (select * from (select pap_code,pap_name,promo_group, row_number()over(partition by pap_id order by ts_ms desc) as rn from vv_db.hvtb_parse_sw_rpl_pap_master) pap where pap.rn=1) pap_master on pap_master.pap_code = pro.promo_code left join vv_db.hvtb_nbx_core_sw_promotion_lkp promo_lkp on (pap_master.pap_code = promo_lkp.promo_code and pap_master.pap_name= promo_lkp.promo_name and pap_master.promo_group= promo_lkp.promo_group)

