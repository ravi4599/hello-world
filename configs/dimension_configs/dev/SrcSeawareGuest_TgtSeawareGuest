spark.source.sql select a.src_guest_id as src_guest_id,a.client_id as client_id,a.sail_date_from as sail_date_from, a.sail_date_to as sail_date_to,a.src_res_id as src_res_id,b.guestid as vxp_guest_id,b.reservationid as vxp_res_id, b.reservationguestid as vxp_reservation_guest_id, b.batchtime as batchtime,b.part_date as part_date from(select * from (select distinct src_guest_id,cast(client_id as bigint),rec_end_dttm from vv_db.hvtb_nbx_core_sw_guest_dim) gd left join (select guest_id,res_id from  vv_db.hvtb_nbx_core_sw_res_guest_rel) rgl on gd.src_guest_id=rgl.guest_id left join (select src_res_id,src_sail_id,rec_end_dttm from  vv_db.hvtb_nbx_core_sw_reservation_dim) rd on rgl.res_id=rd.src_res_id and rd.rec_end_dttm='9999-12-31' left join (select sail_id, sail_date_from,sail_date_to from vv_db.hvtb_nbx_core_sw_sail_dim)sd on rd.src_sail_id=sd.sail_id  where gd.rec_end_dttm ='9999-12-31') a left join(select * from (select * from (select guestid,guestuniqueid,batchtime,part_date,lastmodifieddate,row_number() over(partition by guestid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_dxp_guest) where rn=1) g left join (select * from (select reservationguestid,guestid as guest_id,reservationid,row_number() over(partition by reservationguestid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_reservationguest) where rn=1)rg on rg.guest_id=g.guestid left join (select * from (select reservationid as reservation_id,reservationnumber,shipcode,sailingpackagecode,fromdate,todate, row_number() over(partition by reservationid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_reservation) where rn=1) r on rg.reservationid = r.reservation_id where g.guestuniqueid is not null) b on  a.client_id=b.guestuniqueid and a.src_res_id=b.reservationnumber 




