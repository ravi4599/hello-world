spark.source.sql select a.agency_id as src_agency_id, a.agency_name, a.agency_code, ac.agency_classification_code as agency_market, acc.agency_classification_code as agency_class, r.region_code as agency_sales_region, d.region_code as agency_sales_district, ad.country_code as agency_country, ad.state_code as agency_state, ad.zip as agency_zip, a.batchtime as batchtime, a.part_date as part_date, a.ts_ms as ts_ms_a,ac.ts_ms as ts_ms_ac,arl.ts_ms as ts_ms_arl, r.ts_ms as ts_ms_r, ad.ts_ms as ts_ms_ad from (select * from(select agency_id,agency_name,agency_code,batchtime,part_date,ts_ms,row_number() over(partition by agency_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_agency) where rn=1) a left join (select * from (select agency_classification_code,ts_ms,agency_id,agency_class_type,row_number() over(partition by agency_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_agency_classification_link)where rn=1) ac on a.agency_id=ac.agency_id and ac.agency_class_type='MARKET' left join (select * from (select agency_classification_code,ts_ms,agency_id,agency_class_type,row_number() over(partition by agency_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_agency_classification_link)where rn=1) acc on a.agency_id=acc.agency_id and acc.agency_class_type='AGENCY CLASS' left join (select * from(select ts_ms,DATE_FROM,DATE_TO,region_id,agency_id,row_number() over(partition by agency_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_agency_region_link)where rn=1) arl on a.agency_id=arl.agency_id and now() between arl.DATE_FROM and arl.DATE_TO left join (select * from(select region_code,region_id,region_type,district_type,is_active,ts_ms,row_number() over(partition by region_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_region)where rn=1) r on arl.region_id= r.region_id and (r.region_type = 'REGION' and r.district_type='SALES' and r.is_active='Y') left join (select * from(select region_code,region_id,region_type,district_type,is_active,ts_ms,row_number() over(partition by region_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_region)where rn=1) d on arl.region_id= d.region_id and (d.region_type ='DISTRICT' and d.district_type='SALES' and d.is_active='Y') left join (select * from(select country_code,state_code,zip,ts_ms,agency_id,address_type,row_number() over(partition by agency_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_agency_address)where rn=1) ad on a.agency_id=ad.agency_id and ad.address_type='PRIMARY' 

