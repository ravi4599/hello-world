spark.source.sql select sr.res_id as res_id,sr.guest_id as guest_id,rp.package_id as package_id,current_timestamp as rec_start_dttm,current_timestamp() - interval 1 second as rec_end_dttm,sr.price_category as price_category,cc_price.cabin_category_rank as price_category_rank,rp.cabin_category_berth as berth_category,cc_berth.cabin_category_rank as berth_category_rank,ia.cabin_category as assigned_category,cc_assigned.cabin_category_rank as assigned_category_rank,concat(ia.cabin_number, ia.ship_code) as generic_category, ia.allocation_id as allocation_id,concat(ia.cabin_number, ia.ship_code) as cabin_id,concat(ia.cabin_number,rp.ship_code,rp.dep_ref_id, rp.arr_ref_id) as sail_cabin_reserve_id,sr.ts_ms as ts_ms from (select * from (select cast(allocation_id as int),cast(res_id as int),cast(guest_id as int),price_category,ship_code,batchtime, part_date,ts_ms,row_number() over(partition by res_id order by ts_ms)as rn from vv_db.hvtb_parse_sw_rpl_res_ship_request)where rn=1)sr left join (select * from(select allocation_id,ship_code,cabin_category,cabin_number,batchtime,part_date,ts_ms,row_number() over(partition by allocation_id order by ts_ms)as rn from vv_db.hvtb_parse_sw_rpl_ship_inventory_alloc)where rn=1) ia on sr.allocation_id = ia.allocation_id left join (select * from(select res_id,guest_id,cast(package_id as int),package_class,cabin_category_berth,dep_ref_id,ship_code,arr_ref_id,batchtime,part_date,ts_ms,row_number() over(partition by res_package_id order by ts_ms)as rn from vv_db.hvtb_parse_sw_rpl_res_package) where rn=1)rp on sr.res_id=rp.res_id and sr.guest_id=rp.guest_id and rp.package_class='VOYAGE' left join (select * from (select cabin_category,cabin_category_rank,ship_code,batchtime,part_date,ts_ms,row_number() over(partition by cabin_category_id order by ts_ms)as rn from shipdw.hvtb_parse_sw_cabin_category)where rn=1)cc_price on sr.price_category = cc_price.cabin_category and sr.ship_code = cc_price.ship_code left join (select * from(select cabin_category,cabin_category_rank,ship_code,batchtime,part_date,ts_ms,row_number() over(partition by cabin_category_id order by ts_ms)as rn from shipdw.hvtb_parse_sw_cabin_category)where rn=1)cc_assigned on ia.cabin_category = cc_assigned.cabin_category and ia.ship_code = cc_assigned.ship_code left join (select * from (select cabin_category,cabin_category_rank,ship_code,batchtime,part_date,ts_ms,row_number() over(partition by cabin_category_id order by ts_ms)as rn from shipdw.hvtb_parse_sw_cabin_category)where rn=1)cc_berth on rp.cabin_category_berth = cc_berth.cabin_category and rp.ship_code = cc_berth.ship_code left join (select * from (select dep_ref_id,arr_ref_id,sail_id,ship_code,batchtime,part_date,ts_ms,row_number() over(partition by sail_id order by ts_ms)as rn from vv_db.hvtb_parse_sw_rpl_sail_header)where rn=1)sh on rp.DEP_REF_ID =sh.DEP_REF_ID and rp.ARR_REF_ID = sh.ARR_REF_ID and rp.SHIP_CODE =sh.SHIP_CODE left join vv_db.hvtb_nbx_core_sw_reservation_dim rd on sr.res_id = rd.src_res_id and rd.rec_end_dttm = '9999-12-31' left join vv_db.hvtb_nbx_core_sw_guest_dim gd on sr.guest_id = gd.src_guest_id AND gd.rec_end_dttm = '9999-12-31' left join vv_db.hvtb_nbx_core_sw_package_dim pd on rp.package_id = pd.src_package_id and pd.rec_end_dttm = '9999-12-31' left join vv_db.hvtb_nbx_core_sw_sail_cabin_reserve_dim scrd on scrd.src_sail_id = sh.sail_id and scrd.cabin_number=ia.cabin_number


