Lookup_Items join ( select * from ( select *, row_number() over (partition by lookup_sub_category_id order by last_changed) as rn from shipdw.hvtb_parse_mxp_lookup_sub_categories) where rn = 1)Lookup_Sub_Categories on Lookup_Items.lookup_sub_category_id = Lookup_Sub_Categories.lookup_sub_category_id and Lookup_Sub_Categories.lookup_sub_category_name in ('Product Codes') where Lookup_Items.rec_deleted = false and Lookup_Items.active = true) lkp_product_code on orgunitquickcodes.PRODUCT_CODE_ID = lkp_product_code.LOOKUP_ITEM_ID where  orgunitquickcodes.org_unit_quick_code_id is not null order by ship_code,org_unit_quick_code_id


