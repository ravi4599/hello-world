spark.source.sql SELECT res_id AS src_res_id ,guest_id AS src_guest_id ,ticket_no ,header_id ,is_independent AS is_booking_independent ,is_paid ,STATUS AS booking_status ,fare_kind ,segment_kind ,fare_base AS seaware_fare_base ,total_tax AS seaware_total_tax ,segment_seqn ,max(flight_id_leg_seqn_1) flight_id_leg_seqn_1 ,max(flight_id_leg_seqn_2) flight_id_leg_seqn_2 ,max(flight_id_leg_seqn_3) flight_id_leg_seqn_3 ,max(flight_id_leg_seqn_4) flight_id_leg_seqn_4 ,effective_date ,current_timestamp AS rec_start_dttm ,( CASE WHEN op = 'd' THEN current_timestamp ELSE to_timestamp('9999-12-31 00:00:00') END ) AS rec_end_dttm ,batchtime ,part_date FROM ( SELECT p.res_id AS res_id ,p.guest_id AS guest_id ,t.ticket_no AS ticket_no ,h.header_id AS header_id ,h.is_independent AS is_independent ,h.is_paid AS is_paid ,h.STATUS AS STATUS ,h.fare_kind AS fare_kind ,h.effective_date ,cost.fare_base AS fare_base ,cost.total_tax AS total_tax ,segment_kind AS segment_kind ,al.segment_seqn AS segment_seqn ,al.op AS op ,al.batchtime AS batchtime ,al.part_date AS part_date ,( CASE WHEN al.leg_seqn = 1 THEN flight_dim.flight_id ELSE NULL END ) AS flight_id_leg_seqn_1 ,( CASE WHEN al.leg_seqn = 2 THEN flight_dim.flight_id ELSE NULL END ) AS flight_id_leg_seqn_2 ,( CASE WHEN al.leg_seqn = 3 THEN flight_dim.flight_id ELSE NULL END ) AS flight_id_leg_seqn_3 ,( CASE WHEN al.leg_seqn = 4 THEN flight_dim.flight_id ELSE NULL END ) AS flight_id_leg_seqn_4 FROM ( SELECT * FROM ( SELECT leg_id ,segment_seqn ,header_id ,segment_id ,leg_seqn ,flight_no ,departure_time ,DATE (departure_time) AS departure_date ,ts_ms ,op ,batchtime ,part_date ,ROW_NUMBER() OVER ( PARTITION BY leg_id ORDER BY ts_ms DESC ) rn FROM vv_db.hvtb_parse_sw_rpl_air_actual_leg *whereclause*	)t WHERE rn = 1 ) al LEFT JOIN vv_db.hvtb_nbx_core_sw_flight_dim flight_dim ON (al.flight_no = flight_dim.flight_no) AND (al.departure_time = flight_dim.departure_time) LEFT JOIN ( SELECT * FROM ( SELECT header_id ,is_independent ,is_paid ,STATUS ,fare_kind ,updated_at ,effective_date ,ROW_NUMBER() OVER ( PARTITION BY header_id ORDER BY updated_at DESC ) rn FROM vv_db.hvtb_parse_sw_rpl_air_actual_header )t WHERE rn = 1 ) h ON al.header_id = h.header_id LEFT JOIN ( SELECT * FROM ( SELECT record_id ,header_id ,pax_id ,ts_ms ,ROW_NUMBER() OVER ( PARTITION BY header_id ,pax_id ORDER BY ts_ms DESC ) rn FROM vv_db.hvtb_parse_sw_rpl_air_actual_pax_link )t WHERE rn = 1 ) px ON al.header_id = px.header_id LEFT JOIN ( SELECT * FROM ( SELECT pax_id ,res_id ,guest_id ,ts_ms ,ROW_NUMBER() OVER ( PARTITION BY pax_id ORDER BY ts_ms DESC ) rn FROM vv_db.hvtb_parse_sw_rpl_passenger )t WHERE rn = 1 ) p ON px.pax_id = p.pax_id LEFT JOIN ( SELECT * FROM ( SELECT segment_id ,segment_kind ,ts_ms ,ROW_NUMBER() OVER ( PARTITION BY segment_id ,header_id ORDER BY ts_ms DESC ) rn FROM vv_db.hvtb_parse_sw_rpl_air_actual_segment )t WHERE rn = 1 ) s ON al.segment_id = s.segment_id LEFT JOIN ( SELECT * FROM ( SELECT ticket_id ,ticket_no ,header_id ,pax_id ,ts_ms ,ROW_NUMBER() OVER ( PARTITION BY header_id ,pax_id ORDER BY ts_ms DESC,ticket_id desc ) rn FROM vv_db.hvtb_parse_sw_rpl_air_actual_ticket )t WHERE rn = 1 ) t ON al.header_id = t.header_id AND p.pax_id = t.pax_id LEFT JOIN ( SELECT c.header_id ,c.pax_id ,c.segment_id ,c.leg_id ,sum(c.fare_base) AS fare_base ,sum(c.total_tax) AS total_tax FROM ( SELECT c.header_id ,c.pax_id ,COALESCE(c.segment_id, 1) AS segment_id ,COALESCE(c.leg_id, 1) AS leg_id ,CASE WHEN c.air_price_code = 'FARE_BASE' THEN c.amount ELSE 0 END AS fare_base ,CASE WHEN c.air_price_code = 'TOTAL_TAX' THEN c.amount ELSE 0 END AS total_tax FROM ( SELECT * FROM ( SELECT cost_item_id ,header_id ,pax_id ,segment_id ,leg_id ,air_price_code ,amount ,ts_ms ,ROW_NUMBER() OVER ( PARTITION BY cost_item_id ORDER BY ts_ms DESC ) rn FROM vv_db.hvtb_parse_sw_rpl_air_actual_cost_item )t WHERE rn = 1 ) c ) c GROUP BY c.header_id ,c.pax_id ,c.segment_id ,c.leg_id ) cost ON al.header_id = cost.header_id AND p.pax_id = cost.pax_id AND cost.segment_id = al.segment_seqn ) main GROUP BY res_id ,guest_id ,header_id ,ticket_no ,is_independent ,is_paid ,STATUS ,fare_kind ,fare_base ,total_tax ,segment_kind ,segment_seqn ,op ,batchtime ,part_date ,effective_date 
spark.alog.sql select res_id, farebaseamount as amadeus_fare_base, totaltax as amadeus_total_tax, cast(airsegmentreference as int) as airsegreference,responded_at from ( select res_id, responded_at, xpath_double(response,	'Booking_OUT/BookingAssociationList/BookingAssociation/PNRList/PNR/BookingCostList/BookingCost/MultiTicketList/Cost/AirCost/FareBaseAmount') as farebaseamount, xpath_double(response,	'Booking_OUT/BookingAssociationList/BookingAssociation/PNRList/PNR/BookingCostList/BookingCost/MultiTicketList/Cost/AirCost/TotalTax') as totaltax, xpath(response,	'Booking_OUT/BookingAssociationList/BookingAssociation/PNRList/PNR/BookingCostList/BookingCost/MultiTicketList/FareSegmentNumberList/AirSegmentReferenceIndicator/AirSegmentReference/text()') as airsegmentreferencetemp  from vv_db.hvtb_parse_sw_rpl_air_amadeus_log where action = 'Booking' and success = 'Y') lateral view explode(airsegmentreferencetemp) airsegmentreferencetable as airsegmentreference

