spark.source.sql select voyage_id, ship_code, voyage_skey, person_skey, venue_skey, schedule_date_skey, schedule_date, schedule_day_period,id,team_member_role, batchtime, part_date from ( select NVL(voyage_dim.voyage_number, 'N/A') as voyage_id, NVL(voyage_dim.ship_code, 'N/A') as ship_code, NVL(voyage_dim.voyage_skey , -1) as voyage_skey, NVL(person_dim.person_skey, -1) as person_skey, NVL(venue_dim.venue_skey, -1) as venue_skey, NVL(date_dim.date_id, -1) as schedule_date_skey, tms.tms_date as schedule_date, tms.day_period as schedule_day_period, tms.id,tms.team_member_role as team_member_role, tms.batchtime as batchtime, tms.part_date as part_date from ( select * from ( select public_id, team_member_id, tms_date, day_period,id,team_member_role, batchtime, part_date, row_number() over(partition by team_member_id order by tms_date desc, batchtime desc )as rn from shipdw.hvtb_parse_vxp_housekeeping_team_member_schedule)team_member where team_member.rn = 1) tms left join ( select * from ( select teammembernumber, teammemberid , row_number() over(partition by teammemberid order by lastmodifieddate desc )as rn from shipdw.hvtb_parse_vxp_dxpcore_teammember)vxp_team where vxp_team.rn = 1 ) tm on (tm.teammemberid == tms.team_member_id) left join shipdw.hvtb_mart_dim_person person_dim on (person_dim.person_external_id == tm.teammembernumber) left join ( select * from ( select place_section_ids , team_member_id, public_id, row_number() over(partition by public_id,team_member_id,place_section_ids order by modified_at desc )as rn from shipdw.hvtb_parse_vxp_housekeeping_team_member_schedule_section)schedule_section where schedule_section.rn = 1) sections on (sections.public_id == tms.public_id) left join ( select * from ( select id, row_number() over(partition by id order by batchtime desc )as rn from shipdw.hvtb_parse_vxp_locationconstruct_tags)ocationconstruct_tags where ocationconstruct_tags.rn = 1) tags on (tags.id == sections.place_section_ids) left join ( select * from ( select venue_id, tag_id, row_number() over(partition by tag_id order by batchtime desc )as rn from shipdw.hvtb_parse_vxp_locationconstruct_venue_tags)venue_tags where venue_tags.rn = 1) ventags on (ventags.tag_id == tags.id) left join ( select * from ( select id, global_venue_id, row_number() over(partition by global_venue_id order by batchtime desc, id desc )as rn from shipdw.hvtb_parse_vxp_locationcon_venues)venues where venues.rn = 1) venue on (ventags.venue_id == venue.id) left join shipdw.hvtb_mart_dim_venue venue_dim on (venue_dim.venue_id == venue.global_venue_id) left join shipdw.hvtb_mart_dim_date date_dim on (date_dim.`date` == tms.tms_date) left join shipdw.hvtb_mart_dim_voyage voyage_dim on (tms.tms_date between voyage_dim.voyage_start_date and voyage_dim.voyage_end_date) )Schedulefact




