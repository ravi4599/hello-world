spark.source.sql select * from (select reservation_id , guid, reservation_from_date, voyage_id , voyage_skey, voyage_start_date, res_org_unit_id, cruise_org_unit_id, voyage_dim_voyage_number, cruise_cruise_number, ship_code , dining_reservation_detail_skey , dining_menu_skey , dining_menu_item_skey , sale_detail_dim_skey , checks_check_id, check_details_check_id, pos_item_skey , dining_item_ordered_datetime , dining_item_served_datetime , dining_item_fulfillment_time_in_seconds , meal_period_name , dining_guest_order_status , batchtime , part_date  from  (select reservation_id , guid, reservation_from_date, NVL(voyage_id,- 1) as voyage_id , NVL(voyage_skey,- 1) as voyage_skey, voyage_start_date, res_org_unit_id, cruise_org_unit_id, voyage_dim_voyage_number, cruise_cruise_number, row_number () over (partition by guid order by voyage_start_date desc) as rn, NVL(ship_code,- 1) as ship_code , NVL(dining_reservation_detail_skey,- 1) as dining_reservation_detail_skey , NVL(dining_menu_skey,- 1) as dining_menu_skey , NVL(dining_menu_item_skey,- 1) as dining_menu_item_skey , NVL(sale_detail_dim_skey,- 1) as sale_detail_dim_skey , checks_check_id, check_details_check_id, NVL(pos_item_skey,- 1) as pos_item_skey , dining_item_ordered_datetime , dining_item_served_datetime , (unix_timestamp(dining_item_served_datetime) - unix_timestamp(dining_item_ordered_datetime)) as dining_item_fulfillment_time_in_seconds , meal_period_name , dining_guest_order_status , batchtime , part_date from ( select res.guid as guid , res.reservation_id as reservation_id , res.voyageid as voyage_id , res.reservation_from_date, voyage_dim.voyage_skey as voyage_skey , voyage_dim.voyage_start_date, res.org_unit_id as res_org_unit_id, cruise.org_unit_id as cruise_org_unit_id, voyage_dim.voyage_number as voyage_dim_voyage_number, cruise.cruise_number as cruise_cruise_number,  org_units.org_unit_abbreviation as ship_code , detail_dim.dining_reservation_detail_skey as dining_reservation_detail_skey ,  cast(null as INT) as dining_menu_skey , cast(null as INT) as dining_menu_item_skey , sale_detail_dim.sale_detail_skey as sale_detail_dim_skey , checks.check_id as checks_check_id, check_details.check_id as check_details_check_id, pos_item_dim.item_skey as pos_item_skey , check_details.rec_created as dining_item_ordered_datetime , checks.sales_time as dining_item_served_datetime , lookup_items.lookup_item_name as meal_period_name , CASE WHEN guest_orders.guest_order_status_id = 1 THEN 'open' WHEN guest_orders.guest_order_status_id = 3 THEN 'closed' ELSE guest_orders.guest_order_status_id END as dining_guest_order_status, res.batchtime as batchtime , res.part_date as part_date from ( select * from ( select reservation_id , org_unit_id , reservation_from_date , guid , table_by_meal_id , voyageid , last_changed , batchtime , part_date , row_number() over ( partition by guid,table_by_meal_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_reservations_pos_lad) where rn = 1 ) res left join (select cruise_number, start_date, end_date, org_unit_id, cruise_type, active, deleted, last_changed from (select cruise_number, start_date, end_date, org_unit_id, cruise_type, active, deleted, last_changed, row_number () over (partition by org_unit_id,cruise_number order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_cruise where cruise_type = 'C' and active = 1) where rn = 1) cruise on res.org_unit_id = cruise.org_unit_id inner join ( select * from ( select voyage_skey , voyage_number , voyage_id , voyage_start_date , voyage_end_date , ship_code , upd_dt , row_number() over (partition by voyage_number , ship_code order by upd_dt desc) as rn from shipdw.hvtb_mart_dim_voyage where src_active_flag = true and src_deleted_flag = false ) where rn = 1 ) voyage_dim on voyage_dim.voyage_number = cruise.cruise_number and cast(res.reservation_from_date as date) between cast(voyage_dim.voyage_start_date as date) and cast(voyage_dim.voyage_end_date as date)  left join ( select * from ( select org_unit_id , last_changed , org_unit_abbreviation , row_number() over ( partition by org_unit_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_org_units ) where rn = 1 ) org_units on res.org_unit_id = org_units.org_unit_id left join shipdw.hvtb_mart_dim_dining_reservation_detail detail_dim on upper(res.guid) = upper(detail_dim.dining_reservation_id) left join ( select * from ( select table_by_meal_id , last_changed , rec_deleted , meals_by_date_id , org_structure_table_id, row_number() over ( partition by table_by_meal_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_tables_by_meals where rec_deleted = 0 ) where rn = 1 ) tables_by_meals on res.table_by_meal_id = tables_by_meals.table_by_meal_id left join ( select * from ( select meals_by_date_id , rec_deleted , menu_id , meal_type_id , org_cost_center_id, last_changed , calender_day_id , meal_to_time , row_number() over (partition by meals_by_date_id,meal_type_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_meals_by_date where rec_deleted = 0 ) where rn = 1 ) meals_by_date on tables_by_meals.meals_by_date_id = meals_by_date.meals_by_date_id left join ( select * from ( select * , row_number() over ( partition by calender_day_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_calender_dates ) where rn = 1 ) cd on meals_by_date.calender_day_id = cd.calender_day_id left join ( select * from ( select org_cost_center_id , org_cost_center_pos_code , last_changed , row_number() over ( partition by org_cost_center_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_org_cost_centers ) where rn = 1 ) org_cost_centers on meals_by_date.org_cost_center_id = org_cost_centers.org_cost_center_id  left join ( select * from ( select org_structure_table_id , table_number , last_changed , row_number() over ( partition by org_structure_table_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_org_structure_tables ) where rn = 1 ) org_structure_tables on tables_by_meals.org_structure_table_id = org_structure_tables.org_structure_table_id left join ( select * from ( select check_id , table_nr , ts_ms , sales_time , row_number() over (partition by table_nr order by ts_ms desc) rn from shipdw.hvtb_parse_mxp_checks) where rn = 1 ) checks on checks.table_nr = org_structure_tables.table_number left join ( select * from ( select location_code , ts_ms , row_number() over ( partition by location_code order by ts_ms desc ) rn from shipdw.hvtb_parse_mxp_pos_sales_outlets ) where rn = 1 ) sales_outlets on org_cost_centers.org_cost_center_pos_code = sales_outlets.location_code left join ( select * from ( select table_by_meal_id , last_changed , guest_no , guest_order_status_id , guest_order_id , row_number() over ( partition by table_by_meal_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_guest_orders ) where rn = 1 ) guest_orders on tables_by_meals.table_by_meal_id = guest_orders.table_by_meal_id left join ( select * from ( select lookup_item_id , last_changed , lookup_item_name , row_number() over ( partition by lookup_item_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_lookup_items ) where rn = 1 ) lookup_items on meals_by_date.meal_type_id = lookup_items.lookup_item_id  left join ( select * from ( select check_id , plu_id , ts_ms , rec_created , rec_deleted , row_number() over ( partition by check_id order by ts_ms desc ) rn from shipdw.hvtb_parse_mxp_check_details where rec_deleted = 0) where rn = 1 ) check_details on checks.check_id = check_details.check_id  left join shipdw.hvtb_mart_dim_sale_detail sale_detail_dim on checks.check_id = sale_detail_dim.sale_id left join ( select * from ( select plu_id , plu_nr , ts_ms , row_number() over ( partition by plu_id order by ts_ms desc ) rn from shipdw.hvtb_parse_mxp_plu_items ) where rn = 1 ) plu_items on check_details.plu_id = plu_items.plu_id left join shipdw.hvtb_mart_dim_pos_item pos_item_dim on cast(plu_items.plu_nr as string) = pos_item_dim.item_plu_number ) item) where rn = 1) item_mxppos_fact
