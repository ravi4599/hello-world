spark.source.sql select  re.voyage_id ,re.voyage_skey,re.dining_reservation_detail_skey,re.dining_table_skey, re.venue_skey,re.table_status,re.table_status_datetime_utc,re.BatchTime,re.part_date,re.public_id from(select res.voyage_id as  voyage_id,res.BatchTime as BatchTime,res.part_date,res.public_id,NVL(dimvo.voyage_skey,-1) as voyage_skey,NVL(dre.dining_reservation_detail_skey,-1) as dining_reservation_detail_skey,NVL(dt.dining_table_skey,-1) as dining_table_skey,NVL(dv.venue_skey,-1) as venue_skey,ra.status as table_status, ra.addeddate as table_status_datetime_utc from (select * from (select venue_id,voyage_id,public_id,BatchTime,part_date,row_number() over(partition by public_id order by lastmodifieddate desc) rn  from shipdw.hvtb_parse_vxp_table_management_reservation)where rn = 1) res left join (select * from(select code,public_id,row_number() over(partition by public_id order by lastmodifieddate desc) rn  from shipdw.hvtb_parse_vxp_table_management_voyages)where rn = 1) vo on res.voyage_id=vo.public_id left outer join shipdw.hvtb_mart_dim_voyage dimvo ON vo.code=dimvo.voyage_number LEFT OUTER JOIN shipdw.hvtb_mart_dim_dining_reservation_detail dre ON res.public_id=dre.dining_reservation_id left join (select * from(select reservation_id,table_id,row_number() over(partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_reservations_reservationtable) where rn = 1 ) rr ON res.public_id=rr.reservation_id LEFT OUTER JOIN shipdw.hvtb_mart_dim_dining_table dt ON rr.table_id = dt.dining_table_id  left join (select * from(select status,addeddate,reservation_id,row_number() over(partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_reservationaction)where rn = 1)ra ON res.public_id=ra.reservation_id left join (select * from (select public_id,external_id,row_number() over(partition by public_id order by lastmodifieddate desc) rn  from shipdw.hvtb_parse_vxp_table_management_venues)where rn = 1)tmv ON  res.venue_id=tmv.public_id left join shipdw.hvtb_mart_dim_venue dv ON dv.venue_id=tmv.external_id ) re where
