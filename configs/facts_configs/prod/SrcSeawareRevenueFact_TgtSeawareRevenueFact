.res_addon_code, '~')= NVL(al.res_addon_code, '~') */ LEFT JOIN vv_db.hvtb_nbx_core_sw_hotel_res_req_dim hd ON rp.hotel_request_id = hd.src_hotel_res_req_id AND rp.guest_id = hd.src_guest_id LEFT JOIN vv_db.hvtb_nbx_core_sw_ship_room_request_dim sr ON rp.shiproom_request_id = sr.src_request_id LEFT JOIN ( SELECT * FROM ( SELECT record_id, param_value, entity_id, entity_type, param_name, TIMESTAMP, ROW_NUMBER() OVER (PARTITION BY entity_id,param_name ORDER BY TIMESTAMP DESC ) rn FROM vv_db.hvtb_parse_sw_rpl_acc_invoice_detail ) WHERE rn = 1 ) aid ON reshdr.res_id = aid.entity_id AND aid.entity_type = 'RES' AND aid.param_name = 'NET_DUE' LEFT JOIN vv_db.hvtb_mart_seware_coupon_class_dim cc ON inv.extended_info = cc.coupon_class AND cc.rec_end_dttm = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_guest_flight_rel fr ON fr.src_guest_id = inv.guest_id AND fr.segment_kind = inv.extended_info AND UPPER(fr.booking_status) = 'BOOKED' AND fr.rec_end_dttm LIKE '999%' ) tab WHERE load_flag = 'Y' AND res_id IS NOT NULL AND guest_id IS NOT NULL





