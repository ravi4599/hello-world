spark.source.sql select NVL(voyage_dim.ship_code, '-1') as ship_code, NVL(voyage_dim.voyage_skey, -1) as voyage_skey, NVL(chat_q.chat_queue_detail_skey, -1) as chat_queue_detail_skey, NVL(person_dim.person_skey, -1) as person_skey, sq.created as queue_joined_datetime, sq.responded as queue_responded_datetime, sq.resolved as queue_resolved_datetime, case when sq.created is not null and sq.responded is not null then unix_timestamp(sq.responded) - unix_timestamp(sq.created) else null end as time_to_respond_seconds, case when sq.responded is not null and sq.resolved is not null then unix_timestamp(sq.resolved) - unix_timestamp(sq.responded) else null end as length_of_interaction_seconds, case when sq.resolved is not null and sq.created is not null then unix_timestamp(sq.resolved) - unix_timestamp(sq.created) else null end as time_in_queue_seconds, sq.VoyageId as voyage_id, sq.BatchTime , sq.Part_Date from ( select * from ( select *, row_number() over (partition by id order by batchtime desc) rn from shipdw.hvtb_parse_zulip_zerver_supportqueue) where rn = 1) sq left join ( select * from ( select *, row_number() over (partition by id order by batchtime desc) rn from shipdw.hvtb_parse_zulip_zerver_userprofile) where rn = 1 ) up on sq.sailor_id = up.id left join (select * from (select *,row_number() over(partition by userid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_iam_userprofile)where rn =1) iam_up on upper(iam_up.userid) = upper(up.iam_user_id) and iam_up.persontypecode = 'G' left join ( select g.guestid, r.voyagenumber, rg.reservationguestid from ( select * from ( select *, row_number() over (partition by guestid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_dxp_guest) where rn = 1) g join ( select * from ( select *, row_number() over (partition by guestid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_reservationguest) where rn = 1 ) rg on rg.guestid = g.guestid join ( select * from ( select *, row_number() over (partition by reservationid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_reservation) where rn = 1 ) r on rg.reservationid = r.reservationid ) rg_main on upper(iam_up.personid) = upper(rg_main.guestid) and rg_main.voyagenumber = sq.voyage_number left join ( select * from ( select * , row_number () over (partition by reservationguest_guid order by coalesce (booking_departure_date, '1900-01-01') desc, md5_hash desc) as rn from shipdw.hvtb_mart_dim_person)per where per.rn = 1) person_dim on upper(rg_main.reservationguestid) = upper(person_dim.reservationguest_guid) left join ( SELECT * FROM ( SELECT voyage_skey, voyage_number, voyage_id, ship_code, upd_dt, ROW_NUMBER() OVER(PARTITION BY voyage_number, ship_code ORDER BY upd_dt DESC) rn FROM shipdw.hvtb_mart_dim_voyage WHERE src_active_flag = TRUE AND src_deleted_flag = FALSE) WHERE rn = 1) voyage_dim on sq.voyage_number = voyage_dim.voyage_number left join shipdw.hvtb_mart_dim_chat_queue_detail chat_q on sq.id = chat_q.chat_queue_id


