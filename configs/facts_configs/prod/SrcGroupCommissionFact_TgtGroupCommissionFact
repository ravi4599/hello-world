spark.source.sql SELECT CURRENT_TIMESTAMP() AS snapshot_date, COALESCE(gd.group_id,-1) AS group_id, COALESCE(pd.package_id,-1) AS package_id, COALESCE(invlkp.invoice_item_type_id,-1) AS invoice_item_type_id, COALESCE(sd.ship_id,-1) AS ship_id, COALESCE(sld.sail_id,-1) AS sail_id, COALESCE(agtd.agent_id,-1) AS agent_id, COALESCE(agyd.agency_id,-1) AS agency_id, COALESCE(gcomm.`grpcom_percent`,0) AS commission_percentage, COALESCE(gcomm.commiss_code,0) AS commission_code, COALESCE(gcomm.commiss_source,0) AS commission_source, COALESCE(gcomm.amount,0) AS commission_amount, COALESCE(gb.currency_code,'USD') AS currency, COALESCE(gb.currency_rate,1) AS currency_rate, CASE WHEN gcomm.commiss_source = 'BASIC, BOOKING, VOYAGE FARE' THEN gcomm.amount ELSE 0 END AS base_commission_voyagefare, CASE WHEN gcomm.commiss_source = 'BASIC, BOOKING, TAXES & FEES' THEN gcomm.amount ELSE 0 END base_commission_taxesandfees, CASE WHEN gcomm.commiss_source = 'BASIC, BOOKING, INSURANCE' THEN gcomm.amount ELSE 0 END base_commission_insurance, CASE WHEN gcomm.commiss_source = 'BASIC, BOOKING, SHORE THINGS' THEN gcomm.amount ELSE 0 END AS base_commission_shorex, CASE WHEN gcomm.commiss_source = 'BASIC, BOOKING, SAILOR LOOT' THEN gcomm.amount ELSE 0 END AS base_commission_sailorloot, CASE WHEN gcomm.commiss_source = 'BONUS, BOOKING, VOYAGE FARE' THEN gcomm.amount ELSE 0 END AS bonus_commission_voyagefare, CASE WHEN gcomm.commiss_source = 'BONUS, BOOKING, TAXES & FEES' THEN gcomm.amount ELSE 0 END AS bonus_commission_taxesandfees, CASE WHEN gcomm.commiss_source = 'GSA, BOOKING, VOYAGE FARE' THEN gcomm.amount ELSE 0 END AS gsa_commission_voyagefare, CASE WHEN gcomm.commiss_source = 'GSA, BOOKING, TAXES & FEES' THEN gcomm.amount ELSE 0 END AS gsa_commission_taxesandfees, CASE WHEN gcomm.commiss_source = 'GSA, BOOKING, INSURANCE' THEN gcomm.amount ELSE 0 END AS gsa_commission_insurance, CASE WHEN gcomm.commiss_source = 'GSA, BOOKING, SHORE THINGS' THEN gcomm.amount ELSE 0 END AS gsa_commission_shorex, CASE WHEN gcomm.commiss_source = 'GSA, BOOKING, SAILOR LOOT' THEN gcomm.amount ELSE 0 END AS gsa_commission_sailorloot, CASE WHEN gcomm.commiss_source ='PROTECTED' THEN gcomm.amount ELSE 0 END AS protected_commission, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'BASIC, BOOKING, VOYAGE FARE' THEN gcomm.amount ELSE 0 END ),0) AS base_commission_voyagefare_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'BASIC, BOOKING, TAXES & FEES' THEN gcomm.amount ELSE 0 END ),0) AS base_commission_taxesandfees_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'BASIC, BOOKING, INSURANCE' THEN gcomm.amount ELSE 0 END ),0) AS base_commission_insurance_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'BASIC, BOOKING, SHORE THINGS' THEN gcomm.amount ELSE 0 END ),0) AS base_commission_shorex_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'BASIC, BOOKING, SAILOR LOOT' THEN gcomm.amount ELSE 0 END ),0) AS base_commission_sailorloot_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'BONUS, BOOKING, VOYAGE FARE' THEN gcomm.amount ELSE 0 END ),0) AS bonus_commission_voyagefare_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'BONUS, BOOKING, TAXES & FEES' THEN gcomm.amount ELSE 0 END ),0) AS bonus_commission_taxesandfees_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'GSA, BOOKING, VOYAGE FARE' THEN gcomm.amount ELSE 0 END ),0) AS gsa_commission_voyagefare_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'GSA, BOOKING, TAXES & FEES' THEN gcomm.amount ELSE 0 END ),0) AS gsa_commission_taxesandfees_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'GSA, BOOKING, INSURANCE' THEN gcomm.amount ELSE 0 END ),0) AS gsa_commission_insurance_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'GSA, BOOKING, SHORE THINGS' THEN gcomm.amount ELSE 0 END ),0) AS gsa_commission_shorex_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source = 'GSA, BOOKING, SAILOR LOOT' THEN gcomm.amount ELSE 0 END ),0)AS gsa_commission_sailorloot_usd, COALESCE(gb.currency_rate*(CASE WHEN gcomm.commiss_source ='PROTECTED' THEN gcomm.amount ELSE 0 END ),0) AS protected_commission_usd FROM vv_db.hvtb_nbx_parse_sw_rpl_group_commission_detail gcomm LEFT JOIN ( SELECT group_id, src_group_id FROM vv_db.hvtb_nbx_core_sw_group_dim gd WHERE to_date(rec_end_dttm) = '9999-12-31' GROUP BY group_id, src_group_id) gd ON gcomm.group_id = gd.src_group_id LEFT JOIN ( SELECT package_id, src_package_id FROM vv_db.hvtb_nbx_core_sw_package_dim pd WHERE to_date(rec_end_dttm) = '9999-12-31' AND src_package_id IS NOT NULL GROUP BY package_id, src_package_id) pd ON gcomm.package_id = CAST(pd.src_package_id AS INT) LEFT JOIN vv_db.hvtb_nbx_core_sw_invoice_item_type_lkp invlkp ON gcomm.invoice_item_type = invlkp.invoice_item_type AND invlkp.invoice_item_subtype IS NULL LEFT JOIN ( SELECT ship_code, group_id FROM vv_db.hvtb_nbx_parse_sw_rpl_group_ship_request shr GROUP BY ship_code, group_id) shr ON gcomm.group_id = shr.group_id LEFT JOIN ( SELECT ship, ship_id FROM vv_db.hvtb_nbx_core_sw_ship_dim sd GROUP BY ship, ship_id) sd ON shr.ship_code = sd.ship LEFT JOIN ( SELECT tc_sail_id, group_id, agent_id, agency_id, currency_code, currency_rate FROM vv_db.hvtb_nbx_parse_sw_rpl_group_booking gb GROUP BY tc_sail_id, group_id, agent_id, agency_id, currency_code, currency_rate) gb ON gcomm.group_id = gb.group_id LEFT JOIN ( SELECT sail_id, src_sail_id FROM vv_db.hvtb_nbx_core_sw_sail_dim sld WHERE to_date(rec_end_dttm) = '9999-12-31' GROUP BY sail_id, src_sail_id) sld ON gb.tc_sail_id = sld.src_sail_id LEFT JOIN ( SELECT agent_id, seaware_agent_id__c FROM vv_db.hvtb_nbx_core_crm_agent_master_dim agtd WHERE seaware_agent_id__c IS NOT NULL AND seaware_agent_id__c!= '' AND to_date(rec_end_dttm) = '9999-12-31' GROUP BY agent_id, seaware_agent_id__c) agtd ON gb.agent_id = agtd.seaware_agent_id__c LEFT JOIN ( SELECT agency_id, seaware_agency_id__c FROM vv_db.hvtb_nbx_core_crm_agency_master_dim agyd WHERE to_date(rec_end_dttm) = '9999-12-31' AND seaware_agency_id__c IS NOT NULL ) agyd ON gb.agency_id = agyd.seaware_agency_id__c
