commiss_source NOT IN ('PROTECTED', 'MANUAL') THEN comm.amount ELSE 0 END AS base_commission_insurance_regular, CASE WHEN invlkp.invoice_item_type = 'INSURANCE' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'PROTECTED' THEN comm.amount ELSE 0 END AS base_commission_insurance_protected, CASE WHEN invlkp.invoice_item_type = 'VOYAGE FARE' AND comm.commiss_code = 'BONUS' AND commiss_source NOT IN ('PROTECTED', 'MANUAL') THEN comm.amount ELSE 0 END AS bonus_commission_voyagefare_regular, CASE WHEN invlkp.invoice_item_type = 'VOYAGE FARE' AND comm.commiss_code = 'BONUS' AND commiss_source = 'PROTECTED' THEN comm.amount ELSE 0 END AS bonus_commission_voyagefare_protected, CASE WHEN invlkp.invoice_item_type = 'VOYAGE FARE' AND comm.commiss_code = 'BONUS' AND commiss_source = 'MANUAL' THEN comm.amount ELSE 0 END AS bonus_commission_voyagefare_manual, CASE WHEN comm.commiss_source = 'GSA, BOOKING, VOYAGE FARE' THEN comm.`amount` ELSE 0 END AS gsa_commission_voyagefare, CASE WHEN comm.commiss_source = 'GSA, BOOKING, TAXES & FEES' THEN comm.`amount` ELSE 0 END AS gsa_commission_taxesandfees, CASE WHEN comm.commiss_source = 'GSA, BOOKING, INSURANCE' THEN comm.`amount` ELSE 0 END AS gsa_commission_insurance, CASE WHEN comm.commiss_source = 'GSA, BOOKING, SHORE THINGS' THEN comm.`amount` ELSE 0 END AS gsa_commission_shorex, CASE WHEN comm.commiss_source IN ('GSA, BOOKING, SAILOR LOOT', 'GSA, BOOKING, SAILOR LOOT +') THEN comm.`amount` ELSE 0 END AS gsa_commission_sailorloot, IF ( UPPER(invlkp.invoice_item_type) IN ('VOYAGE FARE', 'TAXES & FEES', 'INSURANCE'), 0, comm.`amount` ) AS base_commission_other_bookable, COALESCE(Agent.agent_id,-1) AS agent_id, COALESCE(addon_lkp.addon_id,- 1) AS addon_id FROM RES_COMMISSION AS comm LEFT JOIN ( SELECT res_id, src_res_id FROM vv_db.hvtb_nbx_core_sw_reservation_dim rd WHERE to_date(rec_end_dttm) = '9999-12-31') rd ON comm.res_id = rd.src_res_id LEFT JOIN ( SELECT guest_id, src_guest_id FROM vv_db.hvtb_nbx_core_sw_guest_dim gd WHERE to_date(rec_end_dttm) = '9999-12-31') gd ON comm.guest_id = gd.src_guest_id LEFT JOIN vv_db.hvtb_nbx_core_sw_invoice_item_type_lkp invlkp ON comm.invoice_item_type = invlkp.invoice_item_type AND invlkp.invoice_item_subtype IS NULL LEFT JOIN ( SELECT res_id, res_init_date, res_guest_count, agency_id, CASE WHEN sec_agent_id IS NULL THEN agent_id ELSE sec_agent_id END AS agent_id, cabin_category, res_status, ship_code, package_type, sail_date_from, sail_date_to, sec_agency_id, currency_rate, currency_code, cancellation_case, dep_ref_id, arr_ref_id, sec_agent_id, res_type FROM ( SELECT res_id, res_init_date, res_guest_count, agency_id, agent_id, cabin_category, res_status, ship_code, package_type, sail_date_from, sail_date_to, sec_agency_id, currency_rate, currency_code, cancellation_case, dep_ref_id, arr_ref_id, sec_agent_id, res_type, op, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY res_id ORDER BY ts_ms DESC,lsn DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_header) rh WHERE rn = 1 AND ship_code<>'XE') reshr ON comm.res_id = reshr.res_id LEFT JOIN ( SELECT ship, ship_id FROM vv_db.hvtb_nbx_core_sw_ship_dim) sd ON reshr.ship_code = sd.ship LEFT JOIN ( SELECT seaware_agencyid__c, seaware_agent_id__c, agent_id FROM vv_db.hvtb_nbx_core_crm_agent_master_dim Agent WHERE to_date(Agent.rec_end_dttm) = '9999-12-31' ) Agent ON reshr.agent_id = Agent.seaware_agent_id__c LEFT JOIN vv_db.hvtb_nbx_core_sw_agency_dim Agency ON reshr.agency_id = Agency.src_agency_id AND to_date(Agency.rec_end_dttm) = '9999-12-31' LEFT JOIN ( SELECT sail_id, ship_code, sail_date_from, sail_date_to, rel_day_from, rel_day_to, sail_status, is_fake, is_active, dep_ref_id, arr_ref_id FROM ( SELECT sail_id, ship_code, sail_date_from, sail_date_to, rel_day_from, rel_day_to, sail_status, is_fake, is_active, dep_ref_id, arr_ref_id, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY sail_id, dep_ref_id, arr_ref_id, ship_code ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_sail_header) WHERE rn = 1) sh ON reshr.dep_ref_id = sh.dep_ref_id AND reshr.arr_ref_id = sh.arr_ref_id LEFT JOIN ( SELECT sail_id, src_sail_id FROM vv_db.hvtb_nbx_core_sw_sail_dim sld WHERE to_date(rec_end_dttm) = '9999-12-31' ) sld ON sh.sail_id = sld.src_sail_id LEFT JOIN vv_db.hvtb_nbx_core_swrpl_commission_type_lkp commlkp ON comm.commiss_source = commlkp.commission_source AND comm.commiss_code = commlkp.commission_code LEFT JOIN ( SELECT res_package_id, ship_code, res_addon_id, start_date, end_date, effective_date, res_id, guest_id, package_type, package_id, dep_ref_id, arr_ref_id FROM ( SELECT res_package_id, start_date, end_date, effective_date, res_id, guest_id, package_type, package_id, dep_ref_id, arr_ref_id, ship_code, cabin_category, cabin_category_berth, cabin_seq_numbers, package_class, res_addon_id, src_package_id, src_dep_ref_id, src_package_class, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY res_package_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_package) rp WHERE rn = 1 ) respk ON comm.res_package_id = respk.res_package_id LEFT JOIN ( SELECT package_id, src_package_id FROM vv_db.hvtb_nbx_core_sw_package_dim pd WHERE to_date(rec_end_dttm) = '9999-12-31' AND src_package_id IS NOT NULL ) pd ON respk.package_id = CAST(pd.src_package_id AS INT) LEFT JOIN ( SELECT res_package_id, ship_code, res_addon_id, start_date, end_date, effective_date, res_id, guest_id, package_type, package_id, dep_ref_id, arr_ref_id FROM ( SELECT res_package_id, start_date, end_date, effective_date, res_id, guest_id, package_type, package_id, dep_ref_id, arr_ref_id, ship_code, cabin_category, cabin_category_berth, cabin_seq_numbers, package_class, res_addon_id, src_package_id, src_dep_ref_id, src_package_class, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY res_id, guest_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_package WHERE package_class = 'VOYAGE') rp WHERE rn = 1) res_package_voy ON comm.res_id = res_package_voy.res_id AND comm.guest_id = res_package_voy.guest_id LEFT JOIN ( SELECT package_id, src_package_id FROM vv_db.hvtb_nbx_core_sw_package_dim WHERE to_date(rec_end_dttm) = '9999-12-31' AND src_package_id IS NOT NULL ) seaware_package_dim_voy ON seaware_package_dim_voy.src_package_id = res_package_voy.package_id LEFT JOIN ( SELECT res_addon_id, guest_id, res_id, res_addon_code, pap_code, addon_status, addon_price_code, paid_date, ts_ms, shipcode, batchtime FROM ( SELECT res_addon_id, guest_id, res_id, res_addon_code, pap_code, addon_status, addon_price_code, paid_date, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY res_addon_id, res_id, guest_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_addon) addon WHERE rn = 1) ra ON respk.res_addon_id = ra.res_addon_id LEFT JOIN ( SELECT amenity_code, am_category, amenity_type, amenity_name FROM ( SELECT amenity_code, am_category, amenity_type, amenity_name, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY amenity_code, am_category ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_am_code) code WHERE rn = 1) am ON ra.res_addon_code = am.amenity_code LEFT JOIN ( SELECT addon_id, res_addon_code, addon_category, IF (addon_type ='',NULL,addon_type) AS addon_type, addon_name FROM vv_db.hvtb_nbx_core_sw_addon_lkp) addon_lkp ON COALESCE(addon_lkp.res_addon_code, '~') = COALESCE(am.amenity_code, '~') AND COALESCE(addon_lkp.addon_category, '~') = COALESCE(am.am_category, '~') AND COALESCE(addon_lkp.addon_type, '~') = COALESCE(am.amenity_type, '~'))

#spark.source.sql WITH RES_COMMISSION AS ( SELECT * FROM ( SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, NULL AS charge_id, 'N' AS is_cancelled, `percent`, amount, invoice_item_type, commiss_fare, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id FROM ( SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, NULL AS charge_id, 'N' AS is_cancelled, `percent`, amount, invoice_item_type, commiss_fare, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id, ts_ms, op FROM ( SELECT * FROM ( SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, percent, amount, invoice_item_type, commiss_fare, is_manual_adjustment, res_product_id, invoice_hdr_id, client_id, guest_seqn, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id, op, ts_ms, batchtime, row_number () OVER (PARTITION BY res_commiss_detail_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_commission_detail ) detail WHERE rn = 1 ) a WHERE op != 'd') b WHERE res_package_id IS NOT NULL UNION SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, NULL AS charge_id, 'Y' AS is_cancelled, `percent`, amount, invoice_item_type, commiss_fare, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id FROM ( SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, `percent`, amount, invoice_item_type, commiss_fare, is_manual_adjustment, res_product_id, invoice_hdr_id, client_id, guest_seqn, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id, op, ts_ms, batchtime, row_number () OVER (PARTITION BY res_commiss_detail_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_nbx_parse_sw_rpl_res_commission_cancel WHERE res_package_id IS NOT NULL ) cancel WHERE rn = 1 UNION SELECT record_id, NULL AS res_package_id, guest.guest_id AS guest_id, entity_id AS res_id, commiss_source, commiss_code, charge_id, 'N' AS is_cancelled, `percent`, amount, NULL AS invoice_item_type, commiss_fare, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id FROM ( SELECT * FROM ( SELECT record_id, entity_type, entity_id, charge_id, commiss_code, amount, commiss_fare, commiss_source, `percent`, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id, op, ts_ms, batchtime, part_date, row_number () OVER (PARTITION BY entity_id, charge_id, commiss_code, commiss_source ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_charge_commission WHERE entity_type = 'RES' ) WHERE rn = 1) charge LEFT JOIN ( SELECT * FROM ( SELECT guest_id, guest_seqn, occupancy_number, res_id, client_id, guest_type, age, age_category, gender, is_dummy, parent_guest_id, secret_seed, secret_code, op, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY guest_id, res_id, client_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_guest) WHERE rn = 1) guest ON (charge.entity_id = guest.res_id AND guest.guest_seqn = 1)) comm) SELECT snapshot_date, res_id, guest_id, package_id, addon_id, invoice_item_type_id, ship_id, agency_id, agent_id, sail_id, currency_code, CAST(currency_rate AS double) AS currency_rate, commission_type_skey, charge_id, is_cancelled, commission_percent, CAST(commission_amount AS double) AS commission_amount, CAST(commission_fare AS double) AS commission_fare, commission_payout_date, CAST(COALESCE(base_commission_voyagefare_regular, 0.0) AS double) AS base_commission_voyagefare_regular, CAST(COALESCE(base_commission_voyagefare_protected, 0.0) AS double) AS base_commission_voyagefare_protected, CAST(COALESCE(base_commission_voyagefare_manual, 0.0) AS double) AS base_commission_voyagefare_manual, CAST(COALESCE(base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual, 0.0 ) AS double) AS base_commission_voyagefare, CAST(COALESCE(base_commission_taxesandfees_regular, 0.0) AS double) AS base_commission_taxesandfees_regular, CAST(COALESCE(base_commission_taxesandfees_protected, 0.0) AS double) AS base_commission_taxesandfees_protected, CAST(COALESCE(base_commission_taxesandfees_manual, 0.0) AS double) AS base_commission_taxesandfees_manual, CAST(COALESCE(base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual, 0.0) AS double) AS base_commission_taxesandfees, CAST(COALESCE(base_commission_shorex_regular, 0.0) AS double) AS base_commission_shorex_regular, CAST(COALESCE(base_commission_shorex_protected, 0.0) AS double) AS base_commission_shorex_protected, CAST(COALESCE(base_commission_shorex_manual, 0.0) AS double) AS base_commission_shorex_manual, CAST(COALESCE(base_commission_shorex_regular + base_commission_shorex_protected + base_commission_shorex_manual, 0.0) AS double) AS base_commission_shorex, CAST(COALESCE(base_commission_sailorloot_regular, 0.0) AS double) AS base_commission_sailorloot_regular, CAST(COALESCE(base_commission_sailorloot_protected, 0.0) AS double) AS base_commission_sailorloot_protected, CAST(COALESCE(base_commission_sailorloot_manual, 0.0) AS double) AS base_commission_sailorloot_manual, CAST(COALESCE(base_commission_sailorloot_regular + base_commission_sailorloot_protected + base_commission_sailorloot_manual, 0.0) AS double) AS base_commission_sailorloot, CAST(COALESCE(base_commission_hotelfare_regular, 0.0) AS double) AS base_commission_hotelfare_regular, CAST(COALESCE(base_commission_hotelfare_protected, 0.0) AS double) AS base_commission_hotelfare_protected, CAST(COALESCE(base_commission_hotelfare_manual, 0.0) AS double) AS base_commission_hotelfare_manual, CAST(COALESCE(base_commission_hotelfare_regular + base_commission_hotelfare_protected + base_commission_hotelfare_manual, 0.0) AS double) AS base_commission_hotelfare, CAST(COALESCE(base_commission_insurance_regular, 0.0) AS double) AS base_commission_insurance_regular, CAST(COALESCE(base_commission_insurance_protected, 0.0) AS double) AS base_commission_insurance_protected, CAST(COALESCE(base_commission_insurance_regular + base_commission_insurance_protected, 0.0) AS double) AS base_commission_insurance, CAST(COALESCE(bonus_commission_voyagefare_regular, 0.0) AS double) AS bonus_commission_voyagefare_regular, CAST(COALESCE(bonus_commission_voyagefare_protected, 0.0) AS double) AS bonus_commission_voyagefare_protected, CAST(COALESCE(bonus_commission_voyagefare_manual, 0.0) AS double) AS bonus_commission_voyagefare_manual, CAST(COALESCE(bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual, 0.0) AS double) AS bonus_commission, CAST(COALESCE((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual), 0.0) AS double) AS voyagefare_commission, CAST(COALESCE(gsa_commission_voyagefare, 0.0) AS double) AS gsa_commission_voyagefare, CAST(COALESCE(gsa_commission_taxesandfees, 0.0) AS double) AS gsa_commission_taxesandfees, CAST(COALESCE(gsa_commission_insurance, 0.0) AS double) AS gsa_commission_insurance, CAST(COALESCE(gsa_commission_shorex, 0.0) AS double) AS gsa_commission_shorex, CAST(COALESCE(gsa_commission_sailorloot, 0.0) AS double) AS gsa_commission_sailorloot, CAST(COALESCE(((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual) + (base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual)), 0.0) AS double) AS protected_commission, CAST(COALESCE(((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual)), 0.0) AS double) AS base_protected_commission, CAST(COALESCE(base_commission_other_bookable, 0.0) AS double) AS base_commission_other_bookable, CAST(COALESCE(base_commission_voyagefare_regular * currency_rate, 0.0) AS double) AS base_commission_voyagefare_regular_usd, CAST(COALESCE(base_commission_voyagefare_protected * currency_rate, 0.0) AS double) AS base_commission_voyagefare_protected_usd, CAST(COALESCE(base_commission_voyagefare_manual * currency_rate, 0.0) AS double) AS base_commission_voyagefare_manual_usd, CAST(COALESCE((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual), 0.0) * currency_rate AS double) AS base_commission_voyagefare_usd, CAST(COALESCE(base_commission_taxesandfees_regular, 0.0) * currency_rate AS double) AS base_commission_taxesandfees_regular_usd, CAST(COALESCE(base_commission_taxesandfees_protected, 0.0) * currency_rate AS double) AS base_commission_taxesandfees_protected_usd, CAST(COALESCE(base_commission_taxesandfees_manual, 0.0) * currency_rate AS double) AS base_commission_taxesandfees_manual_usd, CAST(COALESCE((base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual), 0.0) * currency_rate AS double) AS base_commission_taxesandfees_usd, CAST(COALESCE(base_commission_shorex_regular, 0.0) * currency_rate AS double) AS base_commission_shorex_regular_usd, CAST(COALESCE(base_commission_shorex_protected, 0.0) * currency_rate AS double) AS base_commission_shorex_protected_usd, CAST(COALESCE(base_commission_shorex_manual, 0.0) * currency_rate AS double) AS base_commission_shorex_manual_usd, CAST(COALESCE((base_commission_shorex_regular + base_commission_shorex_protected + base_commission_shorex_manual), 0.0) * currency_rate AS double) AS base_commission_shorex_usd, CAST(COALESCE(base_commission_sailorloot_regular, 0.0) * currency_rate AS double) AS base_commission_sailorloot_regular_usd, CAST(COALESCE(base_commission_sailorloot_protected, 0.0) * currency_rate AS double) AS base_commission_sailorloot_protected_usd, CAST(COALESCE(base_commission_sailorloot_manual, 0.0) * currency_rate AS double) AS base_commission_sailorloot_manual_usd, CAST(COALESCE((base_commission_sailorloot_regular + base_commission_sailorloot_protected + base_commission_sailorloot_manual), 0.0) * currency_rate AS double) AS base_commission_sailorloot_usd, CAST(COALESCE(base_commission_hotelfare_regular, 0.0) * currency_rate AS double) AS base_commission_hotelfare_regular_usd, CAST(COALESCE(base_commission_hotelfare_protected, 0.0) * currency_rate AS double) AS base_commission_hotelfare_protected_usd, CAST(COALESCE(base_commission_hotelfare_manual, 0.0) * currency_rate AS double) AS base_commission_hotelfare_manual_usd, CAST(COALESCE((base_commission_hotelfare_regular + base_commission_hotelfare_protected + base_commission_hotelfare_manual), 0.0) * currency_rate AS double) AS base_commission_hotelfare_usd, CAST(COALESCE(base_commission_insurance_regular, 0.0) * currency_rate AS double) AS base_commission_insurance_regular_usd, CAST(COALESCE(base_commission_insurance_protected, 0.0) * currency_rate AS double) AS base_commission_insurance_protected_usd, CAST(COALESCE((base_commission_insurance_regular + base_commission_insurance_protected), 0.0) * currency_rate AS double) AS base_commission_insurance_usd, CAST(COALESCE(bonus_commission_voyagefare_regular, 0.0) * currency_rate AS double) AS bonus_commission_voyagefare_regular_usd, CAST(COALESCE(bonus_commission_voyagefare_protected, 0.0) * currency_rate AS double) AS bonus_commission_voyagefare_protected_usd, CAST(COALESCE(bonus_commission_voyagefare_manual, 0.0) * currency_rate AS double) AS bonus_commission_voyagefare_manual_usd, CAST(COALESCE((bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual), 0.0) * currency_rate AS double) AS bonus_commission_usd, CAST(COALESCE((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual) * currency_rate, 0.0) AS double) AS voyagefare_commission_usd, CAST(COALESCE(gsa_commission_voyagefare, 0.0) * currency_rate AS double) AS gsa_commission_voyagefare_usd, CAST(COALESCE(gsa_commission_taxesandfees, 0.0) * currency_rate AS double) AS gsa_commission_taxesandfees_usd, CAST(COALESCE(gsa_commission_insurance, 0.0) * currency_rate AS double) AS gsa_commission_insurance_usd, CAST(COALESCE(gsa_commission_shorex, 0.0) * currency_rate AS double) AS gsa_commission_shorex_usd, CAST(COALESCE(gsa_commission_sailorloot, 0.0) * currency_rate AS double) AS gsa_commission_sailorloot_usd, CAST(COALESCE(((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual) + (base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual)), 0.0) * currency_rate AS double) AS protected_commission_usd, CAST(COALESCE(((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual)), 0.0) * currency_rate AS double) AS base_protected_commission_usd, CAST(COALESCE(base_commission_other_bookable, 0.0) * currency_rate AS double) AS base_commission_other_bookable_usd FROM ( SELECT CURRENT_DATE() AS snapshot_date, COALESCE(rd.res_id,-1) AS res_id, COALESCE(gd.guest_id,-1) AS guest_id, coalesce ( CASE WHEN pd.package_id IS NULL THEN seaware_package_dim_voy.package_id ELSE pd.package_id END , - 1) AS package_id, COALESCE(invlkp.invoice_item_type_id,-1) AS invoice_item_type_id, COALESCE(sd.ship_id,-1) AS ship_id, COALESCE(agency.agency_id,-1) AS agency_id, COALESCE(sld.sail_id,-1) AS sail_id, COALESCE(reshr.currency_code, 'USD') AS currency_code, COALESCE(reshr.currency_rate, 1) AS currency_rate, COALESCE(commlkp.commission_type_id,-1) AS commission_type_skey, comm.charge_id AS charge_id, comm.is_cancelled AS is_cancelled, COALESCE(comm.`percent`, 0) AS commission_percent, comm.`amount` AS commission_amount, comm.commiss_fare AS commission_fare, comm.payout_date AS commission_payout_date, CASE WHEN invlkp.invoice_item_type = 'VOYAGE FARE' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source NOT IN ('PROTECTED', 'MANUAL') THEN comm.amount ELSE 0 END AS base_commission_voyagefare_regular, CASE WHEN invlkp.invoice_item_type = 'VOYAGE FARE' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'PROTECTED' THEN comm.amount ELSE 0 END AS base_commission_voyagefare_protected, CASE WHEN invlkp.invoice_item_type = 'VOYAGE FARE' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'MANUAL' THEN comm.amount ELSE 0 END AS base_commission_voyagefare_manual, CASE WHEN invlkp.invoice_item_type = 'TAXES & FEES' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source NOT IN ('PROTECTED', 'MANUAL') THEN comm.amount ELSE 0 END AS base_commission_taxesandfees_regular, CASE WHEN invlkp.invoice_item_type = 'TAXES & FEES' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'PROTECTED' THEN comm.amount ELSE 0 END AS base_commission_taxesandfees_protected, CASE WHEN invlkp.invoice_item_type = 'TAXES & FEES' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'MANUAL' THEN comm.amount ELSE 0 END AS base_commission_taxesandfees_manual, CASE WHEN invlkp.invoice_item_type = 'SHORE THINGS' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source NOT IN ('PROTECTED', 'MANUAL') THEN comm.amount ELSE 0 END AS base_commission_shorex_regular, CASE WHEN invlkp.invoice_item_type = 'SHORE THINGS' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'PROTECTED' THEN comm.amount ELSE 0 END AS base_commission_shorex_protected, CASE WHEN invlkp.invoice_item_type = 'SHORE THINGS' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'MANUAL' THEN comm.amount ELSE 0 END AS base_commission_shorex_manual, CASE WHEN invlkp.invoice_item_type IN ('SAILOR LOOT', 'SAILOR LOOT +') AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source NOT IN ('PROTECTED', 'MANUAL') THEN comm.amount ELSE 0 END AS base_commission_sailorloot_regular, CASE WHEN invlkp.invoice_item_type IN ('SAILOR LOOT', 'SAILOR LOOT +') AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'PROTECTED' THEN comm.amount ELSE 0 END AS base_commission_sailorloot_protected, CASE WHEN invlkp.invoice_item_type IN ('SAILOR LOOT', 'SAILOR LOOT +') AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'MANUAL' THEN comm.amount ELSE 0 END AS base_commission_sailorloot_manual, CASE WHEN invlkp.invoice_item_type = 'HOTEL FARE' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source NOT IN ('PROTECTED', 'MANUAL') THEN comm.amount ELSE 0 END AS base_commission_hotelfare_regular, CASE WHEN invlkp.invoice_item_type = 'HOTEL FARE' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'PROTECTED' THEN comm.amount ELSE 0 END AS base_commission_hotelfare_protected, CASE WHEN invlkp.invoice_item_type = 'HOTEL FARE' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'MANUAL' THEN comm.amount ELSE 0 END AS base_commission_hotelfare_manual, CASE WHEN invlkp.invoice_item_type = 'INSURANCE' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source NOT IN ('PROTECTED', 'MANUAL') THEN comm.amount ELSE 0 END AS base_commission_insurance_regular, CASE WHEN invlkp.invoice_item_type = 'INSURANCE' AND comm.commiss_code IN ('STANDARD', 'SECONDARY') AND commiss_source = 'PROTECTED' THEN comm.amount ELSE 0 END AS base_commission_insurance_protected, CASE WHEN invlkp.invoice_item_type = 'VOYAGE FARE' AND comm.commiss_code = 'BONUS' AND commiss_source NOT IN ('PROTECTED', 'MANUAL') THEN comm.amount ELSE 0 END AS bonus_commission_voyagefare_regular, CASE WHEN invlkp.invoice_item_type = 'VOYAGE FARE' AND comm.commiss_code = 'BONUS' AND commiss_source = 'PROTECTED' THEN comm.amount ELSE 0 END AS bonus_commission_voyagefare_protected, CASE WHEN invlkp.invoice_item_type = 'VOYAGE FARE' AND comm.commiss_code = 'BONUS' AND commiss_source = 'MANUAL' THEN comm.amount ELSE 0 END AS bonus_commission_voyagefare_manual, CASE WHEN comm.commiss_source = 'GSA, BOOKING, VOYAGE FARE' THEN comm.`amount` ELSE 0 END AS gsa_commission_voyagefare, CASE WHEN comm.commiss_source = 'GSA, BOOKING, TAXES & FEES' THEN comm.`amount` ELSE 0 END AS gsa_commission_taxesandfees, CASE WHEN comm.commiss_source = 'GSA, BOOKING, INSURANCE' THEN comm.`amount` ELSE 0 END AS gsa_commission_insurance, CASE WHEN comm.commiss_source = 'GSA, BOOKING, SHORE THINGS' THEN comm.`amount` ELSE 0 END AS gsa_commission_shorex, CASE WHEN comm.commiss_source IN ('GSA, BOOKING, SAILOR LOOT', 'GSA, BOOKING, SAILOR LOOT +') THEN comm.`amount` ELSE 0 END AS gsa_commission_sailorloot, IF ( UPPER(invlkp.invoice_item_type) IN ('VOYAGE FARE', 'TAXES & FEES', 'INSURANCE'), 0, comm.`amount` ) AS base_commission_other_bookable, COALESCE(Agent.agent_id,-1) AS agent_id, COALESCE(addon_lkp.addon_id,- 1) AS addon_id FROM RES_COMMISSION AS comm LEFT JOIN ( SELECT res_id, src_res_id FROM vv_db.hvtb_nbx_core_sw_reservation_dim rd WHERE to_date(rec_end_dttm) = '9999-12-31') rd ON comm.res_id = rd.src_res_id LEFT JOIN ( SELECT guest_id, src_guest_id FROM vv_db.hvtb_nbx_core_sw_guest_dim gd WHERE to_date(rec_end_dttm) = '9999-12-31') gd ON comm.guest_id = gd.src_guest_id LEFT JOIN vv_db.hvtb_nbx_core_sw_invoice_item_type_lkp invlkp ON comm.invoice_item_type = invlkp.invoice_item_type AND invlkp.invoice_item_subtype IS NULL LEFT JOIN ( SELECT res_id, res_init_date, res_guest_count, agency_id, CASE WHEN sec_agent_id IS NULL THEN agent_id ELSE sec_agent_id END AS agent_id, cabin_category, res_status, ship_code, package_type, sail_date_from, sail_date_to, sec_agency_id, currency_rate, currency_code, cancellation_case, dep_ref_id, arr_ref_id, sec_agent_id, res_type FROM ( SELECT res_id, res_init_date, res_guest_count, agency_id, agent_id, cabin_category, res_status, ship_code, package_type, sail_date_from, sail_date_to, sec_agency_id, currency_rate, currency_code, cancellation_case, dep_ref_id, arr_ref_id, sec_agent_id, res_type, op, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY res_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_header) rh WHERE rn = 1 AND ship_code<>'XE') reshr ON comm.res_id = reshr.res_id LEFT JOIN ( SELECT ship, ship_id FROM vv_db.hvtb_nbx_core_sw_ship_dim) sd ON reshr.ship_code = sd.ship LEFT JOIN ( SELECT seaware_agencyid__c, seaware_agent_id__c, agent_id FROM vv_db.hvtb_nbx_mart_crm_agent_master_dim Agent WHERE to_date(Agent.rec_end_dttm) = '9999-12-31' ) Agent ON reshr.agent_id = Agent.seaware_agent_id__c LEFT JOIN vv_db.hvtb_nbx_core_sw_agency_dim Agency ON reshr.agency_id = Agency.src_agency_id AND to_date(Agency.rec_end_dttm) = '9999-12-31' LEFT JOIN ( SELECT sail_id, ship_code, sail_date_from, sail_date_to, rel_day_from, rel_day_to, sail_status, is_fake, is_active, dep_ref_id, arr_ref_id FROM ( SELECT sail_id, ship_code, sail_date_from, sail_date_to, rel_day_from, rel_day_to, sail_status, is_fake, is_active, dep_ref_id, arr_ref_id, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY sail_id, dep_ref_id, arr_ref_id, ship_code ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_sail_header) WHERE rn = 1) sh ON reshr.dep_ref_id = sh.dep_ref_id AND reshr.arr_ref_id = sh.arr_ref_id LEFT JOIN ( SELECT sail_id, src_sail_id FROM vv_db.hvtb_nbx_core_sw_sail_dim sld WHERE to_date(rec_end_dttm) = '9999-12-31' ) sld ON sh.sail_id = sld.src_sail_id LEFT JOIN vv_db.hvtb_nbx_core_swrpl_commission_type_lkp commlkp ON comm.commiss_source = commlkp.commission_source AND comm.commiss_code = commlkp.commission_code LEFT JOIN ( SELECT res_package_id, ship_code, res_addon_id, start_date, end_date, effective_date, res_id, guest_id, package_type, package_id, dep_ref_id, arr_ref_id FROM ( SELECT res_package_id, start_date, end_date, effective_date, res_id, guest_id, package_type, package_id, dep_ref_id, arr_ref_id, ship_code, cabin_category, cabin_category_berth, cabin_seq_numbers, package_class, res_addon_id, src_package_id, src_dep_ref_id, src_package_class, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY res_package_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_package) rp WHERE rn = 1 ) respk ON comm.res_package_id = respk.res_package_id LEFT JOIN ( SELECT package_id, src_package_id FROM vv_db.hvtb_nbx_core_sw_package_dim pd WHERE to_date(rec_end_dttm) = '9999-12-31' AND src_package_id IS NOT NULL ) pd ON respk.package_id = CAST(pd.src_package_id AS INT) LEFT JOIN ( SELECT res_package_id, ship_code, res_addon_id, start_date, end_date, effective_date, res_id, guest_id, package_type, package_id, dep_ref_id, arr_ref_id FROM ( SELECT res_package_id, start_date, end_date, effective_date, res_id, guest_id, package_type, package_id, dep_ref_id, arr_ref_id, ship_code, cabin_category, cabin_category_berth, cabin_seq_numbers, package_class, res_addon_id, src_package_id, src_dep_ref_id, src_package_class, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY res_id, guest_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_package WHERE package_class = 'VOYAGE') rp WHERE rn = 1) res_package_voy ON comm.res_id = res_package_voy.res_id AND comm.guest_id = res_package_voy.guest_id LEFT JOIN ( SELECT package_id, src_package_id FROM vv_db.hvtb_nbx_core_sw_package_dim WHERE to_date(rec_end_dttm) = '9999-12-31' AND src_package_id IS NOT NULL ) seaware_package_dim_voy ON seaware_package_dim_voy.src_package_id = res_package_voy.package_id LEFT JOIN ( SELECT res_addon_id, guest_id, res_id, res_addon_code, pap_code, addon_status, addon_price_code, paid_date, ts_ms, shipcode, batchtime FROM ( SELECT res_addon_id, guest_id, res_id, res_addon_code, pap_code, addon_status, addon_price_code, paid_date, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY res_addon_id, res_id, guest_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_addon) addon WHERE rn = 1) ra ON respk.res_addon_id = ra.res_addon_id LEFT JOIN ( SELECT amenity_code, am_category, amenity_type, amenity_name FROM ( SELECT amenity_code, am_category, amenity_type, amenity_name, ts_ms, shipcode, batchtime, row_number () OVER (PARTITION BY amenity_code, am_category ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_am_code) code WHERE rn = 1) am ON ra.res_addon_code = am.amenity_code LEFT JOIN (select * from (select addon_id,res_addon_code,addon_category,addon_type,row_number() over(partition by res_addon_code,addon_category,addon_type order by upd_dt desc) as rn from vv_db.hvtb_nbx_core_sw_addon_lkp) where rn = 1)addon_lkp ON COALESCE(addon_lkp.res_addon_code, '~') = COALESCE(am.amenity_code, '~') AND COALESCE(addon_lkp.addon_category, '~') = COALESCE(am.am_category, '~') AND COALESCE(addon_lkp.addon_type, '~') = COALESCE(am.amenity_type, '~'))

spark.source.sql WITH RES_COMMISSION AS ( SELECT * FROM ( SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, NULL AS charge_id, 'N' AS is_cancelled, `percent`, amount, invoice_item_type, commiss_fare, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id FROM ( SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, NULL AS charge_id, 'N' AS is_cancelled, `percent`, amount, invoice_item_type, commiss_fare, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id, ts_ms, op FROM ( SELECT * FROM ( SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, percent, amount, invoice_item_type, commiss_fare, is_manual_adjustment, res_product_id, invoice_hdr_id, client_id, guest_seqn, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id, op, ts_ms, batchtime, row_number () OVER (PARTITION BY res_commiss_detail_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_parse_sw_rpl_res_commission_detail ) detail WHERE rn = 1 ) a WHERE op != 'd') b WHERE res_package_id IS NOT NULL UNION SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, NULL AS charge_id, 'Y' AS is_cancelled, `percent`, amount, invoice_item_type, commiss_fare, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id FROM (select * from (SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, `percent`, amount, invoice_item_type, commiss_fare, is_manual_adjustment, res_product_id, invoice_hdr_id, client_id, guest_seqn, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id, op, ts_ms, batchtime, row_number () OVER (PARTITION BY res_commiss_detail_id ORDER BY ts_ms DESC,lsn DESC) AS rn FROM vv_db.hvtb_nbx_parse_sw_rpl_res_commission_cancel ) a WHERE rn = 1 )cancel where op != 'd' and  res_package_id IS NOT NULL UNION SELECT record_i