spark.source.sql select * from (select *, row_number() over (partition by sale_detail_skey,voyage_skey,sale_date_skey,sale_time_skey,pos_item_skey,check_detail_id  order by booking_arrival_date desc) as rn  from ( select *,NVL(total_collected_sales_amount /(guest_count*voyage_length), 0) as total_collected_sales_ap,total_collected_sales_amount - NVL(cost_of_goods, 0) as total_shared_revenue_amount, NVL((total_collected_sales_amount - cost_of_goods)/(guest_count*voyage_length), 0) as total_shared_revenue_ap  from ( select  voyage_id,NVL(sale_detail_skey,-1) as sale_detail_skey,NVL(pos_item_skey,-1) as pos_item_skey,NVL(person_skey,-1) as person_skey,ship_code,NVL(voyage_skey,-1) as voyage_skey,NVL(itinerary_skey,-1) as itinerary_skey,NVL(outlet_skey,-1) as outlet_skey,NVL(date_id,-1) as sale_date_skey,NVL(time_skey,-1) as sale_time_skey,NVL(venue_skey,-1) as venue_skey,NVL(charge_skey,-1) as charge_skey,sale_quantity,item_list_price_amount,tax_amount,discount_amount,discount_value,NVL((item_list_price_amount*sale_quantity)-tax_amount-discount_amount , 0)as total_collected_sales_amount,case when (person_type_id == '9') then NVL(((item_list_price_amount*sale_quantity)-tax_amount-discount_amount), 0) else 0 end as manual_adjustment_amount, 0 as cost_of_goods,guest_count,voyage_length,sale_group_description,voyage_number,sales_date,check_id ,plu_nr,booking_arrival_date,check_detail_id,item_plu_type,batchtime,part_date  from (select *,CASE WHEN sale1.person_type_id = '9' THEN person2.person_skey2 ELSE sale1.person_skey1 END as person_skey, sale1.person_type from (select * from(select * from (select * from ( select rec_changed,batchtime,part_date,check_id as check_idd,plu_nr,NVL(sales_qty,0) as sale_quantity,NVL(unit_price,0) as item_list_price_amount,NVL(tax_amount,0) as tax_amount,NVL(discount_amount,0) as discount_amount,NVL(discount_value,0) as discount_value,check_detail_id,rec_deleted ,voyageid as voyage_id,row_number() over ( partition by check_detail_id order by rec_changed desc ) rn from shipdw.hvtb_parse_mxp_check_details ) where rn = 1 and rec_deleted=false and rec_changed>='2024-01-20 01:01:01')ck   ) checkD left join ( select * from ( select check_id, account_nr, period_id, sales_time, sales_date, sales_outlet_id, voided_parent, void_reason, check_status, row_number() over ( partition by check_id order by rec_changed desc ) rn from shipdw.hvtb_parse_mxp_checks) chk where rn = 1 and check_status in ('C','V') ) checkS on checkD.check_idd=checkS.check_id join (select * from (select period_code,period_id,rec_deleted, row_number() over ( partition by period_id order by rec_changed desc) rn from shipdw.hvtb_parse_mxp_periods ) a where rn = 1  ) period on checkS.period_id = period.period_id and period.rec_deleted=false left join (select ship_code as ship_code,voyage_number,voyage_skey,cruise_id,src_active_flag,src_deleted_flag from shipdw.hvtb_mart_dim_voyage) voyage_dim on voyage_dim.src_active_flag = true and voyage_dim.src_deleted_flag = false and period.period_code == voyage_dim.voyage_number left join (select sale_detail_skey,sale_id,sale_group_description from shipdw.hvtb_mart_dim_pos_sale_detail ) as sale_detail on checkS.check_id == sale_detail.sale_id left join( select item_plu_type,item_plu_number,item_skey as pos_item_skey from shipdw.hvtb_mart_dim_pos_item ) item on (checkD.plu_nr == item.item_plu_number) left join ( select * from ( select src_active_flag, src_deleted_flag, voyage_number as voyage_number_iti,itinerary_day_date, itinerary_skey , row_number() over(partition by voyage_number, itinerary_day_date order by itinerary_day_date desc ) as rn from shipdw.hvtb_mart_dim_itinerary where src_active_flag == true and src_deleted_flag == false )iti where iti.rn = 1 ) dim_itinerary on (voyage_dim.voyage_number == dim_itinerary.voyage_number_iti and date(sales_date)== date(dim_itinerary.itinerary_day_date)) left join ( select outlet_id, outlet_name, outlet_skey from shipdw.hvtb_mart_dim_outlet ) outlet on (checkS.sales_outlet_id == outlet.outlet_id) left join (select salesoutletid,venueidgo from shipdw.hvtb_mart_lkp_venue) venue_lkp on (venue_lkp.salesoutletid == checkS.sales_outlet_id) left join (select venue_id,venue_skey from shipdw.hvtb_mart_dim_venue )dim_venue on (UPPER(venue_lkp.venueidgo)== UPPER(dim_venue.venue_id) ) left join shipdw.hvtb_mart_dim_date dated on (dated.`date` == date(checkS.sales_date)) left join shipdw.hvtb_nbx_core_time_dim timed on (timed.second_of_day == hour(sales_time)* 60 * 60 + minute(sales_time)* 60 + second(sales_time) ) left join ( select person_account_id, person_id as person_id1,org_unit_id,external_account_id,status_id from ( select status_id,external_account_id,person_account_id, person_id,org_unit_id, row_number() over (partition by person_id,person_account_id,org_unit_id order by last_changed desc) rn from shipdw.hvtb_parse_mxp_person_account)acc_tb where acc_tb.rn = 1) accperson on checkS.account_nr = accperson.person_account_id left join ( select person_id, person_type_id from ( select person_id, person_type_id, rec_deleted, row_number() over (partition by person_id order by last_changed desc) rn from shipdw.hvtb_parse_mxp_persons)person_tb where person_tb.rn = 1 and person_tb.rec_deleted = false) person on accperson.person_id1 = person.person_id left join ( select person_booking_id, person_id, cruise_id, org_unit_id, rec_deleted, arrival_date, departure_date, person_booking_status_id from ( select person_booking_id, person_id, cruise_id, org_unit_id, rec_deleted, arrival_date, departure_date, person_booking_status_id, row_number() over (partition by person_booking_id,cruise_id order by ts_ms desc, last_changed desc) rn from shipdw.hvtb_parse_mxp_person_booking where person_booking_id > 0 and person_booking_status_id not in (0)) person_boking_tb where person_boking_tb.rn = 1 and person_boking_tb.rec_deleted = false) pbooking on (case when person.person_type_id = '1' then voyage_dim.cruise_id = pbooking.cruise_id else DATE(checkS.sales_date) between DATE(pbooking.arrival_date) and DATE(pbooking.departure_date) and accperson.org_unit_id = pbooking.org_unit_id end) and (pbooking.person_id = person.person_id) and pbooking.person_booking_status_id <> 3 left join ( select * from ( select person_booking_ship_code,person_skey as person_skey1, booking_id, person_id, person_type, ts_ms, booking_arrival_date, booking_departure_date, reservationguest_guid, booking_cruise_number, booking_status, row_number () over (partition by booking_id order by ts_ms desc) as rn from shipdw.hvtb_mart_dim_person where booking_id > 0 and booking_status is not null and booking_status not in (0) ) pd where rn = 1 and pd.booking_status <> 3) person_dim on (pbooking.person_booking_id == person_dim.booking_id and cast(person.person_id as string) = person_dim.person_id and voyage_dim.ship_code = person_booking_ship_code) left join (select * from ( select charge_skey, charge_id,person_account_id,src_deleted_flag , row_number() over (partition by person_account_id  order by md5_hash desc) as rn from shipdw.hvtb_mart_dim_charge ) d where rn=1 and src_deleted_flag = false) charge on (charge.person_account_id = accperson.person_account_id and accperson.status_id =3) ) sale1 left join ( select person_skey2, booking_id, person_id as person_id, person_type1, reservationguest_guid, booking_cruise_number, booking_status, booking_departure_date from ( select person_skey as person_skey2, booking_id, person_id, person_type as person_type1 , reservationguest_guid, booking_cruise_number, booking_status, booking_departure_date, row_number () over (partition by person_id order by ts_ms desc) as rn from shipdw.hvtb_mart_dim_person ) pd2 where rn = 1 and person_type1 = '9') person2 on cast(sale1.person_id1 as string) = person2.person_id left join ( select count(*) as guest_count, voyage_number as  voyage_number1, abs(voyage_length) as voyage_length from shipdw.hvtb_mart_dim_voyage voyage inner join shipdw.hvtb_mart_dim_person person on (voyage.voyage_number == person.booking_cruise_number) where person.person_type = '1' and voyage.src_active_flag = true and voyage.src_deleted_flag = false group by voyage_number1, abs(voyage_length))guest_count on (guest_count.voyage_number1 == sale1.voyage_number)) sale2 )  sale3 ) sale4  ) sale where rn=1



