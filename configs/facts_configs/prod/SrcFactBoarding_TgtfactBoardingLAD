spark.source.sql SELECT voyage_id, voyage_skey, person_skey, vxp_reservationguest_id, vxp_reservation_id, vxp_guest_id, boardingnumber_skey, guest_boarding_slot_number, src_last_modified_dt, embark_datetime, checkedin_boarding_number, onboard_boarding_number, seaware_sail_id, seaware_res_id, batchtime, part_date FROM ( SELECT COALESCE(voyage_dim.voyage_skey,-1) AS voyage_skey, voyage_dim.voyage_id AS voyage_id, COALESCE(pd.person_skey,-1) AS person_skey, COALESCE(gbn.reservationguestid,-1) AS vxp_reservationguest_id, rg.reservationid AS vxp_reservation_id, rg.guestid AS vxp_guest_id, COALESCE(bd.boardingnumber_skey,COALESCE(bd1.boardingnumber_skey,-1)) AS boardingnumber_skey, gbn.slotnumber AS guest_boarding_slot_number, gbn.lastmodifieddate AS src_last_modified_dt, gbn.embarkdate AS embark_datetime, gbn.checkedinboardingnumber AS checkedin_boarding_number, gbn.onboardedboardingnumber AS onboard_boarding_number, NVL(seaware_dim.src_sail_id, -1) AS seaware_sail_id, NVL(seaware_dim.src_res_id, -1) AS seaware_res_id, gbn.batchtime, gbn.part_date,gbn.guestboardingnumberid FROM ( SELECT guestboardingnumberid, reservationguestid, slotnumber, lastmodifieddate, embarkdate, checkedinboardingnumber, onboardedboardingnumber, boardingnumber, shipcode, batchtime, part_date FROM ( SELECT guestboardingnumberid, reservationguestid, slotnumber, lastmodifieddate, embarkdate, checkedinboardingnumber, onboardedboardingnumber, boardingnumber, shipcode, batchtime, part_date, ROW_NUMBER() OVER(PARTITION BY guestboardingnumberid ORDER BY lastmodifieddate DESC )AS rn FROM shipdw.hvtb_parse_vxp_guestboardingnumber_lad WHERE isdeleted=FALSE) tmp WHERE tmp.rn = 1) gbn LEFT JOIN ( SELECT reservationguestid, reservationid, guestid FROM ( SELECT reservationguestid, reservationid, guestid, ROW_NUMBER() OVER(PARTITION BY reservationguestid ORDER BY lastmodifieddate DESC ) AS rn FROM vv_db.hvtb_parse_vxp_reservationguest)tmp WHERE tmp.rn = 1) rg ON gbn.reservationguestid = rg.reservationguestid LEFT JOIN ( SELECT * FROM ( SELECT *, row_number ()OVER (PARTITION BY reservationguest_guid ORDER BY coalesce (booking_departure_date, '1900-01-01') DESC, md5_hash DESC) AS rn FROM shipdw.hvtb_mart_dim_person)per WHERE per.rn=1) pd ON pd.reservationguest_guid = rg.reservationguestid LEFT JOIN ( SELECT voyagenumber, reservationid, reservationnumber, fromdate FROM ( SELECT voyagenumber, reservationid, reservationnumber, fromdate, ROW_NUMBER() OVER(PARTITION BY reservationid ORDER BY lastmodifieddate DESC )AS rn FROM vv_db.hvtb_parse_vxp_reservation)tmp WHERE tmp.rn = 1) r ON rg.reservationid = r.reservationid LEFT JOIN ( SELECT voyage_number, voyage_skey, voyage_id FROM shipdw.hvtb_mart_dim_voyage WHERE src_deleted_flag=FALSE AND src_active_flag=TRUE) voyage_dim ON voyage_dim.voyage_number = r.voyagenumber LEFT JOIN ( SELECT boardingnumberid, boardingnumber, slotnumber, shipcode, voyagenumber FROM ( SELECT boardingnumberid, boardingnumber, slotnumber, shipcode, voyagenumber, ROW_NUMBER() OVER(PARTITION BY boardingnumberid ORDER BY lastmodifieddate DESC )AS rn FROM shipdw.hvtb_parse_vxp_boardingnumber WHERE isdeleted=FALSE)tmp WHERE tmp.rn = 1 ) bn ON bn.boardingnumber = gbn.boardingnumber AND bn.slotnumber = gbn.slotnumber AND bn.shipcode = gbn.shipcode AND bn.voyagenumber =r.voyagenumber LEFT JOIN ( SELECT boardingnumberid, boardingnumber, slotnumber, shipcode, voyagenumber, effectivefromdate FROM ( SELECT boardingnumberid, boardingnumber, slotnumber, shipcode, voyagenumber, effectivefromdate, ROW_NUMBER() OVER(PARTITION BY boardingnumberid ORDER BY lastmodifieddate DESC )AS rn FROM shipdw.hvtb_parse_vxp_boardingnumber WHERE isdeleted=FALSE AND voyagenumber is null )tmp WHERE tmp.rn = 1 ) bn1 ON bn1.boardingnumber = gbn.boardingnumber AND bn1.slotnumber = gbn.slotnumber AND bn1.shipcode = gbn.shipcode AND r.fromdate =bn1.effectivefromdate LEFT JOIN shipdw.hvtb_mart_vxp_boardingnumber_dim bd ON bd.boardingnumber_id = bn.boardingnumberid LEFT JOIN shipdw.hvtb_mart_vxp_boardingnumber_dim bd1 ON bd1.boardingnumber_id = bn1.boardingnumberid LEFT JOIN ( SELECT src_res_id, res_id, src_sail_id, rec_end_dttm FROM vv_db.hvtb_nbx_core_sw_reservation_dim WHERE rec_end_dttm='9999-12-31 00:00:00') seaware_dim ON r.reservationnumber=seaware_dim.src_res_id)



