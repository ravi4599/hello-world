spark.source.sql select sh_cab.cabin_number as cabin_number,sh_cab.cabin_id as cabin_id , sh_cab.ship_code as ship, sh_cab.deck_number as deck_number, sh_cab.cabin_name as cabin_name, sh_cab.cabin_rank as cabin_rank, cab_cat.cabin_category as cabin_category, cab_cat.comments as cabin_category_desc, cab_cat.cabin_category_rank as cabin_category_rank, cat_gen.cabin_category_generic, cat_gen.rank as cabin_category_generic_rank, cab_cat.cabin_capacity as cabin_capacity, sh_cab.batchtime as batchtime, current_timestamp as rec_start_dttm,case when sh_cab.op == 'd' then current_timestamp else to_timestamp('9999-12-31 00:00:00') end as rec_end_dttm,sh_cab.part_date as part_date from (select * from (select cabin_number,cabin_id, ship_code, deck_number, cabin_name, cabin_rank, cabin_id,batchtime,op,Part_date,row_number() over(partition by cabin_id order by ts_ms desc,lsn desc) rn from vv_db.hvtb_parse_sw_rpl_ship_cabin) where rn=1) sh_cab left join (select * from (select cabin_number,eff_sail_to,is_active,ship_code,cabin_category,record_id,row_number() over(partition by record_id order by ts_ms desc,lsn desc) rn from vv_db.hvtb_nbx_parse_sw_rpl_ship_cabin_ctg_link) where rn=1) cab_cat_lk on sh_cab.cabin_number = cab_cat_lk.cabin_number and sh_cab.ship_code = cab_cat_lk.ship_code and cab_cat_lk.is_active = 'Y' and cab_cat_lk.eff_sail_to = '2099-12-31 00:00:00' left join (select * from (select cabin_category,cabin_category_id, ship_code,comments,cabin_category_rank,cabin_capacity,is_active,row_number() over(partition by cabin_category_id order by ts_ms desc,lsn desc) rn from vv_db.hvtb_parse_sw_cabin_category) where rn=1) cab_cat on cab_cat.cabin_category = cab_cat_lk.cabin_category and cab_cat.ship_code = cab_cat_lk.ship_code and cab_cat.is_active = 'Y' left join (select * from (select cabin_category,eff_date_to, record_id,ship_code,cabin_category_generic,row_number() over(partition by record_id order by ts_ms desc,lsn desc) rn from vv_db.hvtb_nbx_parse_sw_rpl_cabin_cat_gen_lnk_cabin_cat) where rn=1) cab_cat_gen_lk on cab_cat_gen_lk.cabin_category = cab_cat.cabin_category and cab_cat_gen_lk.ship_code = cab_cat.ship_code and ( cab_cat_gen_lk.eff_date_to )  like '2099%' left join (select * from (select cabin_category_generic,rank,record_id,row_number() over(partition by record_id order by ts_ms desc,lsn desc) rn from vv_db.hvtb_nbx_parse_sw_rpl_cabin_category_generic) where rn=1) cat_gen on cat_gen.cabin_category_generic = cab_cat_gen_lk.cabin_category_generic

