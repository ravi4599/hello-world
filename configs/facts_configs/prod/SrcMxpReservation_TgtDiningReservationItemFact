hen 'closed' else guest_orders.guest_order_status_id end ) as dining_guest_order_status , res.batchtime as batchtime , res.part_date as part_date from ( select * from ( select reservation_id , org_unit_id , reservation_from_date , guid , table_by_meal_id , voyageid , last_changed , batchtime , part_date , row_number() over ( partition by guid order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_reservations *whereclause* ) where rn = 1 ) res left join (select cruise_number, start_date, end_date, org_unit_id, cruise_type, active, deleted, last_changed from (select cruise_number, start_date, end_date, org_unit_id, cruise_type, active, deleted, last_changed, row_number () over (partition by org_unit_id,cruise_number order by last_changed desc) as rn from shipdw.hvtb_parse_mxp_cruise where cruise_type = 'C' and active = 1) where rn = 1) cruise on res.org_unit_id = cruise.org_unit_id inner join ( select * from ( select voyage_skey , voyage_number , voyage_id , voyage_start_date , voyage_end_date , ship_code , upd_dt , row_number() over (partition by voyage_number , ship_code order by upd_dt desc) as rn from shipdw.hvtb_mart_dim_voyage where src_active_flag = true and src_deleted_flag = false ) where rn = 1 ) voyage_dim on voyage_dim.voyage_number = cruise.cruise_number and cast(res.reservation_from_date as date) between cast(voyage_dim.voyage_start_date as date) and cast(voyage_dim.voyage_end_date as date)  left join ( select * from ( select org_unit_id , last_changed , org_unit_abbreviation , row_number() over ( partition by org_unit_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_org_units ) where rn = 1 ) org_units on res.org_unit_id = org_units.org_unit_id left join shipdw.hvtb_mart_dim_dining_reservation_detail detail_dim on upper(res.guid) = upper(detail_dim.dining_reservation_id)  left join ( select * from ( select table_by_meal_id , last_changed , rec_deleted , meals_by_date_id , row_number() over ( partition by table_by_meal_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_tables_by_meals where rec_deleted = 0 ) where rn = 1 ) tables_by_meals on res.table_by_meal_id = tables_by_meals.table_by_meal_id left join ( select * from ( select meals_by_date_id , rec_deleted , menu_id , meal_type_id , last_changed , calender_day_id , meal_to_time , row_number() over (partition by meals_by_date_id,meal_type_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_meals_by_date where rec_deleted = 0 ) where rn = 1 ) meals_by_date on tables_by_meals.meals_by_date_id = meals_by_date.meals_by_date_id left join ( select * from ( select * , row_number() over ( partition by calender_day_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_calender_dates ) where rn = 1 ) cd on meals_by_date.calender_day_id = cd.calender_day_id left join ( select * from ( select table_by_meal_id , last_changed , guest_no , guest_order_status_id , guest_order_id , row_number() over ( partition by guest_order_id,table_by_meal_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_guest_orders ) where rn = 1 ) guest_orders on tables_by_meals.table_by_meal_id = guest_orders.table_by_meal_id left join ( select * from ( select guest_order_detail_id , guest_order_id , last_changed , rec_deleted , status_id , recipe_dish_id , guest_order_placed , guest_order_completed , row_number() over ( partition by guest_order_id,recipe_dish_id order by guest_order_placed desc,last_changed desc ) rn from shipdw.hvtb_parse_mxp_guest_order_detail where rec_deleted = 0 and status_id = 1 ) where rn = 1 ) guest_order_detail on guest_order_detail.guest_order_id = guest_orders.guest_order_id left join ( select * from ( select recipe_dish_id , recipe_dish_code , last_changed , rec_deleted, row_number() over ( partition by recipe_dish_id,recipe_dish_code order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_recipe_dishes where rec_deleted = 0 and recipe_dish_code <> '' ) where rn = 1 ) recipe_dishes on guest_order_detail.recipe_dish_id = recipe_dishes.recipe_dish_id left join ( select * from ( select recipe_dish_id , last_changed , menu_id , rec_deleted , row_number() over ( partition by menu_id,recipe_dish_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_menu_dishes where rec_deleted = 0) where rn = 1 ) menu_dishes on recipe_dishes.recipe_dish_id = menu_dishes.recipe_dish_id and meals_by_date.menu_id = menu_dishes.menu_id left join ( select * from ( select menu_id , last_changed , rec_deleted , guid , row_number() over ( partition by menu_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_menus where rec_deleted = 0) where rn = 1 ) menus on menus.menu_id = menu_dishes.menu_id left join shipdw.hvtb_mart_dim_dining_menu dining_menu_dim on dining_menu_dim.dining_menu_id = menus.guid left join shipdw.hvtb_mart_dim_dining_menu_item dining_menu_item_dim on dining_menu_item_dim.dining_menu_item_code = recipe_dishes.recipe_dish_code and dining_menu_item_dim.src_active_flag = true and dining_menu_item_dim.src_deleted_flag = false left join ( select * from ( select lookup_item_id , last_changed , lookup_item_name , row_number() over ( partition by lookup_item_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_lookup_items ) where rn = 1 ) lookup_items on meals_by_date.meal_type_id = lookup_items.lookup_item_id left join ( select * from ( select table_seat_by_meal_id, table_by_meal_id , last_changed , rec_deleted , seat_no , row_number() over ( partition by table_seat_by_meal_id,table_by_meal_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_table_seats_by_meals where rec_deleted = 0) where rn = 1 ) table_seats_by_meals on table_seats_by_meals.table_by_meal_id = tables_by_meals.table_by_meal_id and guest_orders.guest_no = table_seats_by_meals.seat_no) ) item_fact
