spark.source.sql SELECT * FROM ( SELECT * ,CASE WHEN rts_done_status = true AND UPPER(moci_prevalidstatuscode) = 'APPROVED' THEN 'Green' WHEN rts_done_status = true AND UPPER(moci_prevalidstatuscode) = 'PENDING' THEN 'Yellow' WHEN rts_done_status = true AND UPPER(moci_prevalidstatuscode) = 'REJECTED' THEN 'Red' WHEN rts_done_status = false THEN 'Red' END AS aci_status_color FROM ( SELECT reserve.voyageid AS voyage_id ,NVL(dim_person.person_skey, - 1) AS person_skey ,NVL(dim_voyage.voyage_skey, - 1) AS voyage_skey ,NVL(dim_voyage.ship_code, 'N/A') AS ship_code ,guestdetail.STATUS AS moderation_status ,guestdetail.addeddate AS moderation_addeddate ,guestdetail.verificationstatuscode AS verificationstatuscode ,guestdetail.verificationstatuschangedate AS verificationstatuschangedate ,guestdetail.prevalidatestatuscode AS moci_prevalidstatuscode ,CASE WHEN upper(trim(personstatusrts.statustypecode)) = 'OC' AND upper(personstatusrts.STATUS) = 'COMPLETED' AND personstatusrts.isdeleted = false THEN true ELSE false END AS rts_done_status ,personstatusrts.statuschangeddate AS rts_done_status_datetime ,personstatusbs.STATUS AS boarding_status ,personstatusbs.statuschangeddate AS boarding_status_datetime ,personstatustc.STATUS AS terminal_checkin_status ,CASE WHEN upper(trim(personstatustc.statustypecode)) = 'TC' AND upper(personstatustc.STATUS) = 'COMPLETED' THEN 'Green/Complete' WHEN upper(trim(personstatustc.statustypecode)) = 'TC' AND upper(personstatustc.STATUS) = 'NOT_COMPLETED' THEN 'Yellow/Pending' ELSE 'Red/Pending' END AS terminal_checkin_status_color ,personstatustc.statuschangeddate AS terminal_checkin_status_datetime ,part_date ,batchtime,reserv_guest.reservationguestid FROM ( SELECT * FROM ( SELECT reservationguestid ,reservationid ,row_number() OVER ( PARTITION BY reservationguestid ORDER BY lastmodifieddate DESC ) AS rn FROM shipdw.hvtb_parse_vxp_reservationguest ) guest_reserve WHERE guest_reserve.rn = 1 ) reserv_guest LEFT JOIN ( SELECT * FROM ( SELECT voyagenumber ,reservationnumber ,reservationid ,voyageid ,fromdate ,todate ,shipcode ,part_date ,batchtime ,row_number() OVER ( PARTITION BY reservationid ORDER BY lastmodifieddate DESC ) AS rn FROM shipdw.hvtb_parse_vxp_reservation ) rese WHERE rese.rn = 1 ) reserve ON (reserve.reservationid = reserv_guest.reservationid) LEFT JOIN ( SELECT ship_code ,voyage_number ,voyage_skey ,voyage_start_date ,voyage_end_date FROM shipdw.hvtb_mart_dim_voyage WHERE src_active_flag = true AND src_deleted_flag = false ) dim_voyage ON (((date(dim_voyage.voyage_start_date) = reserve.fromdate) and (date(dim_voyage.voyage_end_date) = reserve.todate)) and dim_voyage.ship_code = reserve.shipcode) LEFT JOIN ( SELECT * FROM ( SELECT prevalidatestatuscode ,verificationstatuschangedate ,verificationstatuscode ,addeddate ,STATUS ,isdeleted ,reservationguestid ,row_number() OVER ( PARTITION BY reservationguestid ORDER BY lastmodifieddate DESC ) AS rn FROM shipdw.hvtb_parse_vxp_guestmoderationdetail WHERE isdeleted <> true ) gmod WHERE gmod.rn = 1 ) guestdetail ON (upper(guestdetail.reservationguestid) = upper(reserv_guest.reservationguestid)) LEFT JOIN ( SELECT * FROM ( SELECT person_skey ,reservationguest_guid ,row_number() OVER ( PARTITION BY reservationguest_guid ORDER BY upd_dt DESC ,md5_hash DESC ) AS rn FROM shipdw.hvtb_mart_dim_person ) p WHERE p.rn = 1 ) dim_person ON (upper(reserv_guest.reservationguestid) = upper(dim_person.reservationguest_guid)) LEFT JOIN ( SELECT * FROM ( SELECT statustypecode ,STATUS ,isdeleted ,personid ,row_number() OVER ( PARTITION BY personid ORDER BY lastmodifieddate DESC ) AS rn FROM shipdw.hvtb_parse_vxp_personstatus WHERE isdeleted <> true ) person_status WHERE person_status.rn = 1 ) personstatus ON (upper(personstatus.personid) = upper(reserv_guest.reservationguestid)) LEFT JOIN ( SELECT * FROM ( SELECT statustypecode ,STATUS ,isdeleted ,statuschangeddate ,personid ,row_number() OVER ( PARTITION BY personid ORDER BY lastmodifieddate DESC ) AS rn FROM shipdw.hvtb_parse_vxp_personstatus WHERE upper(trim(statustypecode)) = 'BS' AND isdeleted <> true ) person_status WHERE person_status.rn = 1 ) personstatusbs ON (upper(personstatusbs.personid) = upper(reserv_guest.reservationguestid)) LEFT JOIN ( SELECT * FROM ( SELECT statustypecode ,STATUS ,statuschangeddate ,isdeleted ,personid ,row_number() OVER ( PARTITION BY personid ORDER BY lastmodifieddate DESC ) AS rn FROM shipdw.hvtb_parse_vxp_personstatus WHERE upper(trim(statustypecode)) = 'OC' AND isdeleted <> true ) person_status WHERE person_status.rn = 1 ) personstatusrts ON (upper(personstatusrts.personid) = upper(reserv_guest.reservationguestid)) LEFT JOIN ( SELECT * FROM ( SELECT statustypecode ,STATUS ,isdeleted ,statuschangeddate ,personid ,row_number() OVER ( PARTITION BY personid ORDER BY lastmodifieddate DESC ) AS rn FROM shipdw.hvtb_parse_vxp_personstatus WHERE upper(trim(statustypecode)) = 'TC' AND isdeleted <> true ) person_status WHERE person_status.rn = 1 ) personstatustc ON (upper(personstatustc.personid) = upper(reserv_guest.reservationguestid)) ) person_status_fact ) ps


