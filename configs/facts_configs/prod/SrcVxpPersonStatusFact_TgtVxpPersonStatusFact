n by personid, statustypecode order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_personstatus where upper(trim(statustypecode)) = 'OC' and isdeleted <> true)person_status where person_status.rn = 1 )personstatusrts on (upper(personstatusrts.personid) = upper(reserv_guest.reservationguestid)) left join ( select * from ( select statustypecode, status, isdeleted, statuschangeddate, personid, row_number() over (partition by personid, statustypecode order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_personstatus where upper(trim(statustypecode)) = 'TC' and isdeleted <> true)person_status where person_status.rn = 1 )personstatustc on (upper(personstatustc.personid) = upper(reserv_guest.reservationguestid)))p)p *whereclause*

