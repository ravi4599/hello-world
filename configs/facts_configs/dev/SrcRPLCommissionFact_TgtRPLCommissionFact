spark.source.sql with RES_COMMISSION as ( SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, NULL AS charge_id, 'N' AS is_cancelled, `percent`, amount, invoice_item_type, commiss_fare, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id FROM vv_db.hvtb_nbx_landing_sw_rpl_res_commission_detail UNION SELECT res_commiss_detail_id, res_package_id, guest_id, res_id, commiss_source, commiss_code, NULL AS charge_id, 'Y' AS is_cancelled, `percent`, amount, invoice_item_type, commiss_fare, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id FROM vv_db.hvtb_nbx_landing_sw_rpl_res_commission_cancel UNION SELECT record_id, NULL AS res_package_id, g.guest_id AS guest_id, entity_id AS res_id, commiss_source, commiss_code, charge_id, 'N' AS is_cancelled, `percent`, amount, NULL AS invoice_item_type, commiss_fare, is_manual_adjustment, amount_in_hdr_curr, agency_id, payout_date, gl_prototype_id FROM vv_db.hvtb_nbx_landing_sw_rpl_res_charge_commission c LEFT JOIN vv_db.hvtb_nbx_landing_sw_rpl_res_guest g ON c.entity_id = g.res_id AND g.guest_seqn =1 WHERE entity_type='RES') select snapshot_date, res_id,guest_id,package_id,invoice_item_type_id,ship_id,agency_id,sail_id,currency_code,currency_rate,commission_type_skey,currency_rate,commission_type_skey,charge_id, is_cancelled, commission_percent, commission_amount, commission_fare, commission_payout_date, COALESCE(base_commission_voyagefare_regular,0.0) as base_commission_voyagefare_regular, COALESCE(base_commission_voyagefare_protected,0.0) as base_commission_voyagefare_protected, COALESCE(base_commission_voyagefare_manual,0.0) as base_commission_voyagefare_manual, COALESCE(base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual,0.0 )as base_commission_voyagefare, COALESCE(base_commission_taxesandfees_regular,0.0) as base_commission_taxesandfees_regular, COALESCE(base_commission_taxesandfees_protected,0.0) as base_commission_taxesandfees_protected, COALESCE(base_commission_taxesandfees_manual,0.0) as base_commission_taxesandfees_manual, COALESCE(base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual,0.0) as base_commission_taxesandfees, COALESCE(base_commission_shorex_regular,0.0) as base_commission_shorex_regular, COALESCE(base_commission_shorex_protected,0.0) as base_commission_shorex_protected, COALESCE(base_commission_shorex_manual,0.0) as base_commission_shorex_manual, COALESCE(base_commission_shorex_regular + base_commission_shorex_protected + base_commission_shorex_manual,0.0) as base_commission_shorex, COALESCE(base_commission_sailorloot_regular,0.0) as base_commission_sailorloot_regular, COALESCE(base_commission_sailorloot_protected,0.0) as base_commission_sailorloot_protected, COALESCE(base_commission_sailorloot_manual,0.0) as base_commission_sailorloot_manual, COALESCE(base_commission_sailorloot_regular + base_commission_sailorloot_protected + base_commission_sailorloot_manual,0.0) as base_commission_sailorloot, COALESCE(base_commission_hotelfare_regular,0.0) as base_commission_hotelfare_regular, COALESCE(base_commission_hotelfare_protected,0.0) as base_commission_hotelfare_protected, COALESCE(base_commission_hotelfare_manual,0.0) as base_commission_hotelfare_manual, COALESCE(base_commission_hotelfare_regular + base_commission_hotelfare_protected + base_commission_hotelfare_manual,0.0) as base_commission_hotelfare, COALESCE(base_commission_insurance_regular,0.0) as base_commission_insurance_regular, COALESCE(base_commission_insurance_protected,0.0) as base_commission_insurance_regular, COALESCE(base_commission_insurance_regular + base_commission_insurance_protected,0.0) as base_commission_insurance, COALESCE(bonus_commission_voyagefare_regular,0.0) as bonus_commission_voyagefare_regular, COALESCE(bonus_commission_voyagefare_protected,0.0) as bonus_commission_voyagefare_protected, COALESCE(bonus_commission_voyagefare_manual,0.0) as bonus_commission_voyagefare_manual, COALESCE(bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual,0.0) as bonus_commission, COALESCE((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual),0.0) as voyagefare_commission, COALESCE(gsa_commission_voyagefare,0.0) as gsa_commission_voyagefare, COALESCE(gsa_commission_taxesandfees,0.0) as gsa_commission_taxesandfees, COALESCE(gsa_commission_insurance,0.0) as gsa_commission_insurance, COALESCE(gsa_commission_shorex,0.0) as gsa_commission_shorex, COALESCE(gsa_commission_sailorloot,0.0) as gsa_commission_sailorloot, COALESCE(((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual) + (base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual)),0.0) as protected_commission, COALESCE(((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual)),0.0) as base_protected_commission, COALESCE(base_commission_other_bookable,0.0) as base_commission_other_bookable, COALESCE(base_commission_voyagefare_regular * currency_rate,0.0) as base_commission_voyagefare_regular_usd, COALESCE(base_commission_voyagefare_protected * currency_rate,0.0) as base_commission_voyagefare_protected_usd, COALESCE(base_commission_voyagefare_manual * currency_rate,0.0) as base_commission_voyagefare_manual_usd, COALESCE((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual),0.0) * currency_rate as base_commission_voyagefare_usd, COALESCE(base_commission_taxesandfees_regular,0.0) * currency_rate as base_commission_taxesandfees_regular_usd, COALESCE(base_commission_taxesandfees_protected,0.0) * currency_rate as base_commission_taxesandfees_protected_usd, COALESCE(base_commission_taxesandfees_manual,0.0) * currency_rate as base_commission_taxesandfees_manual_usd, COALESCE((base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual),0.0) * currency_rate as base_commission_taxesandfees_usd, COALESCE(base_commission_shorex_regular,0.0) * currency_rate as base_commission_shorex_regular_usd, COALESCE(base_commission_shorex_protected,0.0) * currency_rate as base_commission_shorex_protected_usd, COALESCE(base_commission_shorex_manual,0.0) * currency_rate as base_commission_shorex_manual_usd, COALESCE((base_commission_shorex_regular + base_commission_shorex_protected + base_commission_shorex_manual),0.0) * currency_rate as base_commission_shorex_usd, COALESCE(base_commission_sailorloot_regular,0.0) * currency_rate as base_commission_sailorloot_regular_usd, COALESCE(base_commission_sailorloot_protected,0.0) * currency_rate as base_commission_sailorloot_protected_usd, COALESCE(base_commission_sailorloot_manual,0.0) * currency_rate as base_commission_sailorloot_manual_usd, COALESCE((base_commission_sailorloot_regular + base_commission_sailorloot_protected + base_commission_sailorloot_manual),0.0) * currency_rate as base_commission_sailorloot_usd, COALESCE(base_commission_hotelfare_regular,0.0) * currency_rate as base_commission_hotelfare_regular_usd, COALESCE(base_commission_hotelfare_protected,0.0) * currency_rate as base_commission_hotelfare_protected_usd, COALESCE(base_commission_hotelfare_manual,0.0) * currency_rate as base_commission_hotelfare_manual_usd, COALESCE((base_commission_hotelfare_regular + base_commission_hotelfare_protected + base_commission_hotelfare_manual),0.0) * currency_rate as base_commission_hotelfare_usd, COALESCE(base_commission_insurance_regular,0.0) * currency_rate as base_commission_insurance_regular_usd, COALESCE(base_commission_insurance_protected,0.0) * currency_rate as base_commission_insurance_protected_usd, COALESCE((base_commission_insurance_regular + base_commission_insurance_protected),0.0) * currency_rate as base_commission_insurance_usd, COALESCE(bonus_commission_voyagefare_regular,0.0) * currency_rate as bonus_commission_voyagefare_regular_usd, COALESCE(bonus_commission_voyagefare_protected,0.0) * currency_rate as bonus_commission_voyagefare_protected_usd, COALESCE(bonus_commission_voyagefare_manual,0.0) * currency_rate as bonus_commission_voyagefare_manual_usd, COALESCE((bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual),0.0) * currency_rate as bonus_commission_usd, COALESCE((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual) * currency_rate,0.0) as voyagefare_commission_usd, COALESCE(gsa_commission_voyagefare,0.0) * currency_rate as gsa_commission_voyagefare_usd, COALESCE(gsa_commission_taxesandfees,0.0) * currency_rate as gsa_commission_taxesandfees_usd, COALESCE(gsa_commission_insurance,0.0) * currency_rate as gsa_commission_insurance_usd, COALESCE(gsa_commission_shorex,0.0) * currency_rate as gsa_commission_shorex_usd, COALESCE(gsa_commission_sailorloot,0.0) * currency_rate as gsa_commission_sailorloot_usd, COALESCE(((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (bonus_commission_voyagefare_regular + bonus_commission_voyagefare_protected + bonus_commission_voyagefare_manual) + (base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual)),0.0) * currency_rate as protected_commission_usd, COALESCE(((base_commission_voyagefare_regular + base_commission_voyagefare_protected + base_commission_voyagefare_manual) + (base_commission_taxesandfees_regular + base_commission_taxesandfees_protected + base_commission_taxesandfees_manual)),0.0) * currency_rate as base_protected_commission_usd, COALESCE(base_commission_other_bookable,0.0) * currency_rate as base_commission_other_bookable_usd from ( SELECT CURRENT_DATE() AS snapshot_date, COALESCE(rd.res_id,-1) AS res_id, COALESCE(gd.guest_id,-1) AS guest_id, COALESCE ( CASE WHEN pd.package_id IS NULL THEN seaware_package_dim_voy.package_id ELSE pd.package_id END ,- 1) AS package_id, COALESCE(invlkp.invoice_item_type_id,-1) AS invoice_item_type_id, COALESCE(sd.ship_id,-1) AS ship_id, COALESCE(agency.agency_id,-1) AS agency_id, COALESCE(sld.sail_id,-1) AS sail_id, COALESCE(reshr.currency_code,'USD') AS currency_code, COALESCE(reshr.currency_rate,1) AS currency_rate, COALESCE(commlkp.commission_type_id,-1) AS commission_type_skey, comm.charge_id AS charge_id, comm.is_cancelled AS is_cancelled, COALESCE(comm.`percent`,0) AS commission_percent, comm.`amount` AS commission_amount, comm.commiss_fare AS commission_fare, comm.payout_date AS commission_payout_date, if(invlkp.invoice_item_type='VOYAGE FARE' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source not in ('PROTECTED','MANUAL') ,comm.amount,0) as base_commission_voyagefare_regular, if(invlkp.invoice_item_type='VOYAGE FARE' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source = 'PROTECTED',comm.amount,0) as base_commission_voyagefare_protected, if(invlkp.invoice_item_type='VOYAGE FARE' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source ='MANUAL' ,comm.amount,0) as base_commission_voyagefare_manual, if(invlkp.invoice_item_type='TAXES & FEES' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source not in ('PROTECTED','MANUAL') ,comm.amount,0) as base_commission_taxesandfees_regular, if(invlkp.invoice_item_type='TAXES & FEES' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source = 'PROTECTED',comm.amount,0) as base_commission_taxesandfees_protected, if(invlkp.invoice_item_type='TAXES & FEES' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source ='MANUAL' ,comm.amount,0) as base_commission_taxesandfees_manual, if(invlkp.invoice_item_type='SHORE THINGS' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source not in ('PROTECTED','MANUAL') ,comm.amount,0) as base_commission_shorex_regular, if(invlkp.invoice_item_type='SHORE THINGS' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source = 'PROTECTED',comm.amount,0) as base_commission_shorex_protected, if(invlkp.invoice_item_type='SHORE THINGS' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source ='MANUAL' ,comm.amount,0) as base_commission_shorex_manual, if(invlkp.invoice_item_type in ('SAILOR LOOT','SAILOR LOOT +') and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source not in ('PROTECTED','MANUAL') ,comm.amount,0) as base_commission_sailorloot_regular, if(invlkp.invoice_item_type in ('SAILOR LOOT','SAILOR LOOT +') and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source = 'PROTECTED',comm.amount,0) as base_commission_sailorloot_protected, if(invlkp.invoice_item_type in ('SAILOR LOOT','SAILOR LOOT +') and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source ='MANUAL' ,comm.amount,0) as base_commission_sailorloot_manual, if(invlkp.invoice_item_type='HOTEL FARE' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source not in ('PROTECTED','MANUAL') ,comm.amount,0) as base_commission_hotelfare_regular, if(invlkp.invoice_item_type='HOTEL FARE' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source = 'PROTECTED',comm.amount,0) as base_commission_hotelfare_protected, if(invlkp.invoice_item_type='HOTEL FARE' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source ='MANUAL' ,comm.amount,0) as base_commission_hotelfare_manual, if(invlkp.invoice_item_type='INSURANCE' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source not in ('PROTECTED','MANUAL') ,comm.amount,0) as base_commission_insurance_regular, if(invlkp.invoice_item_type='INSURANCE' and comm.commiss_code in ('STANDARD', 'SECONDARY') and commiss_source = 'PROTECTED',comm.amount,0) as base_commission_insurance_protected, if(invlkp.invoice_item_type='VOYAGE FARE' and comm.commiss_code ='BONUS' and commiss_source not in ('PROTECTED','MANUAL') ,comm.amount,0) as bonus_commission_voyagefare_regular, if(invlkp.invoice_item_type='VOYAGE FARE' and comm.commiss_code ='BONUS' and commiss_source = 'PROTECTED',comm.amount,0) as bonus_commission_voyagefare_protected, if(invlkp.invoice_item_type='VOYAGE FARE' and comm.commiss_code ='BONUS' and commiss_source ='MANUAL' ,comm.amount,0) as bonus_commission_voyagefare_manual, CASE WHEN comm.commiss_source = 'GSA, BOOKING, VOYAGE FARE' THEN comm.`amount` ELSE 0 END AS gsa_commission_voyagefare, CASE WHEN comm.commiss_source = 'GSA, BOOKING, TAXES & FEES' THEN comm.`amount` ELSE 0 END AS gsa_commission_taxesandfees, CASE WHEN comm.commiss_source = 'GSA, BOOKING, INSURANCE' THEN comm.`amount` ELSE 0 END AS gsa_commission_insurance, CASE WHEN comm.commiss_source = 'GSA, BOOKING, SHORE THINGS' THEN comm.`amount` ELSE 0 END AS gsa_commission_shorex, CASE WHEN comm.commiss_source IN ('GSA, BOOKING, SAILOR LOOT', 'GSA, BOOKING, SAILOR LOOT +') THEN comm.`amount` ELSE 0 END AS gsa_commission_sailorloot, if( upper(invlkp.invoice_item_type) in ('VOYAGE FARE','TAXES & FEES','INSURANCE') , 0 , comm.`amount` ) as base_commission_other_bookable, COALESCE(Agent.agent_id,-1) AS agent_id, COALESCE(addon_lkp.addon_id,- 1) AS addon_id FROM RES_COMMISSION AS comm LEFT JOIN ( SELECT res_id, src_res_id FROM vv_db.hvtb_nbx_core_sw_reservation_dim rd WHERE to_date(rec_end_dttm) = '9999-12-31') rd ON comm.res_id = rd.src_res_id LEFT JOIN ( SELECT guest_id, src_guest_id FROM vv_db.hvtb_nbx_core_sw_guest_dim gd WHERE to_date(rec_end_dttm) = '9999-12-31') gd ON comm.guest_id = gd.src_guest_id LEFT JOIN vv_db.hvtb_nbx_core_sw_invoice_item_type_lkp invlkp ON comm.invoice_item_type = invlkp.invoice_item_type AND invlkp.invoice_item_subtype IS NULL LEFT JOIN ( SELECT ship_code, res_id, dep_ref_id, arr_ref_id, currency_rate, currency_code, agency_id, CASE WHEN sec_agent_id IS NULL THEN agent_id ELSE sec_agent_id END AS agent_id FROM vv_db.hvtb_nbx_landing_sw_rpl_res_header reshr GROUP BY ship_code, res_id, dep_ref_id, arr_ref_id, currency_rate, currency_code, agency_id, CASE WHEN sec_agent_id IS NULL THEN agent_id ELSE sec_agent_id END ) reshr ON comm.res_id = reshr.res_id LEFT JOIN ( SELECT ship, ship_id FROM vv_db.hvtb_nbx_core_sw_ship_dim sd GROUP BY ship, ship_id) sd ON reshr.ship_code = sd.ship LEFT JOIN ( SELECT seaware_agencyid__c, seaware_agent_id__c, agent_id FROM vv_db.hvtb_nbx_core_crm_agent_master_dim Agent WHERE to_date(Agent.rec_end_dttm) = '9999-12-31' GROUP BY seaware_agencyid__c, seaware_agent_id__c, agent_id) Agent ON reshr.agent_id = Agent.seaware_agent_id__c LEFT JOIN ( SELECT src_agency_id, agency_id FROM vv_db.hvtb_nbx_core_sw_agency_dim WHERE to_date(rec_end_dttm) = '9999-12-31' GROUP BY src_agency_id, agency_id)Agency ON reshr.agency_id = Agency.src_agency_id LEFT JOIN ( SELECT sail_id, dep_ref_id, arr_ref_id FROM vv_db.hvtb_nbx_landing_sw_rpl_sail_header sh) sh ON reshr.dep_ref_id = sh.dep_ref_id AND reshr.arr_ref_id = sh.arr_ref_id LEFT JOIN ( SELECT sail_id, src_sail_id FROM vv_db.hvtb_nbx_core_sw_sail_dim sld WHERE to_date(rec_end_dttm) = '9999-12-31' GROUP BY sail_id, src_sail_id) sld ON sh.sail_id = sld.src_sail_id LEFT JOIN vv_db.hvtb_nbx_core_swrpl_commission_type_lkp commlkp ON comm.commiss_source = commlkp.commission_source AND comm.commiss_code = commlkp.commission_code LEFT JOIN ( SELECT res_package_id, package_id, res_addon_id FROM vv_db.hvtb_nbx_landing_sw_rpl_res_package respk GROUP BY res_package_id, package_id, res_addon_id) respk ON comm.res_package_id = respk.res_package_id LEFT JOIN ( SELECT package_id, src_package_id FROM vv_db.hvtb_nbx_core_sw_package_dim pd WHERE to_date(rec_end_dttm) = '9999-12-31' AND src_package_id IS NOT NULL GROUP BY package_id, src_package_id) pd ON respk.package_id = CAST(pd.src_package_id AS INT) LEFT JOIN ( SELECT res_id, guest_id, package_id FROM vv_db.hvtb_nbx_landing_sw_rpl_res_package res_package_voy WHERE package_class = 'VOYAGE' GROUP BY res_id, guest_id, package_id)res_package_voy ON comm.res_id = res_package_voy.res_id AND comm.guest_id = res_package_voy.guest_id LEFT JOIN ( SELECT package_id, src_package_id FROM vv_db.hvtb_nbx_core_sw_package_dim seaware_package_dim_voy WHERE to_date(rec_end_dttm) = '9999-12-31' AND src_package_id IS NOT NULL GROUP BY package_id, src_package_id) seaware_package_dim_voy ON seaware_package_dim_voy.src_package_id = res_package_voy.package_id LEFT JOIN ( SELECT res_addon_id, res_addon_code FROM vv_db.hvtb_nbx_landing_sw_rpl_res_addon) ra ON respk.res_addon_id = ra.res_addon_id LEFT JOIN ( SELECT amenity_code, am_category, amenity_type, amenity_name FROM vv_db.hvtb_nbx_landing_sw_rpl_am_code) am ON ra.res_addon_code = am.amenity_code LEFT JOIN ( SELECT addon_id, res_addon_code, addon_category, addon_type, addon_name FROM vv_db.hvtb_nbx_core_sw_addon_lkp) addon_lkp ON COALESCE(addon_lkp.res_addon_code,'~') = COALESCE(am.amenity_code,'~') AND COALESCE(addon_lkp.addon_category,'~') = COALESCE(am.am_category,'~') AND COALESCE(addon_lkp.addon_type,'~') = COALESCE(am.amenity_type,'~') AND COALESCE(addon_lkp.addon_name,'~') = COALESCE(am.amenity_name,'~'))

