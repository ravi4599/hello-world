spark.source.sql SELECT nvl(pbooking.VoyageId, -1) AS voyage_id , nvl(persondim.person_skey, -1) AS person_skey , nvl(positiondim.position_skey, -1) AS position_skey , nvl(sg.supervisor_group_skey, -1) AS supervisor_group_skey , pos.position_valid_from_timestamp AS position_valid_from_timestamp , pos.position_valid_to_timestamp AS position_valid_to_timestamp , pbooking.rec_deleted AS src_deleted_flag,pbooking.batchtime,pbooking.part_date FROM ( select Distinct * from ( SELECT person_booking_id , position_id , supervisor_group_id , voyageid , rec_deleted,batchtime , part_date,ROW_NUMBER() OVER ( PARTITION BY person_booking_id, position_id ORDER BY last_changed DESC ) AS rn FROM shipdw.hvtb_parse_mxp_person_booking)where rn =1) pbooking LEFT JOIN ( SELECT DISTINCT * FROM ( SELECT person_skey , booking_id, voyage_id, upd_dt, md5_hash, ROW_NUMBER() OVER(PARTITION BY booking_id ORDER BY upd_dt, md5_hash DESC ) AS rn FROM shipdw.hvtb_mart_dim_person ) WHERE rn = 1) persondim ON pbooking.person_booking_id = persondim.booking_id LEFT JOIN ( SELECT DISTINCT * FROM ( SELECT position_skey , position_id, voyage_id, load_dt, upd_dt, md5_hash, ROW_NUMBER() OVER(PARTITION BY position_id ORDER BY upd_dt, md5_hash DESC) AS rn FROM shipdw.hvtb_mart_dim_position ) WHERE rn = 1) positiondim ON pbooking.position_id = positiondim.position_id LEFT JOIN ( SELECT DISTINCT * FROM ( SELECT voyage_id, supervisor_group_skey, supervisor_group_id, upd_dt, md5_hash, ROW_NUMBER() OVER(PARTITION BY supervisor_group_id ORDER BY upd_dt, md5_hash DESC) AS rn FROM shipdw.hvtb_mart_dim_supervisor_group WHERE src_deleted_flag = FALSE ) WHERE rn = 1) sg ON sg.supervisor_group_id = pbooking.supervisor_group_id LEFT JOIN ( SELECT DISTINCT * FROM ( SELECT position_id , position_valid_from AS position_valid_from_timestamp , position_valid_to AS position_valid_to_timestamp ,batchtime , part_date , ROW_NUMBER() OVER ( PARTITION BY position_id ORDER BY last_changed DESC ) AS rn FROM shipdw.hvtb_parse_mxp_positions ) WHERE rn = 1 ) pos ON positiondim.position_id = pos.position_id

spark.source.columns person_skey, position_skey,supervisor_group_skey, position_valid_from_timestamp, position_valid_to_timestamp,src_deleted_flag, batchtime

spark.pond.allColumns   person_skey as pond_person_skey, position_skey as pond_position_skey, supervisor_group_skey as pond_supervisor_group_skey,position_valid_from_timestamp as pond_position_valid_from_timestamp, position_valid_to_timestamp as pond_position_valid_to_timestamp, src_deleted_flag as pond_src_deleted_flag,load_dt as pond_load_dt, upd_dt as pond_upd_dt,primaryhash as pond_primaryhash, md5_hash as pond_md5_hash,part_dt as pond_part_dt

