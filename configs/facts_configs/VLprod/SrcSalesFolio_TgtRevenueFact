spark.source.sql SELECT *,-1 as device_skey,0 as time_on_device_seconds,0 as avg_wager_amount,0 as casino_game_dph,0 as theoritical_winnings ,-1 as activity_skey, NVL((((debit_amount-credit_amount)* sale_quantity)-discount_amount),0) as total_collected_sales_amount, NVL((((debit_amount-credit_amount)* sale_quantity)-discount_amount)/(guest_count*voyage_length),0) as total_collected_sales_ap, NVL((((debit_amount-credit_amount)* sale_quantity)-discount_amount),0) as total_shared_revenue_amount , NVL((((debit_amount-credit_amount)* sale_quantity)-discount_amount)/(guest_count*voyage_length),0) as total_shared_revenue_ap  from   ( SELECT   'FOLIO' as source_type, cruisenbr as voyage_id,   NVL(sale_detail_skey, -1) as sale_detail_skey, -1 as pos_item_skey,  NVL(dim_voyage.voyage_skey,-1) as voyage_skey,  dim_voyage.ship_code as ship_code,  NVL(folio_item_skey, -1)as folio_item_skey, NVL(person_skey, -1) as person_skey,  NVL(itinerary_skey, -1)itinerary_skey, -1 as outlet_skey, NVL(dd.date_id, -1) as sale_date_skey,  NVL(time_skey, -1) as sale_time_skey, quantity as sale_quantity, 0 as item_list_price_amount,   NVL(creditamount, 0) as credit_amount,   NVL(debitamount, 0) as debit_amount, 0 as tax_amount,  NVL(discountamount, 0) as discount_amount, 0 as discount_value, 0 as cost_of_goods,   CASE when (UPPER(person_dim.person_type)=='COMPANY ACCOUNT')   THEN NVL((((NVL(debitamount, 0)-NVL(creditamount, 0)-NVL(discountamount, 0))* quantity)),0) ELSE 0  end as manual_adjustment_amount,   NVL(guest_count.voyage_length, 0) as voyage_length, NVL(guest_count, 0) as guest_count,  external_reference as booking_reference_number,  batchtime, part_date from   shipdw.hvtb_parse_folio_vperson_account_detail as accnt_detail    inner join  shipdw.hvtb_mart_lkp_revenue_category_rel revenue_rel   on(   category_type='FOLIO_QUICKCODE'and accnt_detail.quickcode==revenue_rel.category_value     )  left join shipdw.hvtb_mart_dim_sale_detail sale_detail  on ( accnt_detail.referencenbr == sale_detail.sale_id)  left join shipdw.hvtb_mart_dim_folio_item folio_item   on (accnt_detail.quickcode = folio_item.folio_item_quickcode)  left join  shipdw.hvtb_mart_dim_voyage dim_voyage  on(dim_voyage.src_active_flag=TRUE and dim_voyage.src_deleted_flag=FALSE and accnt_detail.cruisenbr == dim_voyage.voyage_number)  left join shipdw.hvtb_mart_dim_person person_dim on   (accnt_detail.cruisenbr==person_dim.booking_cruise_number and accnt_detail.person_id = person_dim.person_id )   left join shipdw.hvtb_mart_dim_date dd on date(accnt_detail.businessday) = dd.`date`   left join shipdw.hvtb_nbx_core_time_dim dt on dt.second_of_day = hour(accnt_detail.businessday)* 60 * 60 + minute(accnt_detail.businessday)* 60 + second(accnt_detail.businessday)   left join shipdw.hvtb_mart_dim_itinerary as itinerary   on (  itinerary.src_active_flag=True and itinerary.src_deleted_flag=False and itinerary.voyage_number == accnt_detail.cruisenbr and date(accnt_detail.businessday) == date(itinerary.itinerary_day_date) )  left join (  select count(*) as guest_count, voyage_number ,abs(voyage_length) as voyage_length  from shipdw.hvtb_mart_dim_voyage voyage inner join shipdw.hvtb_mart_dim_person person on (voyage.voyage_number==person.booking_cruise_number) where person_type='1'  group by voyage_number,abs(voyage_length))guest_count  on (guest_count.voyage_number==accnt_detail.cruisenbr)   *whereclause*  )FOLIO_FACT
