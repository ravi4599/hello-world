spark.source.sql select COALESCE (CASE WHEN booking.persontypecode in ('G', 'RG') THEN dim_person_id.person_skey WHEN booking.persontypecode = 'C' THEN dim_team_person_id.person_skey ELSE NULL END,-1) as person_skey, COALESCE (CASE WHEN booking.bookedbypersontypecode in ('G', 'RG') THEN dim_bookedby_id.person_skey WHEN booking.bookedbypersontypecode = 'C' THEN dim_team_bookedby_id.person_skey ELSE NULL END,-1) as booked_by_person_skey, COALESCE (CASE WHEN booking.payeepersontypecode in ('G', 'RG') THEN dim_paid_by_id.person_skey WHEN booking.payeepersontypecode = 'C' THEN dim_team_paidby_id.person_skey ELSE NULL END,-1) as paid_by_person_skey, COALESCE (CASE WHEN booking.cancelledbypersontypecode in ('G', 'RG') THEN dim_cancelled_by_id.person_skey WHEN booking.cancelledbypersontypecode = 'C' THEN dim_team_cancelled_by_id.person_skey ELSE NULL END,-1) as cancelled_by_person_skey, booking.voyage_id,booking.booking_detail_skey,booking.voyage_skey,booking.activity_skey,booking.activity_slot_skey,booking.vendor_skey,booking.sale_detail_skey,booking.itinerary_skey,booking.venue_skey,booking.ship_code,booking.number_of_people,booking.booking_paid_amount,booking.booking_remaining_amount,booking.refund_paid_amount,booking.refund_remaining_amount,booking.start_date_time,booking.end_date_time,booking.start_date_skey,booking.start_time_skey,booking.checked_in_flag,booking.booked_date_time,booking.canceled_date_time,booking.src_deleted_flag,booking.batchtime,booking.part_date,activitybookingid  from (select booking_fact.*,NVL(dim_itinerary.itinerary_skey,-1) as itinerary_skey  from   (select ars_booking.activitybookingid,ars_booking.voyagenumber, NVL(dim_booking_detail.booking_detail_skey,-1) as booking_detail_skey,NVL(dim_voyage.voyage_skey,-1) as voyage_skey,  NVL(dim_activity.activity_skey,-1) as activity_skey,   NVL(dim_activity_slot.activity_slot_skey,-1) as activity_slot_skey,   NVL(dim_vendor.vendor_skey,-1) as vendor_skey,   NVL(dim_sale_detail.sale_detail_skey,-1) as sale_detail_skey,   NVL(dim_voyage.ship_code,'N/A') as ship_code,   num_count.number_of_people as number_of_people, ars_booking.bookingamountpaid as booking_paid_amount, ars_booking.bookingamountpending as booking_remaining_amount, ars_booking.refundamountpaid as refund_paid_amount, ars_booking.refundamountpending as refund_remaining_amount, ars_booking.startdatetime as start_date_time, ars_booking.enddatetime as end_date_time, ars_booking.addeddate as booked_date_time, NVL(timed.time_skey,-1)as start_time_skey, NVL(dated.date_id,-1) as start_date_skey, case when lower(ars_booking.status) = 'cancelled' then ars_booking.lastmodifieddate else null end as canceled_date_time, activitypersonbooking.isdeleted as src_deleted_flag, activitypersonbooking.ischeckedin as checked_in_flag, NVL(dim_venue.venue_skey,-1) as venue_skey, activitypersonbooking.personid , activitypersonbooking.persontypecode, ars_booking.bookedbypersonid , ars_booking.bookedbypersontypecode, ars_booking.payeepersonid , ars_booking.payeepersontypecode, ars_booking.cancelledbypersonid , ars_booking.cancelledbypersontypecode,  ars_booking.VoyageId as voyage_id,ars_booking.BatchTime,ars_booking.Part_Date   from  (select *  from  (select *, row_number() over (partition by activitybookingid order by lastmodifieddate  desc) rn   from  shipdw.hvtb_parse_vxp_ars_activitybooking *whereclause*) where rn = 1) ars_booking left join  shipdw.hvtb_mart_dim_booking_detail  dim_booking_detail on(ars_booking.activitybookingid==dim_booking_detail.booking_id)  left join shipdw.hvtb_mart_dim_voyage dim_voyage on(dim_voyage.src_active_flag==true and dim_voyage.src_deleted_flag==false and ars_booking.voyagenumber==dim_voyage.voyage_number) left join shipdw.hvtb_mart_dim_activity dim_activity on (ars_booking.activitycode==dim_activity.activity_code) left join shipdw.hvtb_mart_dim_activity_slot dim_activity_slot on(ars_booking.activityslotcode==dim_activity_slot.activity_slot_code)   left join  (select *  from  (select activity_id,activity_code,vendor_skey,vendor_id,row_number()over(partition by activity_code order by batchtime desc) as rn  from  (select batchtime,vendorid,activity_id,activity_code   from  shipdw.hvtb_parse_ars_activity_vendor activity  group by batchtime,activity_id,activity_code,vendorid)activity inner join shipdw.hvtb_mart_dim_vendor vendor on  (activity.vendorid==vendor.vendor_id) )book where rn=1 ) dim_vendor on(trim(dim_vendor.activity_code)==trim(ars_booking.activitycode))  left join shipdw.hvtb_mart_dim_date dated on(to_date(ars_booking.startdatetime)= dated.date) left join shipdw.hvtb_nbx_core_time_dim timed on(timed.second_of_day  = cast((unix_timestamp(ars_booking.startdatetime)- unix_timestamp(concat(to_date(ars_booking.startdatetime),' 00:00:00'))) as int))  left join (select  activitybookingid,personid,persontypecode,isdeleted,ischeckedin  from  (select activitybookingid,personid,persontypecode,isdeleted,ischeckedin, row_number() over (partition by activitypersonbookingid,activitybookingid order by lastmodifieddate  desc) rn   from  shipdw.hvtb_parse_vxp_activitypersonbooking) where rn = 1)activitypersonbooking on(Upper(activitypersonbooking.activitybookingid)==upper(ars_booking.activitybookingid)) left join (select count(personid) as number_of_people,activitybookingid  from  (select personid,activitybookingid, row_number() over (partition by activitypersonbookingid,activitybookingid order by lastmodifieddate  desc) rn   from  shipdw.hvtb_parse_vxp_activitypersonbooking) where rn = 1 group by activitybookingid) num_count on upper(ars_booking.activitybookingid)==upper(num_count.activitybookingid)  left join (select activityid,code,isdeleted,activitylocationid  from  (select  activityid,code,isdeleted,activitylocationid, row_number() over (partition by activityid,code order by lastmodifieddate  desc) rn   from  shipdw.hvtb_parse_vxp_ars_activity where isdeleted=false) where rn=1) vxp_ars_activity on(Upper(vxp_ars_activity.code)==upper(ars_booking.activitycode))  left join  (select  activitylocationid,venueid,isdeleted  from  (select activitylocationid,venueid,isdeleted,row_number() over(partition by activitylocationid order by lastmodifieddate desc) as rn  from  shipdw.hvtb_parse_vxp_ars_activitylocation)actl where actl.rn=1) vxp_ars_activity_location on(upper(vxp_ars_activity_location.activitylocationid) ==upper(vxp_ars_activity.activitylocationid))  left join shipdw.hvtb_mart_dim_venue dim_venue on (upper(vxp_ars_activity_location.venueid)=upper(dim_venue.venue_id)) left join shipdw.hvtb_mart_dim_sale_detail dim_sale_detail on(dim_sale_detail.sale_id == ars_booking.transactionId)  )booking_fact left join shipdw.hvtb_mart_dim_itinerary dim_itinerary on (voyageNumber=dim_itinerary.voyage_number and date(start_date_time)=date(dim_itinerary.itinerary_day_date) and dim_itinerary.src_active_flag=True and dim_itinerary.src_deleted_flag=False)   )booking  left join  shipdw.hvtb_parse_vxp_dxpcore_teammember dxpteammember on (booking.personid = dxpteammember.teammemberid) left join crew_vw dim_team_person_id on( booking.voyagenumber = dim_team_person_id.booking_cruise_number and dxpteammember.teammembernumber==dim_team_person_id.person_external_id) left join shipdw.hvtb_mart_dim_person dim_person_id on (booking.personid = dim_person_id.reservationguest_guid)  left join  shipdw.hvtb_parse_vxp_dxpcore_teammember dxpteammemberbookedby on (booking.bookedbypersonid = dxpteammemberbookedby.teammemberid) left join crew_vw dim_team_bookedby_id on( booking.voyagenumber = dim_team_bookedby_id.booking_cruise_number and dxpteammemberbookedby.teammembernumber==dim_team_bookedby_id.person_external_id) left join shipdw.hvtb_mart_dim_person dim_bookedby_id on (booking.bookedbypersonid = dim_bookedby_id.reservationguest_guid)  left join  shipdw.hvtb_parse_vxp_dxpcore_teammember dxpteammemberpaidby on (booking.payeepersonid = dxpteammemberpaidby.teammemberid) left join crew_vw dim_team_paidby_id on( booking.voyagenumber = dim_team_paidby_id.booking_cruise_number and dxpteammemberpaidby.teammembernumber==dim_team_paidby_id.person_external_id) left join shipdw.hvtb_mart_dim_person dim_paid_by_id on (booking.payeepersonid =dim_paid_by_id.reservationguest_guid)  left join  shipdw.hvtb_parse_vxp_dxpcore_teammember dxpteammembercancelledby on (booking.cancelledbypersonid = dxpteammembercancelledby.teammemberid) left join crew_vw dim_team_cancelled_by_id on( booking.voyagenumber = dim_team_cancelled_by_id.booking_cruise_number and dxpteammembercancelledby.teammembernumber==dim_team_cancelled_by_id.person_external_id) left join shipdw.hvtb_mart_dim_person dim_cancelled_by_id on (booking.cancelledbypersonid =dim_cancelled_by_id.reservationguest_guid)
 
