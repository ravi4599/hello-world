select voyage_id,voyage_number,ship_code,voyage_skey from shipdw.hvtb_mart_dim_voyage where src_deleted_flag = false and src_active_flag = true ) dim_voyage on (reserv.voyagenumber = dim_voyage.voyage_number) left join shipdw.hvtb_mart_dim_person dim_person on (rg.reservationguestid = dim_person.reservationguest_guid)
