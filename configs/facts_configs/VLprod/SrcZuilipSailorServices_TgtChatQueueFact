on rg.reservationid = r.reservationid )  rg_main on upper(iam_up.personid) = upper(rg_main.guestid) and  rg_main.voyagenumber = sq.voyage_number left join shipdw.hvtb_mart_dim_person person_dim on upper(rg_main.reservationguestid) = upper(person_dim.reservationguest_guid) left join shipdw.hvtb_mart_dim_voyage voyage_dim on sq.voyage_number = voyage_dim.voyage_number left join shipdw.hvtb_mart_dim_chat_queue_detail chat_q on sq.id = chat_q.chat_queue_id
