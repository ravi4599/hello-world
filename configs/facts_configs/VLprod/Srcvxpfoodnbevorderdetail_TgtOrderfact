spark.source.sql select * ,case when order_delivery_time_taken_mins is null then null else (Case when order_delivery_time_taken_mins>order_max_wait_time then True else False end) end  as order_delayed_flg from  ( select order.orderid,NVL(order.voyageid,'N/A') as voyage_id, NVL(dim_voyage.ship_code,'N/A') as ship_code ,NVL(dim_voyage.voyage_skey ,-1) as voyage_skey , NVL(dim_orderdetail.order_detail_skey ,-1) as order_detail_skey, NVL(dim_venue.venue_skey ,-1) as venue_skey,NVL(dim_person.person_skey,-1) as order_placed_by_person_skey, NVL(dim_person_delivertoguestid.person_skey,-1) as order_delivered_to_person_skey, NVL(dim_person_deliverypersonid.person_skey,-1) as order_delivered_by_person_skey, NVL(dim_sale_detail.sale_detail_skey,-1) as sale_detail_skey, order.orderdate as order_placed_datetime, order.modifieddate as order_modified_datetime, order.minwaittime as order_min_wait_time, order.maxwaittime as order_max_wait_time, case when order.orderdeliverydate is null then null else (NVL(UNIX_TIMESTAMP(order.orderdeliverydate),0)-NVL(UNIX_TIMESTAMP(order.orderdate),0))/60 end as order_delivery_time_taken_mins, order.orderdeliverydate as order_delivered_datetime, order.amount as order_amount, parse_order_cancellation.cancellationdate as order_cancellation_date, parse_order_cancellation.refundamount as order_cancellation_refund_amount, parse_order_cancellation.cancellationreason as order_cancellation_reason, parse_foodnbev_orderdetail.order_total_number_items, order.Part_Date as part_date, order.BatchTime as batchtime  from( select * from (select * , row_number() over(partition by orderid order by modifieddate desc) as rn    from shipdw.hvtb_parse_vxp_foodnbev_order )ordr where ordr.rn=1 ) order   left join (select * from (select * ,row_number ()over (partition by reservationguestid order by lastmodifieddate desc) as rn from vv_db.hvtb_parse_vxp_reservationguest)reguest where reguest.rn=1)   rguest on(UPPER(order.guestid) == UPPER(rguest.reservationguestid)) left join  ( select * from (select *, row_number() over (partition by reservationid order by lastmodifieddate desc) as rn from vv_db.hvtb_parse_vxp_reservation )reser where reser.rn=1 )    reserv     on(UPPER(rguest.reservationid)== UPPER(reserv.reservationid)) left join  shipdw.hvtb_mart_dim_voyage dim_voyage on (UPPER(reserv.voyagenumber)==UPPER(dim_voyage.voyage_number)) left join shipdw.hvtb_mart_dim_order_detail dim_orderdetail on(dim_orderdetail.order_id==order.orderid) left join(  select venueid as venue_id,globalvenueid,venued.venue_skey from   ( select * from (select * ,row_number() over (partition by globalvenueid order by addeddate desc ,part_date desc ) as rn from shipdw.hvtb_parse_vxp_foodnbev_venue)fnbvenue where fnbvenue.rn=1)venue_parse      inner join shipdw.hvtb_mart_dim_venue venued on(venue_parse.globalvenueid==venued.venue_id) )dim_venue on(order.venueid==dim_venue.venue_id) left join shipdw.hvtb_mart_dim_person dim_person on(UPPER(order.guestid)==UPPER(dim_person.reservationguest_guid)) left join shipdw.hvtb_mart_dim_person dim_person_delivertoguestid on(UPPER(order.delivertoguestid)==UPPER(dim_person_delivertoguestid.reservationguest_guid)) left join ( select * from (select *,row_number()over(partition by teammemberid order by lastmodifieddate desc) as rn      from shipdw.hvtb_parse_vxp_dxpcore_teammember)teammember  where teammember.rn=1)team on (UPPER(order.delivertoguestid)==UPPER(team.teammemberid)) left join shipdw.hvtb_mart_dim_person dim_person_deliverypersonid on(UPPER(team.teammembernumber)==UPPER(dim_person_deliverypersonid.person_external_id))  left join (select receipt_number,sale_detail_skey from shipdw.hvtb_mart_dim_sale_detail  where sale_detail_src='POS') dim_sale_detail on (TRIM(order.ordernumber) = TRIM(dim_sale_detail.receipt_number)) left join   ( select * from (select * ,row_number () over (partition by orderid order by lastmodifieddate desc ) as rn from shipdw.hvtb_parse_vxp_foodnbev_ordercancellation)ordrcancel where ordrcancel.rn=1)   parse_order_cancellation  on(parse_order_cancellation.orderid==order.orderid) left join (select sum(orderqty) as order_total_number_items,orderid from shipdw.hvtb_parse_vxp_foodnbev_orderdetail group by orderid)parse_foodnbev_orderdetail on (order.orderid==parse_foodnbev_orderdetail.orderid) where order.status!=0 )order_fact *whereclause*
