spark.source.sql select 'Client' as srcReferenceType,'VXP-Guest' as tgtReferenceType,cast(ptnid as string)as sourceID,'N/A' as booking_reference_number,itinerary_skey, voyage_skey,dim_voyage.ship_code as ship_code,'KONAMI' as source_type,voyage_number as voyage_id,sale_detail_skey,pos_item_skey,folio_item_skey,cast(ptnid as string)as ptnid,itinerary_skey,outlet_skey,activity_skey,sale_date_skey,sale_time_skey,device_skey,time_on_device_seconds,avg_wager_amount,casino_game_dph,theoritical_winnings,sale_quantity,item_list_price_amount,debit_amount,credit_amount,tax_amount,discount_amount,discount_value,cost_of_goods,manual_adjustment_amount,total_collected_sales_amount, total_shared_revenue_amount   from  ((select 'SC' as ship_code,dim_dev.device_skey,konami_src.voyage_id,ptnid,dateinserted , -1 as sale_detail_skey,   -1 as pos_item_skey, -1 as folio_item_skey,   -1 as activity_skey, 0 as sale_time_skey, NVL(dd.date_id, -1) as sale_date_skey, devid, timeondevsec as time_on_device_seconds,avgwager as avg_wager_amount,gamedph as casino_game_dph,theowin as theoritical_winnings, 0 as sale_quantity, 0 as item_list_price_amount, 0 as tax_amount, 0 as discount_amount, 0 as discount_value,0 as cost_of_goods, 0 as manual_adjustment_amount, itinerary_skey, totbuyin as debit_amount, totwalkwith as  credit_amount, totbuyin-totwalkwith-0 as total_shared_revenue_amount, totbuyin-totwalkwith as total_collected_sales_amount,1 as outlet_srcjoin_key from shipdw.hvtb_parse_konami_vw_odbc_dailyptnrtg  konami_src  left join  shipdw.hvtb_mart_dim_itinerary dim_itinerary on (dim_itinerary.src_deleted_flag ==False and dim_itinerary.src_active_flag == True and to_date(konami_src.dateinserted)==date(dim_itinerary.itinerary_day_date)) left join shipdw.hvtb_mart_dim_date dd on to_date(konami_src.dateinserted) = dd.`date`   left join shipdw.hvtb_mart_dim_device dim_dev on(konami_src.devid==dim_dev.device_id)      *whereclause*)  Konami_Sales  left join  (select outlet_skey, 1 as outlet_dimjoin_key from shipdw.hvtb_mart_dim_outlet where outlet_name='Casino') outlet_dim  on(Konami_Sales.outlet_srcjoin_key==outlet_dim.outlet_dimjoin_key)) left join shipdw.hvtb_mart_dim_voyage dim_voyage on  (src_deleted_flag ==False and src_active_flag == True and to_date(Konami_Sales.dateinserted) between dim_voyage.voyage_start_date and dim_voyage.voyage_end_date)     
