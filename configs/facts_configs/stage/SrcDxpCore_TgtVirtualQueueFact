spark.source.sql select NVL(voyage_dim.ship_code ,-1) as ship_code, NVL(voyage_dim.voyage_skey ,-1) as voyage_skey, NVL(virtual_dim. virtual_queue_detail_skey , -1) as virtual_queue_detail_skey, NVL(virtual_def_dim.virtual_queue_definition_skey , -1) as virtual_queue_definition_skey, NVL(person_dim.person_skey , -1)  as person_skey, vq.addeddate as queue_joined_datetime, vq.virtualqueueid as virtualqueueid ,vq.VoyageId as voyage_id, vq.BatchTime as batchtime, vq.Part_Date as part_dt from (select * from (select * , row_number() over(partition by virtualqueueid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_dxp_virtualqueue ) where rn = 1)vq left join (select * from (select * , row_number() over(partition by reservationguestid order by lastmodifieddate desc) rn from vv_db.hvtb_parse_vxp_reservationguest  ) where rn = 1)resg on  resg.reservationguestid=vq.personid left join (select * from (select * , row_number() over(partition by reservationid order by lastmodifieddate desc) rn from vv_db.hvtb_parse_vxp_reservation  ) where rn = 1)res on resg.reservationid=res.reservationid left join shipdw.hvtb_mart_dim_voyage voyage_dim on res.voyagenumber=voyage_dim.voyage_number left join shipdw.hvtb_mart_dim_virtual_queue_detail virtual_dim on  vq.virtualqueueid =  virtual_dim.virtual_queue_id left join shipdw.hvtb_mart_dim_virtual_queue_definition virtual_def_dim on   vq.virtualqueuedefinitionid = virtual_def_dim.virtual_queue_definition_id left join (select reservationguest_guid,person_skey from (select reservationguest_guid,person_skey,row_number ()over (partition by reservationguest_guid order by coalesce (booking_departure_date,'1900-01-01') desc, md5_hash desc) as rn from shipdw.hvtb_mart_dim_person)per where per.rn=1) person_dim on vq.personid = person_dim.reservationguest_guid

