spark.source.sql select * from (select NVL(table_management_voyages.code, - 1) as voyage_id, NVL(voyage_dim.voyage_skey , - 1) as voyage_skey, NVL(dining_reservation_detail_dim.dining_reservation_detail_skey, - 1) as dining_reservation_detail_skey, NVL(dim_venue.venue_skey, - 1) as venue_skey, NVL(person_dim.person_skey, - 1) as person_skey, table_management_guest.is_main as main_guest_flg,(case when table_management_guest.deleted_at is null then false else true END) as src_deleted_flg, table_management_guest.deleted_at as src_deleted_datetime, table_management_reservation.batchtime as batchtime, table_management_reservation.part_date as part_date from (select * from (select * , row_number() over(partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_reservation ) where rn = 1) table_management_reservation left join (select * from (select * , row_number() over(partition by reservation_id,guest_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_reservationguest ) where rn = 1) table_management_guest on table_management_guest.reservation_id = table_management_reservation.public_id left join ( select * from (select * , row_number() over(partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_voyages ) where rn = 1) table_management_voyages on table_management_voyages.public_id = table_management_reservation.voyage_id left join shipdw.hvtb_mart_dim_voyage voyage_dim on voyage_dim.voyage_number = table_management_voyages.code left join shipdw.hvtb_mart_dim_dining_reservation_detail dining_reservation_detail_dim on dining_reservation_detail_dim.dining_reservation_id = table_management_reservation.public_id left join (select * from (select * , row_number() over(partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_venues ) where rn = 1)  venues on venues.public_id = table_management_reservation.venue_id left join shipdw.hvtb_mart_dim_venue dim_venue on dim_venue.venue_id = venues.external_id left join shipdw.hvtb_mart_dim_person person_dim on person_dim.reservationguest_guid = table_management_guest.guest_id ) *whereclause*

spark.source.columns voyage_id,voyage_skey,dining_reservation_detail_skey,venue_skey,person_skey,main_guest_flg,src_deleted_flg,src_deleted_datetime,batchtime,part_date
 
