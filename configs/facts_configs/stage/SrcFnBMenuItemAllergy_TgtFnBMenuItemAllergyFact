spark.source.sql select menuitemparse.voyageid as voyage_id, NVL(menudim.menu_item_skey, -1) as menu_item_skey ,NVL(allergydim.allergy_skey , -1) as allergy_skey,false as src_deleted_flg,menuitemparse.batchtime ,menuitemparse.part_date from ( select * from (select *, row_number() over (partition by menuitemid,allergyid order by addeddate  desc) rn  from shipdw.hvtb_parse_vxp_foodandbeverage_menuitemallergy) where rn = 1 ) menuitemparse left join shipdw.hvtb_mart_dim_menu_item menudim on menuitemparse.menuitemid = menudim.menu_item_id left join shipdw.hvtb_mart_dim_allergy allergydim on menuitemparse.allergyid = allergydim.allergy_id
 
spark.source.columns voyage_id,menu_item_skey,allergy_skey,src_deleted_flg

