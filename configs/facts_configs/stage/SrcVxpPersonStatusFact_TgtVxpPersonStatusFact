spark.source.sql   select * , CASE WHEN rts_done_status = true and UPPER(moci_prevalidstatuscode)= 'APPROVED' Then 'Green' WHEN rts_done_status = true and UPPER(moci_prevalidstatuscode)= 'PENDING' Then 'Yellow' WHEN rts_done_status = true and UPPER(moci_prevalidstatuscode)= 'REJECTED' Then 'Red' WHEN rts_done_status = false Then 'Red' end  as aci_status_color from(select reserve.voyageid as voyage_id,NVL(dim_person.person_skey,-1)as person_skey, NVL(dim_voyage.voyage_skey,-1)as voyage_skey,NVL(dim_voyage.ship_code,'N/A')as ship_code,guestdetail.status as moderation_status  ,guestdetail.addeddate as moderation_addeddate,guestdetail.verificationstatuscode as verificationstatuscode,guestdetail.verificationstatuschangedate as verificationstatuschangedate,prevalidatestatuscode as moci_prevalidstatuscode ,case when upper(trim(personstatusrts.statustypecode)) = 'OC' and upper(personstatusrts.status) = 'COMPLETED' and personstatusrts.isdeleted = false then true  	ELSE false end as rts_done_status, 	 personstatusbs.status  as boarding_status,personstatustc.status  as terminal_checkin_status, 	case when upper(trim(personstatustc.statustypecode)) = 'TC' and upper(personstatustc.status) = 'COMPLETED' Then 'Green/Complete' 	when upper(trim(personstatustc.statustypecode)) = 'TC' and upper(personstatustc.status) = 'NOT_COMPLETED' Then 'Yellow/Pending'     else  'Red/Pending' end as terminal_checkin_status_color ,part_date,batchtime from  ( select * from ( select voyagenumber,reservationnumber,reservationid,voyageid,row_number() over (partition by reservationid order by lastmodifieddate desc) as rn from vv_db.hvtb_parse_vxp_reservation)rese where rese.rn=1 ) reserve left join ( select * from ( select reservationguestid,reservationid,row_number() over (partition by reservationguestid order by lastmodifieddate desc) as rn from vv_db.hvtb_parse_vxp_reservationguest)guest_reserve where guest_reserve.rn=1 ) reserv_guest on (upper(reserve.reservationid)=upper(reserv_guest.reservationid))  left join shipdw.hvtb_mart_dim_voyage dim_voyage on(reserve.voyagenumber=dim_voyage.voyage_number) left join ( select * from ( select prevalidatestatuscode,verificationstatuschangedate,verificationstatuscode,addeddate,status,reservationguestid,part_date,batchtime,row_number() over (partition by reservationguestid order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_guestmoderationdetail)mod where mod.rn=1 ) guestdetail on (upper(guestdetail.reservationguestid)=upper(reserv_guest.reservationguestid))  left join shipdw.hvtb_mart_dim_person dim_person on  (upper(guestdetail.reservationguestid)=upper(dim_person.reservationguest_guid))  left join ( select * from ( select statustypecode,status,isdeleted,personid,row_number() over (partition by personid order by lastmodifieddate desc) as rn from vv_db.hvtb_parse_vxp_personstatus)person_status where person_status.rn=1 )personstatus on(upper(personstatus.personid) = upper(guestdetail.reservationguestid)) left join ( select * from ( select statustypecode,status,isdeleted,personid,row_number() over (partition by personid order by lastmodifieddate desc) as rn from vv_db.hvtb_parse_vxp_personstatus where upper(trim(statustypecode)) = 'BS')person_status where person_status.rn=1 )personstatusbs on(upper(personstatusbs.personid) = upper(guestdetail.reservationguestid)) left join ( select * from ( select statustypecode,status,isdeleted,personid,row_number() over (partition by personid order by lastmodifieddate desc) as rn from vv_db.hvtb_parse_vxp_personstatus where upper(trim(statustypecode)) = 'OC')person_status where person_status.rn=1 )personstatusrts on(upper(personstatusrts.personid) = upper(guestdetail.reservationguestid)) left join ( select * from ( select statustypecode,status,isdeleted,personid,row_number() over (partition by personid order by lastmodifieddate desc) as rn from vv_db.hvtb_parse_vxp_personstatus where upper(trim(statustypecode)) = 'TC')person_status where person_status.rn=1 )personstatustc on(upper(personstatustc.personid) = upper(guestdetail.reservationguestid)))person_status_fact *whereclause*

