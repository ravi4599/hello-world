spark.source.sql  select ps.VoyageId as voyage_id,ps.personstatusid as person_status_id,NVL(per.person_skey,-1) as person_skey,ps.shipcode as ship_code,NVL(vyg.voyage_skey,-1) as voyage_skey,persontypecode as person_type_code,ps.embarkdate as embark_date,ps.debarkdate as debark_date,ps.status as status,ps.statustypecode as status_type_code,ps.statuschangeddate as status_changed_date_time,ps.percentagecompleted AS percentage_completed,ps.isdeleted as is_deleted_flg, ps.lastmodifieddate as src_last_modified_timestamp,ps.addeddate as src_added_timestamp,ps.batchtime as batchtime,ps.part_date as part_date from (select * from (select * , row_number() over(partition by personstatusid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_personstatus) where rn = 1) ps left join shipdw.hvtb_mart_dim_person per on ps.personid=per.reservationguest_guid left join (select * from (select * , row_number() over(partition by reservationguestid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_reservationguest ) where rn = 1) rg on ps.personid=rg.reservationguestid left join (select * from (select * ,row_number() over(partition by reservationid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_reservation ) where rn = 1) r on rg.reservationid=r.reservationid left join shipdw.hvtb_mart_dim_voyage vyg on r.voyagenumber=vyg.voyage_number
 
 
