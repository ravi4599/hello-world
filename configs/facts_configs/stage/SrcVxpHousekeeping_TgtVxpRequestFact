spark.pond.allColumns voyage_id as pond_voyage_id,voyage_skey as pond_voyage_skey,ship_code as pond_ship_code,request_detail_skey as pond_request_detail_skey,venue_skey as pond_venue_skey,request_assigned_person_skey as pond_request_assigned_person_skey,request_created_datetime as pond_request_created_datetime,request_started_datetime as pond_request_started_datetime,request_completed_datetime as pond_request_completed_datetime,request_cancelled_datetime as pond_request_cancelled_datetime,request_assigned_datetime as pond_request_assigned_datetime,request_at_risk_datetime as pond_request_at_risk_datetime,request_overdue_datetime as pond_request_overdue_datetime,request_time_taken_seconds as pond_request_time_taken_seconds,request_type_sla_duration as pond_request_type_sla_duration,request_type_duration as pond_request_type_duration,request_type_at_risk_duration as pond_request_type_at_risk_duration,load_dt as pond_load_dt,upd_dt as pond_upd_dt,primaryhash as pond_primaryhash,md5_hash as pond_md5_hash,part_dt as pond_part_dt

