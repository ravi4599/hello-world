spark.source.sql SELECT requests.public_id as public_id, NVL(requests.shipcode,-1) as ship_code, NVL(voyage_dim.voyage_skey , - 1 ) as voyage_skey, NVL(request_detail.request_detail_skey , - 1 ) as request_detail_skey, NVL(dim_venue.venue_skey, - 1 ) as venue_skey, NVL(person_dim.person_skey, - 1 )as request_assigned_person_skey, requests.created as request_created_datetime, requests.started_at as request_started_datetime, requests.completed_at as request_completed_datetime, requests.cancelled_at as request_cancelled_datetime, requests.assigned_at as request_assigned_datetime, requests.at_risk_at as request_at_risk_datetime, requests.overdue_at as request_overdue_datetime, unix_timestamp(requests.completed_at) - unix_timestamp(requests.started_at) as request_time_taken_seconds, requests_types.sla_duration as request_type_sla_duration, requests_types.request_duration as request_type_duration, requests_types.at_risk_duration as request_type_at_risk_duration, requests.VoyageId as voyage_id, requests.batchtime as batchtime, requests.part_date as part_dt from ( select * from (select * , row_number() over(partition by public_id order by batchtime desc) rn from shipdw.hvtb_parse_vxp_housekeeping_requests ) where rn = 1) requests left join shipdw.hvtb_parse_vxp_housekeeping_request_types requests_types on requests.request_type = requests_types.id left join ( select * from (select * , row_number() over(partition by global_venue_id order by id desc) rn from shipdw.hvtb_parse_vxp_locationcon_venues ) where rn = 1) venues on requests.place_id = venues.id left join shipdw.hvtb_mart_dim_venue dim_venue on venues.global_venue_id = dim_venue.venue_id left join shipdw.hvtb_mart_dim_request_detail request_detail on request_detail.request_id = requests.public_id left join ( select * from (select *,row_number()over(partition by teammemberid order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_dxpcore_teammember)teammember  where teammember.rn=1)team on requests.assigned = team.teammemberid left join  shipdw.hvtb_mart_dim_person person_dim on team.teammembernumber = person_dim.person_external_id left join (select * from  shipdw.hvtb_mart_dim_voyage where src_deleted_flag <> true) voyage_dim on requests.voyage_number = voyage_dim.voyage_number *whereclause*


spark.source.columns voyage_id,voyage_skey,ship_code,request_detail_skey,venue_skey,request_assigned_person_skey,request_created_datetime,request_started_datetime,request_completed_datetime,request_cancelled_datetime,request_assigned_datetime,request_at_risk_datetime,request_overdue_datetime,request_time_taken_seconds,request_type_sla_duration,request_type_duration,request_type_at_risk_duration

