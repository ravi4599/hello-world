spark.source.sql select * from (select spa_util.voyage_id,spa_util.ship_code,NVL(voyage_skey,-1) as voyage_skey ,NVL(dim_service_type.service_type_skey,-1) as service_type_skey,NVL(dim_outlet.outlet_skey,-1) as outlet_skey,NVL(dim_venue.venue_skey,-1) as venue_skey,NVL(dated.date_id,-1) as utilization_date_skey,spa_util.date as utilization_date ,totalavailablehours as  total_available_hours ,totalbookedhours as total_booked_hours,numberofreservations as count_reservations,numofprevoyagebookings as count_prevoyage_bookings,totalrevenue as total_revenue_amount,totaltarget as total_target_amount,spa_util.batchtime,spa_util.part_date from (select * from (select batchtime,part_date, voyageid as voyage_id,shipcode as ship_code,voyagenumber,spaservicetype,spaservicecategory,spavenue,date,totalavailablehours,totalbookedhours,numberofreservations,numofprevoyagebookings,totalrevenue,totaltarget,row_number()over(partition by spaservicetype,spaservicecategory order by date desc)as rn from shipdw.hvtb_parse_spa_utilization)spa where spa.rn=1 )spa_util  left join shipdw.hvtb_mart_dim_voyage dim_voyage on(trim(spa_util.voyagenumber)==trim(dim_voyage.voyage_number)) left join  shipdw.hvtb_mart_dim_service_type dim_service_type on(spa_util.spaservicetype==dim_service_type.service_type and dim_service_type.service_category==spa_util.spaservicecategory) left join shipdw.hvtb_mart_dim_outlet dim_outlet on(trim(spa_util.spavenue)==trim(dim_outlet.outlet_id)) left join shipdw.hvtb_mart_lkp_venue venue_lkp  on(upper(venue_lkp.salesoutletid)==upper(spa_util.spavenue)) left join shipdw.hvtb_mart_dim_venue dim_venue on(UPPER(venue_lkp.venueidgo)==UPPER(dim_venue.venue_id) )  left join shipdw.hvtb_mart_dim_date dated on(dated.`date`==spa_util.date))spa_util_fact 

