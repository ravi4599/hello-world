spark.source.sql select dim_voyage.voyage_id as voyage_id, dim_voyage.ship_code as ship_code, NVL(dim_voyage.voyage_skey,-1) as voyage_skey, NVL(dim_person.person_skey,-1) as person_skey, rg.guestcheckindetailid as rg_guestcheckindetailid, gcd.guestcheckindetailid as gcd_guestcheckindetailid, rg.reservationid as rg_reservationid, reserv.reservationid as reserv_reservationid, rg.reservationguestid, NVL(gcd.cruisecontractsigneddate,null) as cruise_contract_signed_datetime, NVL(gcd.cruisewellcontractsigneddate,null) as voyage_well_contract_signed_datetime, NVL(gcd.iscruisewellcontractsigned,null) as is_health_contract_signed, NVL(gcd.healthcontractsigneddate,null) as health_contract_signed_datetime, NVL(gcd.isfittotravel,null) as is_fit_to_travel, NVL(gcd.isthermalcheckpassed,null) as is_thermal_check_passed, NVL(gcd.thermalcheckdate,null) as thermal_check_datetime, NVL(gcd.iscovidtestpassed,null) as is_covid_test_passed, NVL(gcd.covidtestdate,null) as covid_test_datetime, NVL(guestvaccine.finalvaccinationstatus,null) as covid_vaccination_status, NVL(guestvaccine.finalvaccinationdate,null) as covid_last_vaccination_datetime, NVL(codevalueresource.resourcevalue,null) as covid_vaccination_type_name, NVL(guestvaccine.isboosterdosereceived,null) as is_booster_dose_received, NVL(guestvaccine.lastboosterdosereceiveddate,null) as booster_dose_received_datetime, rg.part_date, rg.batchtime  from ( select a.reservationguestid, a.reservationid, a.guestcheckindetailid, a.part_date, a.batchtime from ( select reservationguestid, guestcheckindetailid , reservationid, part_date, batchtime, row_number() over(partition by reservationguestid order by lastmodifieddate desc) as rn from vv_db.hvtb_parse_vxp_reservationguest)a where a.rn = 1) rg left join ( select a.cruisecontractsigneddate, a.cruisewellcontractsigneddate, a.iscruisewellcontractsigned, a.healthcontractsigneddate, a.isfittotravel, a.isthermalcheckpassed, a.thermalcheckdate, a.iscovidtestpassed, a.covidtestdate, a.guestcheckindetailid from ( select cruisecontractsigneddate, cruisewellcontractsigneddate, iscruisewellcontractsigned, healthcontractsigneddate, isfittotravel, isthermalcheckpassed, thermalcheckdate, iscovidtestpassed, covidtestdate, guestcheckindetailid, row_number() over(partition by guestcheckindetailid order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_dxp_guestcheckindetail)a where a.rn = 1) gcd on (rg.guestcheckindetailid = gcd.guestcheckindetailid) left join ( select a.voyagenumber, a.reservationid from ( select voyagenumber, reservationid, row_number() over(partition by reservationid order by lastmodifieddate desc )as rn from vv_db.hvtb_parse_vxp_reservation)a where a.rn = 1) reserv on (rg.reservationid = reserv.reservationid) left join ( select voyage_id, voyage_number, ship_code, voyage_skey from shipdw.hvtb_mart_dim_voyage where src_deleted_flag = false and src_active_flag = true ) dim_voyage on (reserv.voyagenumber = dim_voyage.voyage_number)left join (select  * from (select guid,person_booking_id,person_id,row_number() over(partition by  guid order by last_changed,ts_ms desc) as rn from shipdw.hvtb_parse_mxp_person_booking where manifest_type='P' and person_booking_id>0)a where a.rn = 1)pb on rg.reservationguestid=lower(pb.guid) left join  (select * from (select  person_skey,reservationguest_guid,booking_id,person_id,row_number() over (partition by booking_id,person_id order by upd_dt desc,md5_hash desc) as rn from shipdw.hvtb_mart_dim_person) where rn = 1) dim_person on pb.person_booking_id = dim_person.booking_id and pb.person_id = dim_person.person_id   left join  (select * from  (select guestvaccinationid ,reservationguestid ,disease ,finalvaccinationstatus ,vaccinetypeid ,finalvaccinationdate ,isboosterdosereceived ,lastboosterdosereceiveddate ,isdeleted ,addeddate ,addedby ,lastmodifieddate ,lastmodifiedby ,lastmodifiedbyuserid ,lastmodifiedbyapplicationid ,VoyageId ,BatchTime ,ShipCode ,Part_Date ,row_number() over (partition by reservationguestid order by lastmodifieddate desc) as rn  from shipdw.hvtb_parse_vxp_dxp_guestvaccination where isdeleted = false) guestvac where rn= 1) guestvaccine on rg.reservationguestid = guestvaccine.reservationguestid  left join  (select codevalue.codevalueid, languageresource.resourcevalue  from  (select * from  (select codevalueid ,codetypecode ,code ,namekey ,descriptionkey ,isdeleted ,addeddate ,addedby ,lastmodifieddate ,lastmodifiedby ,VoyageId ,BatchTime ,ShipCode ,Part_Date ,row_number() over (partition by codevalueid order by lastmodifieddate desc) as rn  from shipdw.hvtb_parse_vxp_dxp_codevalue where isdeleted = false and codetypecode = 'CVT') cv where rn = 1) codevalue  inner join  (select * from  (select languageresourceid ,languagecode ,resourcekey ,resourcevalue ,addeddate ,addedby ,lastmodifieddate ,lastmodifiedby ,isdeleted ,VoyageId ,BatchTime ,ShipCode ,Part_Date ,row_number() over (partition by languageresourceid order by lastmodifieddate desc) as rn  from shipdw.hvtb_parse_vxp_dxp_languageresource where languagecode = 'en-us' and isdeleted = false) lr where rn = 1) languageresource on codevalue.namekey = languageresource.resourcekey) codevalueresource on guestvaccine.vaccinetypeid = codevalueresource.codevalueid



