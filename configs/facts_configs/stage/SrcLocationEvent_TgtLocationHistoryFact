spark.source.sql SELECT DISTINCT NVL(vdim.voyage_id, -1) AS voyage_id, NVL(vdim.ship_code, -1) AS ship_code, NVL(vdim.voyage_skey, -1) AS voyage_skey, NVL(pdim.person_skey, -1) AS person_skey, NVL(venueDim.venue_skey, -1) AS venue_skey, NVL(eventDim.event_skey, -1) AS event_skey, ddim.date_id AS capture_date_utc_skey, tdim.time_skey AS capture_time_utc_skey, loc.capturedate AS capture_datetime_utc, ddim.date_id AS capture_date_local_skey, tdim.time_skey + utcoffset * 60 AS capture_time_local_skey, CAST(unix_timestamp(capturedate) + loc.utcoffset * 60 AS TIMESTAMP) AS capture_datetime, loc.eventtype AS location_event_type, loc.room AS location_room, loc.`level` AS location_level, loc.roomtags AS location_tags, loc.logicalplace AS logicalplace, loc.locationeventid AS src_locationeventid, loc.batchtime, loc.part_date FROM shipdw.hvtb_parse_vxp_loca_locationevent loc LEFT JOIN shipdw.hvtb_mart_dim_voyage vdim ON loc.capturedate BETWEEN vdim.voyage_start_date AND vdim.voyage_end_date      AND vdim.ship_code = CASE WHEN loc.`structure` = 'Scarlet Lady' THEN 'SC' ELSE loc.structure END      AND vdim.src_active_flag = true AND vdim.src_deleted_flag = false LEFT JOIN shipdw.hvtb_mart_dim_person pdim ON loc.hostid = pdim.reservationguest_guid LEFT JOIN shipdw.hvtb_mart_dim_venue venueDim ON venueDim.venue_name = loc.room LEFT JOIN shipdw.hvtb_mart_dim_event eventDim ON eventDim.venue_skey = venueDim.venue_skey AND capturedate BETWEEN event_start_time AND CAST(unix_timestamp(event_start_time) + event_duration_minutes * 60 AS TIMESTAMP) INNER JOIN shipdw.hvtb_mart_dim_date ddim ON ddim.`date` = date(loc.capturedate) INNER JOIN shipdw.hvtb_nbx_core_time_dim tdim ON tdim.second_of_day = hour(capturedate)* 3600 + minute(capturedate)* 60 + second(capturedate)
spark.source.columns voyage_id,ship_code,voyage_skey,person_skey,venue_skey,event_skey,capture_date_utc_skey,capture_time_utc_skey,capture_datetime_utc,capture_date_local_skey,capture_time_local_skey,capture_datetime,location_event_type,location_room,location_level,location_tags,logicalplace,src_locationeventid,batchtime,part_date
spark.pond.allColumns voyage_id as pond_voyage_id,ship_code as pond_ship_code,voyage_skey as pond_voyage_skey,person_skey as pond_person_skey,venue_skey as pond_venue_skey,event_skey as pond_event_skey,capture_date_utc_skey as pond_capture_date_utc_skey,capture_time_utc_skey as pond_capture_time_utc_skey,capture_datetime_utc as pond_capture_datetime_utc,capture_date_local_skey as pond_capture_date_local_skey,capture_time_local_skey as pond_capture_time_local_skey,capture_datetime as pond_capture_datetime,location_event_type as pond_location_event_type,location_room as pond_location_room,location_level as pond_location_level,location_tags as pond_location_tags,logicalplace as pond_logicalplace,src_locationeventid as pond_src_locationeventid,load_dt as pond_load_dt,upd_dt as pond_upd_dt,part_dt as pond_part_dt
spark.pond.database shipdw
spark.pond.table hvtb_mart_fact_location_history

