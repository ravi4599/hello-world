ECT * FROM ( SELECT * , ROW_NUMBER() OVER(PARTITION BY orderid ORDER BY modifieddate DESC) AS rn FROM shipdw.hvtb_parse_vxp_foodnbev_order_lad WHERE status != 0 )ordr WHERE ordr.rn = 1 ) ORDER LEFT JOIN ( SELECT * FROM ( SELECT * , ROW_NUMBER () OVER (PARTITION BY reservationguestid ORDER BY lastmodifieddate DESC) AS rn FROM vv_db.hvtb_parse_vxp_reservationguest)reguest WHERE reguest.rn = 1) rguest ON (UPPER(order.guestid) == UPPER(rguest.reservationguestid)) LEFT JOIN ( SELECT * FROM ( SELECT *, ROW_NUMBER() OVER (PARTITION BY reservationid ORDER BY lastmodifieddate DESC) AS rn FROM vv_db.hvtb_parse_vxp_reservation )reser WHERE reser.rn = 1 ) reserv ON (UPPER(rguest.reservationid)== UPPER(reserv.reservationid)) LEFT JOIN shipdw.hvtb_mart_dim_voyage dim_voyage ON (UPPER(reserv.voyagenumber)== UPPER(dim_voyage.voyage_number)) LEFT JOIN shipdw.hvtb_mart_dim_order_detail dim_orderdetail ON (dim_orderdetail.order_id == order.orderid) LEFT JOIN( SELECT venueid AS venue_id, globalvenueid, venued.venue_skey FROM ( SELECT * FROM ( SELECT * , ROW_NUMBER() OVER (PARTITION BY globalvenueid ORDER BY addeddate DESC , part_date DESC ) AS rn FROM shipdw.hvtb_parse_vxp_foodnbev_venue)fnbvenue WHERE fnbvenue.rn = 1)venue_parse INNER JOIN shipdw.hvtb_mart_dim_venue venued ON (venue_parse.globalvenueid == venued.venue_id) )dim_venue ON (order.venueid == dim_venue.venue_id) LEFT JOIN ( SELECT * FROM ( SELECT * , ROW_NUMBER () OVER (PARTITION BY reservationguest_guid ORDER BY COALESCE (booking_departure_date, '1900-01-01') DESC, md5_hash DESC) AS rn FROM shipdw.hvtb_mart_dim_person)per WHERE per.rn = 1) dim_person ON (UPPER(order.guestid)== UPPER(dim_person.reservationguest_guid)) LEFT JOIN ( SELECT * FROM ( SELECT * , ROW_NUMBER () OVER (PARTITION BY reservationguest_guid ORDER BY COALESCE (booking_departure_date, '1900-01-01') DESC, md5_hash DESC) AS rn FROM shipdw.hvtb_mart_dim_person)per WHERE per.rn = 1) dim_person_delivertoguestid ON (UPPER(order.delivertoguestid)== UPPER(dim_person_delivertoguestid.reservationguest_guid)) LEFT JOIN ( SELECT * FROM ( SELECT *, ROW_NUMBER() OVER(PARTITION BY teammemberid ORDER BY lastmodifieddate DESC) AS rn FROM shipdw.hvtb_parse_vxp_dxpcore_teammember)teammember WHERE teammember.rn = 1)team ON (UPPER(order.deliverypersonid)== UPPER(team.teammemberid)) LEFT JOIN ( SELECT * FROM ( SELECT * , ROW_NUMBER () OVER (PARTITION BY person_id ORDER BY COALESCE (booking_departure_date, '1900-01-01') DESC, md5_hash DESC) AS rn FROM shipdw.hvtb_mart_dim_person)per WHERE per.rn = 1) dim_person_deliverypersonid ON (UPPER(team.teammembernumber)== UPPER(dim_person_deliverypersonid.person_id)) LEFT JOIN ( SELECT receipt_number, sale_detail_skey FROM shipdw.hvtb_mart_dim_sale_detail WHERE sale_detail_src = 'POS') dim_sale_detail ON (TRIM(order.ordernumber) = TRIM(dim_sale_detail.receipt_number)) LEFT JOIN ( SELECT * FROM ( SELECT * , ROW_NUMBER () OVER (PARTITION BY orderid ORDER BY lastmodifieddate DESC ) AS rn FROM shipdw.hvtb_parse_vxp_foodnbev_ordercancellation)ordrcancel WHERE ordrcancel.rn = 1) parse_order_cancellation ON (parse_order_cancellation.orderid == order.orderid) LEFT JOIN ( SELECT sum(orderqty) AS order_total_number_items, orderid FROM ( SELECT orderqty, orderid FROM ( SELECT orderqty, orderid, ROW_NUMBER () OVER (PARTITION BY orderid, orderdetailid ORDER BY lastmodifieddate DESC) AS rn FROM shipdw.hvtb_parse_vxp_foodnbev_orderdetail) od WHERE rn = 1) odd GROUP BY orderid) parse_foodnbev_orderdetail ON (order.orderid == parse_foodnbev_orderdetail.orderid) LEFT JOIN ( SELECT * FROM shipdw.hvtb_mart_dim_venue) ven ON (order.locationid == ven.venue_id ) LEFT JOIN (select* FROM shipdw.hvtb_mart_dim_venue) vendim ON (order.deliveredatlocationcode == vendim.venue_id ) )order_fact
