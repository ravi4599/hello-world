by reservationguest_guid order by coalesce (booking_departure_date,'1900-01-01') desc, md5_hash desc) as rn from shipdw.hvtb_mart_dim_person)per where per.rn=1) pd on pd.reservationguest_guid = rg.reservationguestid  left Join ( select voyagenumber, reservationid,reservationnumber from (select voyagenumber, reservationid,reservationnumber, row_number() over(partition by reservationid order by lastmodifieddate desc )as rn from vv_db.hvtb_parse_vxp_reservation)tmp where tmp.rn = 1) r on rg.reservationid = r.reservationid   left join (select voyage_number,voyage_skey,voyage_id from shipdw.hvtb_mart_dim_voyage where src_deleted_flag=false and src_active_flag=true) voyage_dim on voyage_dim.voyage_number = r.voyagenumber   left Join (select boardingnumberid, boardingnumber, slotnumber, shipcode, voyagenumber from (select boardingnumberid, boardingnumber, slotnumber, shipcode, voyagenumber, row_number() over(partition by boardingnumberid order by lastmodifieddate desc )as rn from shipdw.hvtb_parse_vxp_boardingnumber where isdeleted=false)tmp where tmp.rn = 1 ) bn on bn.boardingnumber = gbn.boardingnumber and bn.slotnumber = gbn.slotnumber and bn.shipcode = gbn.shipcode and bn.voyagenumber  =r.voyagenumber left Join (select boardingnumberid, boardingnumber, slotnumber, shipcode, voyagenumber from (select boardingnumberid, boardingnumber, slotnumber, shipcode, voyagenumber, row_number() over(partition by boardingnumberid order by lastmodifieddate desc )as rn from shipdw.hvtb_parse_vxp_boardingnumber where isdeleted=false and voyagenumber is null)tmp where tmp.rn = 1 ) bn1 on bn1.boardingnumber = gbn.boardingnumber and bn1.slotnumber = gbn.slotnumber and bn1.shipcode = gbn.shipcode left Join shipdw.hvtb_mart_vxp_boardingnumber_dim bd on bd.boardingnumber_id = bn.boardingnumberid left Join shipdw.hvtb_mart_vxp_boardingnumber_dim bd1 on bd1.boardingnumber_id = bn1.boardingnumberid  left join (select src_res_id,res_id,src_sail_id,rec_end_dttm from vv_db.hvtb_nbx_core_sw_reservation_dim where rec_end_dttm='9999-12-31 00:00:00') seaware_dim on  r.reservationnumber=seaware_dim.src_res_id)
  
