spark.source.sql select voyage_id,voyage_skey,dining_reservation_detail_skey, dining_table_skey,venue_skey,table_status,table_status_lastmodifieddate,BatchTime,part_date from (select NVL(tc.voyageid,'N/A') as voyage_id,-1 as voyage_skey, -1 as dining_reservation_detail_skey, NVL(dt.dining_table_skey,-1) as dining_table_skey , vd.venue_skey as venue_skey, 'clear' as table_status, tablecleardate as table_status_lastmodifieddate, tc.BatchTime, tc.partdate as part_date, row_number () OVER (partition by tmv.public_id, dining_table_skey order by tmv.public_id ) as rnk from shipdw.hvtb_parse_tbl_table_clear tc left outer join shipdw.hvtb_parse_vxp_table_management_settings_table st ON tc.tableNumber= st.name left outer join shipdw.hvtb_parse_vxp_table_management_settings_layout sl ON st.layout_id = st.public_id left outer join shipdw.hvtb_parse_vxp_table_management_sessions ts ON ts.settings_id = sl.settings_id left outer join shipdw.hvtb_parse_vxp_table_management_venues tmv ON tmv.public_id = ts.venue_id and tc.restaurantCode = tmv.external_id left outer join shipdw.hvtb_mart_dim_dining_table dt ON dt.dining_table_id= tc.tableNumber left outer join shipdw.hvtb_mart_dim_venue vd ON tc.restaurantCode=vd.venue_id)re where re.rnk = 1 and

