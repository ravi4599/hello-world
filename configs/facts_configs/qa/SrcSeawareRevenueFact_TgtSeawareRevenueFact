spark.source.sql SELECT current_timestamp() AS snapshot_time ,coalesce(rd.res_id, - 1) AS res_id ,coalesce(gm.guest_id, - 1) AS guest_id ,coalesce(CASE WHEN pm.package_id IS NULL THEN pm_pkg.package_id ELSE pm.package_id END, - 1) AS package_id ,coalesce(invitm.invoice_item_type_id, - 1) AS invoice_item_type_id ,coalesce(lkparea.price_area_id, - 1) AS price_area_id ,coalesce(sh.ship_id, - 1) AS ship_id ,coalesce(am.agent_id, - 1) AS agent_id ,coalesce(agency.agency_id, - 1) AS agency_id ,CASE WHEN LENGTH(inv.price_area) = 0 THEN - 1 ELSE coalesce(pro_lkp.promotion_id, - 1) END AS promotion_id ,coalesce(al.addon_id, - 1) AS addon_id ,- 1 AS cardeck_id ,- 1 AS shorex_id ,coalesce(hd.hotel_res_req_id, - 1) AS hotel_res_req_id ,coalesce(sr.ship_room_req_id, - 1) AS ship_room_req_id ,coalesce(sd.sail_id, - 1) AS sail_id ,CASE WHEN inv.price_area = 'COUPON' THEN coalesce(cc.coupon_class_id, - 1) ELSE - 1 END AS coupon_class_id ,CASE WHEN inv.price_area = 'AIR' THEN coalesce(fr.guest_flight_id, - 1) ELSE - 1 END AS guest_flight_id ,coalesce((round(inv.amount, 2)), 0) AS amount ,coalesce((round(inv.commission_percent, 2)), 0) AS commission_percent ,CASE WHEN gm.guest_seqn = 1 OR gm.guest_seqn IS NULL THEN coalesce(aid.param_value, - 1) ELSE 0 END AS net_due ,coalesce(addon.quantity, 0) AS addon_qty ,coalesce(reshdr.currency_code, 'USD') AS currency ,coalesce(reshdr.currency_rate, 0) AS currency_rate FROM ((select * from ( SELECT RES_INVOICE_ITEM_ID ,RES_ID ,GUEST_ID ,RES_PACKAGE_ID ,INVOICE_ITEM_TYPE ,PRICE_PER_UNIT ,N_OF_UNITS ,`PERCENT` ,AMOUNT ,INVOICE_ITEM_SUBTYPE ,INVOICE_ITEM_SUBTYPE2 ,INVOICE_ITEM_SUBTYPE3 ,PRICE_PROGRAM ,HOTEL_REQUEST_ID ,COMMISSION_PERCENT ,PRICE_AREA ,EXTENDED_INFO ,ADJUSTMENT_ORIGIN ,RES_PRODUCT_ID ,INVOICE_HDR_ID ,CLIENT_ID ,GUEST_SEQN ,AMOUNT_IN_HDR_CURR,ts_ms,row_number() over(partition by RES_INVOICE_ITEM_ID order by ts_ms desc) rn FROM vv_db.hvtb_parse_sw_rpl_res_invoice_item) where rn = 1) UNION (SELECT * FROM (select RES_INVOICE_ITEM_ID ,RES_ID ,GUEST_ID ,RES_PACKAGE_ID ,INVOICE_ITEM_TYPE ,PRICE_PER_UNIT ,N_OF_UNITS ,`PERCENT` ,AMOUNT ,INVOICE_ITEM_SUBTYPE ,INVOICE_ITEM_SUBTYPE2 ,INVOICE_ITEM_SUBTYPE3 ,PRICE_PROGRAM ,HOTEL_REQUEST_ID ,COMMISSION_PERCENT ,PRICE_AREA ,EXTENDED_INFO ,ADJUSTMENT_ORIGIN ,RES_PRODUCT_ID ,INVOICE_HDR_ID ,CLIENT_ID ,GUEST_SEQN ,AMOUNT_IN_HDR_CURR,ts_ms,row_number() over (partition by RES_INVOICE_ITEM_ID order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_res_invoice_canc )where rn = 1)) inv JOIN (select * from(select res_package_id,package_id,res_addon_id,hotel_request_id,guest_id,shiproom_request_id,ts_ms,row_number() over (partition by res_package_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_res_package) where rn =1)rp ON inv.res_package_id = rp.res_package_id JOIN (select * from(select res_id,guest_id,package_class,package_id,ts_ms,row_number() over (partition by res_id order by ts_ms desc)rn from  vv_db.hvtb_parse_sw_rpl_res_package )where rn =1)rp_pkg ON /*Logic to populate package_id that of class VOYAGE where its null*/ inv.res_id = rp_pkg.res_id AND inv.guest_id = rp_pkg.guest_id AND rp_pkg.package_class = 'VOYAGE' JOIN (select * from (select currency_code,currency_rate,res_id,ship_code,ts_ms,row_number() over (partition by res_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_res_header)where rn = 1)reshdr ON inv.res_id = reshdr.res_id LEFT JOIN vv_db.hvtb_nbx_core_sw_reservation_dim rd ON inv.res_id = rd.src_res_id AND to_date(rd.rec_end_dttm) = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_sail_dim sd ON rd.src_sail_id = sd.src_sail_id AND sd.rec_end_dttm = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_guest_dim gm ON inv.guest_id = gm.src_guest_id AND to_date(gm.rec_end_dttm) = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_package_dim pm ON rp.package_id = pm.src_package_id AND to_date(pm.rec_end_dttm) = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_package_dim pm_pkg ON /*Logic to populate package_id that of class VOYAGE where its null*/ rp_pkg.package_id = pm_pkg.src_package_id AND to_date(pm_pkg.rec_end_dttm) = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_invoice_item_type_lkp invitm ON inv.invoice_item_type = invitm.invoice_item_type AND ( CASE WHEN LENGTH(inv.invoice_item_subtype) = 0 OR inv.invoice_item_subtype IS NULL THEN '-1' ELSE inv.invoice_item_subtype END ) = coalesce(invitm.invoice_item_subtype, '-1') LEFT JOIN vv_db.hvtb_nbx_core_sw_price_area_lkp lkparea ON inv.price_area = lkparea.price_area LEFT JOIN vv_db.hvtb_nbx_core_sw_ship_dim sh ON reshdr.ship_code = sh.ship /*left join vv_db.hvtb_nbx_core_sw_agency_dim Agency on reshdr.agency_id = Agency.src_agency_id and to_date(Agency.rec_end_dttm) = '9999-12-31'*/ LEFT JOIN vv_db.hvtb_nbx_core_crm_agent_master_dim am ON rd.seaware_agent_id = am.seaware_agent_id__c AND to_date(am.rec_end_dttm) = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_crm_agency_master_dim Agency ON rd.seaware_agency_id = Agency.seaware_agency_id__c AND to_date(Agency.rec_end_dttm) = '9999-12-31' LEFT JOIN (select * from (select res_id,guest_id,res_package_id,promo_code,ts_ms,row_number() over (partition by res_id order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_res_promotion)where rn =1) pro ON inv.res_id = pro.res_id AND inv.guest_id = pro.guest_id AND inv.res_package_id = pro.res_package_id AND inv.price_program = pro.promo_code LEFT JOIN (select * from(select pap_code,promo_group,pap_name,ts_ms,row_number() over (partition by pap_code order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_pap_master)where rn=1) pap ON pap.pap_code = pro.promo_code LEFT JOIN vv_db.hvtb_nbx_core_sw_promotion_lkp pro_lkp ON NVL(pap.promo_group, '~') = NVL(pro_lkp.promo_group, '~') AND NVL(pap.pap_code, '~') = NVL(pro_lkp.promo_code, '~') AND NVL(pap.pap_name, '~') = NVL(pro_lkp.promo_name, '~') AND NVL(pro.promo_code, '~') = NVL(pro_lkp.promo_code, '~') /* NVL(inv.price_program, '~') = NVL(pro_lkp.promo_code, '~') */ LEFT JOIN vv_db.hvtb_parse_sw_rpl_res_addon addon ON rp.res_addon_id = addon.res_addon_id LEFT JOIN (select * from(select amenity_code,am_category,amenity_type,amenity_name,ts_ms,row_number() over (partition by amenity_code order by ts_ms desc)rn from vv_db.hvtb_parse_sw_rpl_am_code)where rn = 1) amcode ON addon.res_addon_code = amcode.amenity_code LEFT JOIN vv_db.hvtb_nbx_core_sw_addon_lkp al ON NVL(addon.res_addon_code, '~') = NVL(al.res_addon_code, '~') AND NVL(amcode.am_category, '~') = NVL(al.addon_category, '~') AND NVL(amcode.amenity_type, '~') = NVL(al.addon_type, '~') AND encode(NVL(amcode.amenity_name, '~'), 'utf-8') = encode(NVL(al.addon_name, '~'), 'utf-8') /*NVL(addon.res_addon_code, '~')= NVL(al.res_addon_code, '~') */ LEFT JOIN vv_db.hvtb_nbx_core_sw_hotel_res_req_dim hd ON rp.hotel_request_id = hd.src_hotel_res_req_id AND rp.guest_id = hd.src_guest_id LEFT JOIN vv_db.hvtb_nbx_core_sw_ship_room_request_dim sr ON rp.shiproom_request_id = sr.src_request_id LEFT JOIN (select * from(select record_id,param_value,entity_id,entity_type,param_name,timestamp,row_number() over(partition by record_id order by timestamp desc)rn from vv_db.hvtb_parse_sw_rpl_acc_invoice_detail)where rn = 1) aid ON reshdr.res_id = aid.entity_id AND aid.entity_type = 'RES' AND aid.param_name = 'NET_DUE' LEFT JOIN vv_db.hvtb_mart_seware_coupon_class_dim cc ON inv.extended_info = cc.coupon_class AND cc.rec_end_dttm = '9999-12-31' LEFT JOIN vv_db.hvtb_nbx_core_sw_guest_flight_rel fr ON fr.src_guest_id = inv.guest_id AND fr.segment_kind = inv.extended_info AND upper(fr.booking_status) = 'BOOKED' AND fr.rec_end_dttm like '999%' WHERE reshdr.ship_code <> 'XE'
spark.source.columns snapshot_time, res_id, guest_id, package_id, invoice_item_type_id, price_area_id, ship_id, agent_id, agency_id, promotion_id, addon_id, cardeck_id, shorex_id, hotel_res_req_id, ship_room_req_id, sail_id, coupon_class_id, guest_flight_id, amount, commission_percent, net_due, addon_qty, currency, currency_rate
