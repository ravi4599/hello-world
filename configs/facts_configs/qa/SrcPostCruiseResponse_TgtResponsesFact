spark.postvoyage.response.fact.sql select request_id as response_fact_request_id, client_id as response_fact_client_id, ship_id as response_fact_ship_id, sail_id as response_fact_sail_id, guest_id as response_fact_guest_id, request_time as response_fact_request_time, response_time as response_fact_response_time, itinerary_port as response_fact_itinerary_port, activity_skey as response_fact_activity_skey, question_id as response_fact_question_id, answer_rating as response_fact_answer_rating, answer_text as response_fact_answer_text, load_dt as response_fact_load_dt, upd_dt as response_fact_upd_dt, part_dt as response_fact_part_dt from vv_db.hvtb_nbx_core_postvoyage_survey_responses_fact
spark.postvoyage.question.dim.sql select question_id as question_dim_question_id, src_question_id as question_dim_src_question_id, variable_id as question_dim_variable_id, type as question_dim_type from vv_db.hvtb_nbx_core_postvoyage_survey_questions_dim

spark.ship.dim.sql select ship_id, ship  from vv_db.hvtb_nbx_core_sw_ship_dim

spark.sail.dim.sql select sail_id, src_sail_id, sail_date_from, sail_date_to, ship_id,sail_dim_sailfromdate,sail_dim_sailtodate from (Select sail_id, src_sail_id, sail_date_from, sail_date_to, ship_id, to_date(sail_date_from) as sail_dim_sailfromdate, to_date(sail_date_to) as sail_dim_sailtodate,row_number() over(partition by sail_date_from, sail_date_to,ship_id order by src_sail_id desc, sail_date_from desc ) as rn from vv_db.hvtb_nbx_core_sw_sail_dim where is_active = 'Y') inerQry where rn = 1
#select sail_id, src_sail_id, sail_date_from, sail_date_to, ship_id, to_date(sail_date_from) as sail_dim_sailfromdate, to_date(sail_date_to) as sail_dim_sailtodate from vv_db.hvtb_nbx_core_sw_sail_dim where is_active = 'Y'

#spark.guest.dim.sql SELECT gd.guest_id , gd.client_id as guest_dim_client_id, rd.src_sail_id as rd_src_sail_id from (select guest_id,client_id, row_number() over(partition by client_id order by guest_id desc) as rn from vv_db.hvtb_nbx_core_sw_guest_dim WHERE to_date(rec_end_dttm) = '9999-12-31') gd LEFT JOIN vv_db.hvtb_nbx_core_sw_res_guest_rel rel on rel.guest_id = gd.guest_id LEFT JOIN vv_db.hvtb_nbx_core_sw_reservation_dim rd on rd.res_id = rel.res_id WHERE rn = 1

spark.guest.dim.sql SELECT guest_id, guest_dim_client_id, rd_src_sail_id from (SELECT gd.guest_id , gd.client_id as guest_dim_client_id, rd.src_sail_id as rd_src_sail_id, row_number() over(partition by gd.client_id, rd.src_sail_id order by gd.guest_id desc,gd.rec_end_dttm desc) as rn from vv_db.hvtb_nbx_core_sw_guest_dim gd LEFT JOIN vv_db.hvtb_nbx_core_sw_res_guest_rel rel on rel.guest_id = gd.guest_id LEFT JOIN vv_db.hvtb_nbx_core_sw_reservation_dim rd on rd.res_id = rel.res_id) where rn = 1

spark.activity.dim.sql select activity_skey, activity_name from (select activity_skey, trim(lower(activity_name)) as activity_name, row_number() over(partition by activity_name order by upd_dt desc ) as rn from shipdw.hvtb_mart_dim_activity where src_deleted_flg = false) where rn = 1

