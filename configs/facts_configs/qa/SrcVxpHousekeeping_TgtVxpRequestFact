spark.source.sql select public_id, ship_code, voyage_skey, request_created_datetime, request_detail_skey, venue_skey, request_assigned_person_skey, request_started_datetime, request_completed_datetime, request_cancelled_datetime, request_assigned_datetime, request_at_risk_datetime, request_overdue_datetime, request_time_taken_seconds, request_type_sla_duration, request_type_duration, request_type_at_risk_duration, voyage_id, batchtime, part_dt  from  (select *, row_number () over (partition by request_created_datetime order by batchtime desc,voyage_start_date asc) as rn  from  (select requests.public_id, requests.ship_code,  CASE WHEN requests.voyage_number IS NULL THEN voyage_dim1.voyage_skey WHEN requests.voyage_number IS NOT NULL THEN voyage_dim.voyage_skey END as voyage_skey, COALESCE(voyage_dim.voyage_start_date,voyage_dim1.voyage_start_date) as voyage_start_date,  requests.created as request_created_datetime,  NVL(request_detail.request_detail_skey,- 1 ) as request_detail_skey, NVL(dim_venue.venue_skey,- 1 ) as venue_skey, NVL(person_dim.person_skey,- 1 )as request_assigned_person_skey, requests.started_at as request_started_datetime, requests.completed_at as request_completed_datetime, requests.cancelled_at as request_cancelled_datetime, requests.assigned_at as request_assigned_datetime, requests.at_risk_at as request_at_risk_datetime, requests.overdue_at as request_overdue_datetime, unix_timestamp(requests.completed_at) - unix_timestamp(requests.started_at) as request_time_taken_seconds, requests_types.sla_duration as request_type_sla_duration, requests_types.request_duration as request_type_duration, requests_types.at_risk_duration as request_type_at_risk_duration, requests.VoyageId as voyage_id, requests.batchtime as batchtime, requests.part_date as part_dt from(select * from ( select * from ( select id ,public_id ,CASE WHEN shipcode IS NULL THEN 'SC' ELSE shipcode END as ship_code ,place_id ,description ,created ,priority ,request_type ,place_deck_id ,place_section_id ,assigned ,created_by ,loyalty ,started_at ,completed_at ,assigned_at ,at_risk_at ,overdue_at ,cancelled_at ,voyage_number ,VoyageId ,batchtime ,part_date ,row_number() over(partition by public_id order by batchtime desc) rn from shipdw.hvtb_parse_vxp_housekeeping_requests ) where rn = 1)requests *whereclause*)requests left join shipdw.hvtb_parse_vxp_housekeeping_request_types requests_types on requests.request_type = requests_types.id  left join ( select voyage_number, voyage_skey, ship_code, voyage_start_date, voyage_end_date, src_active_flag, src_deleted_flag, voyage_id from ( select voyage_number, voyage_skey, ship_code, voyage_start_date, voyage_end_date, src_active_flag, src_deleted_flag, voyage_id, row_number() over (partition by cruise_id order by upd_dt desc) rn from shipdw.hvtb_mart_dim_voyage where src_active_flag = true and src_deleted_flag = false) where rn = 1) voyage_dim on (requests.voyage_number = voyage_dim.voyage_number) left join ( select * from ( select * , row_number() over(partition by global_venue_id order by id desc) rn from shipdw.hvtb_parse_vxp_locationcon_venues ) where rn = 1) venues on requests.place_id = venues.id left join shipdw.hvtb_mart_dim_venue dim_venue on venues.global_venue_id = dim_venue.venue_id left join shipdw.hvtb_mart_dim_request_detail request_detail on request_detail.request_id = requests.public_id left join ( select * from ( select teammemberid, teammembernumber, row_number() over(partition by teammemberid order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_dxpcore_teammember)teammember where teammember.rn = 1) team on requests.assigned = team.teammemberid left join ( select person_skey, person_id  from ( select person_skey, person_id, reservationguest_guid, row_number() over (partition by person_id order by booking_departure_date desc) as rn from shipdw.hvtb_mart_dim_person) where rn = 1) person_dim on team.teammembernumber = person_dim.person_id  left join  ( select voyage_number, voyage_skey, ship_code, voyage_start_date, voyage_end_date, src_active_flag, src_deleted_flag, voyage_id from ( select voyage_number, voyage_skey, ship_code, voyage_start_date, voyage_end_date, src_active_flag, src_deleted_flag, voyage_id, row_number() over (partition by cruise_id order by upd_dt desc) rn from shipdw.hvtb_mart_dim_voyage where src_active_flag = true and src_deleted_flag = false) where rn = 1) voyage_dim1 on (to_date(requests.created) between to_date(voyage_dim1.voyage_start_date) and to_date(voyage_dim1.voyage_end_date) AND requests.ship_code = voyage_dim1.ship_code) ) request) request1 where rn = 1
