spark.source.sql SELECT mxp_res.reservation_id AS reservation_id, mxp_res.voyageid AS voyage_id, NVL(vdim.voyage_skey, -1) AS voyage_skey, NVL(detail_dim.dining_reservation_detail_skey, -1) AS dining_reservation_detail_skey, NVL(pdim.person_skey, -1) AS served_by_skey, mxp_res.BatchTime AS batchtime, mxp_res.Part_Date AS part_date FROM ( SELECT * FROM ( SELECT reservation_id, last_changed, guid, table_by_meal_id, voyageid, batchtime, part_date, ROW_NUMBER() OVER (PARTITION BY reservation_id ORDER BY last_changed DESC)rn FROM shipdw.hvtb_parse_mxp_vvirgin_reservations_rescrew_lad) WHERE rn = 1)mxp_res LEFT JOIN shipdw.hvtb_mart_dim_dining_reservation_detail detail_dim ON lower(mxp_res.guid)= detail_dim.dining_reservation_id LEFT JOIN ( SELECT * FROM ( SELECT voyage_id, public_id, lastmodifieddate, ROW_NUMBER() OVER(PARTITION BY public_id ORDER BY lastmodifieddate DESC) rn FROM shipdw.hvtb_parse_vxp_table_management_reservation) WHERE rn = 1)reservations ON reservations.public_id = mxp_res.guid LEFT JOIN ( SELECT * FROM ( SELECT public_id, code, lastmodifieddate, ROW_NUMBER() OVER(PARTITION BY public_id ORDER BY lastmodifieddate DESC)rn FROM shipdw.hvtb_parse_vxp_table_management_voyages) WHERE rn = 1)voyages ON reservations.voyage_id = voyages.public_id LEFT JOIN ( SELECT * FROM ( SELECT voyage_skey, voyage_number, voyage_id, voyage_start_date, voyage_end_date, ship_code, upd_dt, ROW_NUMBER() OVER(PARTITION BY voyage_number, ship_code ORDER BY upd_dt DESC) rn FROM shipdw.hvtb_mart_dim_voyage WHERE src_active_flag = TRUE AND src_deleted_flag = FALSE) WHERE rn = 1) vdim ON vdim.voyage_number = voyages.code LEFT JOIN ( select * from ( select table_by_meal_id, person_work_schedule_id, last_changed, row_number() over(partition by table_by_meal_id order by last_changed desc) rn from shipdw.hvtb_parse_mxp_person_schedule_tables) where rn = 1 ) pst on mxp_res.table_by_meal_id = pst.table_by_meal_id left join ( select * from ( select person_work_schedule_id, person_id, last_changed, row_number() over (partition by person_work_schedule_id order by last_changed desc ) rn from shipdw.hvtb_parse_mxp_person_work_schedules) where rn = 1) pws on pst.person_work_schedule_id = pws.person_work_schedule_id LEFT JOIN ( SELECT * FROM ( SELECT person_skey, person_id, reservationguest_guid, upd_dt, ROW_NUMBER() OVER (PARTITION BY person_id ORDER BY upd_dt DESC)rn FROM shipdw.hvtb_mart_dim_person where person_id != 0) WHERE rn = 1) pdim ON pws.person_id = pdim.person_id
