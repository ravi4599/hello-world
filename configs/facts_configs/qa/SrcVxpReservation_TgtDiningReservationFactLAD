spark.source.sql select NVL(voyages.code, - 1) as voyage_id, NVL(voyage_dim.voyage_skey, - 1) as voyage_skey, NVL(voyage_dim.ship_code, - 1) as ship_code, NVL(dining_dim.dining_reservation_detail_skey , - 1) as dining_reservation_detail_skey, NVL(venue_dim.venue_skey , - 1 ) as venue_skey, res.addeddate as reservation_booked_datetime_utc, res.res_timestamp as reservation_datetime, res.public_id as reservation_id, res.waitlist_delay as waitlist_delay, guest.guest_cn as guest_count, res.anon_guest_count as anon_guest_count, mxp_res.partycheckouttime as reservation_checkout_datetime_utc, mxp_res.partysize as party_size_seated, NVL(dim_session.dining_session_skey, -1) as dining_session_skey, case when settings.seat_duration_enabled = true then settings.seat_duration when settings.seat_duration_enabled = false then seatingduration.duration else 0 end as expected_duration,case when res.waitlist_delay > 0 or res.waitlist_delay is not null then 'walkin' else 'No Walkin' end as walk_ins,res.lastmodifieddate as reservation_updated_datetime_utc,res.batchtime as batchtime, res.part_date as part_dt from ( select * from ( select * , row_number() over(partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_reservation_lad ) where rn = 1) res left join ( select * from ( select * , row_number() over(partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_voyages ) where rn = 1) voyages on res.voyage_id = voyages.public_id left join ( select * from ( select src_active_flag, voyage_number, voyage_skey, ship_code, src_deleted_flag, row_number() over(partition by voyage_number order by upd_dt desc)rn from shipdw.hvtb_mart_dim_voyage ) where rn = 1) voyage_dim on (voyages.code = voyage_dim.voyage_number and voyage_dim.src_active_flag = true and src_deleted_flag = false) left join shipdw.hvtb_mart_dim_dining_reservation_detail dining_dim on res.public_id = dining_dim.dining_reservation_id left join ( select * from ( select * , row_number() over(partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_venues ) where rn = 1) venue on res.venue_id = venue.public_id left join shipdw.hvtb_mart_dim_venue venue_dim on venue.external_id = venue_dim.venue_id left join ( select reservation_id, count(guest_id) as guest_cn from ( select reservation_id, guest_id from ( select guest_id, reservation_id, row_number () over (partition by reservation_id,guest_id order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_table_management_reservationguest) where rn = 1 ) rg group by reservation_id) guest on res.public_id = guest.reservation_id left join ( select * from ( select public_id, settings_id, lastmodifieddate, venue_id, row_number() over (partition by public_id order by lastmodifieddate desc ) rn from shipdw.hvtb_parse_vxp_table_management_sessions) where rn = 1) sessions on res.session_id = sessions.public_id left join shipdw.hvtb_mart_dim_dining_session dim_session on dim_session.dining_session_id = sessions.public_id left join ( select * from ( select public_id, origin_public_id, timeslot_duration, max_party_size, sailor_booking_allowed, reservation_type, seat_duration_enabled,seat_duration, lastmodifieddate, row_number() over(partition by public_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_settings) where rn = 1) settings on sessions.settings_id = settings.public_id left join ( select * from ( select public_id, origin_public_id, party_size, duration, settings_id, lastmodifieddate, row_number() over(partition by settings_id order by lastmodifieddate desc)rn from shipdw.hvtb_parse_vxp_table_management_settings_seatingduration) where rn = 1) seatingduration on settings.public_id = seatingduration.settings_id and seatingduration.party_size = (res.anon_guest_count + guest.guest_cn) left join (SELECT CASE when c.guest_order_status_id = 3 then c.last_changed else cast(concat(to_date(d.meal_date),' ',hour(d.meal_to_time) ,':',minute(d.meal_to_time)) as timestamp) end as partycheckouttime,b.reservation_size_of_party as partysize,b.reservation_id,b.guid as guid from (select * from (select guid,table_by_meal_id,meals_by_date_id,reservation_size_of_party,reservation_id, row_number() over(partition by guid order by last_changed desc) rn from shipdw.hvtb_parse_mxp_reservations ) where rn = 1) b left JOIN (select * from (select table_by_meal_id,guest_order_status_id,last_changed, row_number() over(partition by table_by_meal_id order by last_changed desc) rn from shipdw.hvtb_parse_mxp_guest_orders ) where rn = 1) c on b.table_by_meal_id =c.table_by_meal_id JOIN (select * from (select meals_by_date_id,meal_date,meal_to_time,row_number() over(partition by meals_by_date_id order by last_changed desc) rn from shipdw.hvtb_parse_mxp_meals_by_date ) where rn = 1) d on b.meals_by_date_id = d.meals_by_date_id) mxp_res on upper(res.public_id)= upper(mxp_res.guid)

