spark.source.sql SELECT payment.paymentid AS src_int_trans_id, payment.transactiontype AS trans_type, payment.transactionstatus AS trans_status, payment.gatewaytransactionstatus AS gateway_trans_status, payment.gatewayreferencenumber AS gateway_ref_number, payment.clientacknowledgementstatus AS client_ack_status, cast(payment.amount as float) AS trans_amt, payment.currencycode AS trans_currency, payment.token, cast(payment.paymentdate as timestamp) AS trans_timestamp, payment.reservationnumber as src_res_id, payment.receiptreferencenumber as receipt_ref_id,payment.paymentmodecode,payment.isdeleted,payment.consumertype,payment.transactionsubtype,payment.batchtime,payment.part_date from (select * from (select *, row_number()over(partition by paymentid order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_dxp_payment) pay where pay.rn=1) payment

spark.source.columns src_int_trans_id,trans_type,trans_status,gateway_trans_status,gateway_ref_number,client_ack_status,trans_amt,trans_currency,token,trans_timestamp,src_res_id,receipt_ref_id,paymentmodecode,isdeleted,consumertype,transactionsubtype

