are created

    create or replace TABLE IDS_dev.FINANCE_ACCTG.FRANCHISEE_POLLED_SALES_SNAPSHOT (
	BRAND_ID VARCHAR(16777216),
	REPORTING_PERIOD VARCHAR(16777216),
	CUSTOMER_NUMBER VARCHAR(16777216),
	CUSTOMER_NAME VARCHAR(16777216),
	rest_id VARCHAR(16777216),
	LOCAL_CURRENCY VARCHAR(16777216),
	LOCAL_NET_SALES_RETAIL VARCHAR(16777216),
	TRANSACTION_COUNT_RETAIL VARCHAR(16777216),
	LOCAL_GROSS_SALES VARCHAR(16777216),
	LOCAL_NET_SALES_WHOLESALE VARCHAR(16777216),
	TRANSACTION_COUNT_WHOLESALE VARCHAR(16777216),
	REPORTING_FREQUENCY VARCHAR(16777216),
	EXPECTED_SALES_DAYS VARCHAR(16777216),
	ACTUAL_SALES_DAYS VARCHAR(16777216),
	SNAPSHOT_DATE DATE,
	SOURCE_SYSTEM_NAME VARCHAR(16777216),
	LOAD_ID	number(38),
	LOAD_DTTM timestamp,	UPDATE_ID number(38),	UPDATE_DTTM timestamp
);

create OR REPLACE view IDH_DEV.D_FINANCE.FRANCHISEE_POLLED_SALES_SNAPSHOT as SELECT brand_id,rest_id,
reporting_frequency,
reporting_period,
expected_sales_days,
actual_sales_days,
snapshot_date FROM (
select 'ARG' AS brand_id,
rest_id AS rest_id,
reporting_frequency,
reporting_period,
expected_sales_days,
actual_sales_days,
snapshot_date, DENSE_RANK() OVER (PARTITION BY snapshot_date,reporting_frequency ORDER BY LOAD_id desc ) AS rn from IDS_DEV.FINANCE_ACCTG.FRANCHISEE_POLLED_SALES_SNAPSHOT WHERE brand_id = 'arbys'
union
select 'BRI' AS brand_id,
rest_id AS rest_id,
reporting_frequency,
reporting_period,
expected_sales_days,
actual_sales_days,
snapshot_date, DENSE_RANK() OVER (PARTITION BY snapshot_date,reporting_frequency ORDER BY LOAD_id desc ) AS rn from IDS_DEV.FINANCE_ACCTG.FRANCHISEE_POLLED_SALES_SNAPSHOT WHERE brand_id = 'bskn'
union
select 'DKN' AS brand_id,
rest_id AS rest_id,
reporting_frequency,
reporting_period,
expected_sales_days,
actual_sales_days,
snapshot_date, DENSE_RANK() OVER (PARTITION BY snapshot_date,reporting_frequency ORDER BY LOAD_id desc ) AS rn from IDS_DEV.FINANCE_ACCTG.FRANCHISEE_POLLED_SALES_SNAPSHOT WHERE brand_id = 'dnkn'
)T  WHERE rn = 1