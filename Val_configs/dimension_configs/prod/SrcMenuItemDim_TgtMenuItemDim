spark.source.sql select a.VoyageId as voyage_id, a.menuitemid as menu_item_id, a.skunumber as menu_item_sku_number, a.name as menu_item_name, a.smalldescription as menu_item_small_description, a.description as menu_item_long_description, b.name as menu_item_type_name, b.description as menu_item_type_description, c.pricetag as menu_item_plu_number,a.batchtime,a.part_date FROM (select * from (select * ,row_number() over ( partition by menuitemtypeid order by Part_Date desc) as rn from shipdw.hvtb_parse_vxp_foodnbev_menuitem )menuitem )a  LEFT JOIN (select * from (select * ,row_number() over( partition by menuitemtypeid order by Part_Date desc) as rn from shipdw.hvtb_parse_vxp_menuitemtype)menuitemtype where menuitemtype.rn=1)b ON  a.menuitemtypeid = b.menuitemtypeid LEFT JOIN (select * from (select * ,row_number() over ( partition by menuitemid order by Part_Date desc) as rn from shipdw.hvtb_parse_vxp_foodandbeverage_menuitemprice)menuitemprice where menuitemprice.rn=1)c ON  a.menuitemid = c.menuitemid
