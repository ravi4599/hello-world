spark.source.sql SELECT sale_detail.voyageid ,sale_detail.batchtime ,sale_detail.part_date as part_date ,sale_detail.sales_id as sales_id ,sale_detail.sales_operatornr ,sale_detail.sale_detail_src ,sale_detail.sales_receiptnr,sale_detail.sales_checkstatus ,sale_detail.sales_voyagenumber ,'N/A' AS location ,'N/A' AS line_type ,'N/A' AS line_status ,'N/A' AS line_description ,'N/A' AS src_deleted_flag ,sales_groups.sales_group_desc as sale_group_description FROM ( SELECT voyageid ,batchtime ,part_date ,sales_id ,sales_operatornr ,sale_detail_src ,sales_receiptnr ,sales_checkstatus ,sales_voyagenumber ,rn FROM ( SELECT sale.voyageid AS voyageid ,sale.batchtime AS batchtime ,sale.part_date AS part_date ,sale.sales_id AS sales_id ,cast(sale.sales_operatornr AS INT) AS sales_operatornr ,'POS' AS sale_detail_src ,sale.sales_receiptnr AS sales_receiptnr ,sale.sales_checkstatus AS sales_checkstatus ,sale.sales_voyagenumber AS sales_voyagenumber ,row_number() OVER ( PARTITION BY sales_id ORDER BY sales_created ,sales_checkstatus DESC ) AS rn FROM shipdw.hvtb_parse_mxp_pos_sales sale WHERE sale.sales_outletid != 1001000000100000170 OR sale.sales_outletname != 'Casino' ) a WHERE a.rn = 1 ) sale_detail LEFT JOIN ( SELECT * FROM ( SELECT check_id ,rec_changed ,sales_group_id ,row_number() OVER ( PARTITION BY check_id ORDER BY rec_changed DESC ) rn FROM shipdw.hvtb_parse_mxp_checks ) WHERE rn = 1 ) checks ON checks.check_id = sale_detail.sales_id LEFT JOIN ( SELECT * FROM ( SELECT sales_group_id ,sales_group_desc ,rec_changed ,row_number() OVER ( PARTITION BY sales_group_id ORDER BY rec_changed DESC ) rn FROM shipdw.hvtb_parse_mxp_pos_sales_groups ) WHERE rn = 1 ) sales_groups ON sales_groups.sales_group_id = checks.sales_group_id
