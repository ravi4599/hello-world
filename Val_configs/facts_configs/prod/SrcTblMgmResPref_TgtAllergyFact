spark.source.sql select cast(-1 as long) as order_detail_skey, cast(-1 as long) as menu_item_skey, NVL(dining_dim.dining_reservation_detail_skey,-1) as dining_reservation_detail_skey, NVL(person_dim.person_skey , -1) as person_skey, NVL(allergy_dim.allergy_skey, -1) as allergy_skey, 'Res_Preference' as allergy_details_category, cast(false as boolean) as src_deleted_flg, res.voyage_id as voyage_id, res.batchtime as batchtime, res.part_dt as part_dt from ( select resprf.reservation_id as reservation_id,resprf.code as code,case when (resprf.guest_id is null or resprf.guest_id='')then resguest.guest_id else resprf.guest_id end as guest_id, resprf.VoyageId as voyage_id,resprf.BatchTime as batchtime,resprf.Part_Date as part_dt from (select * from (select * , row_number() over(partition by  reservation_id, code order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_reservations_reservationpreference ) where rn = 1 and type = 'ALLERGEN') resprf join (select * from (select * , row_number() over(partition by reservation_id, guest_id order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_table_management_reservationguest ) where rn = 1) resguest on resprf.reservation_id = resguest.reservation_id where resguest.is_main = true) res left join shipdw.hvtb_mart_dim_dining_reservation_detail dining_dim on dining_dim.dining_reservation_id = res.reservation_id left join shipdw.hvtb_mart_dim_person person_dim on res.guest_id = person_dim.reservationguest_guid left join shipdw.hvtb_mart_dim_allergy allergy_dim on upper(res.code) = upper(allergy_dim.allergy_code) and allergy_dim.source = 'Table_Management' *whereclause*
spark.source.columns voyage_id,order_detail_skey,menu_item_skey,dining_reservation_detail_skey,person_skey,allergy_skey,allergy_details_category,src_deleted_flg
