ritical_winnings, 0 as sale_quantity, 0 as item_list_price_amount, 0 as tax_amount, 0 as discount_amount, 0 as discount_value, 0 as cost_of_goods, 0 as manual_adjustment_amount, totbuyin as debit_amount, totwalkwith as credit_amount, totbuyin-totwalkwith-0 as total_shared_revenue_amount, totbuyin-totwalkwith as total_collected_sales_amount, 1 as outlet_srcjoin_key from ( select VoyageId, batchtime, part_date, ptnid, dateinserted, devid, timeondevsec, avgwager, gamedph, theowin, totbuyin, totwalkwith, case when gstname = 'Virgin Voyages Scarlet Lady' then 'SC' when gstname = 'Virgin Voyages Valiant Lady' then 'VL' else '-1' end as shipcode from shipdw.hvtb_parse_konami_vw_odbc_dailyptnrtg) konami_src left join shipdw.hvtb_mart_dim_date dd on to_date(konami_src.dateinserted) = dd.`date` left join shipdw.hvtb_mart_dim_device dim_dev on (konami_src.devid == dim_dev.device_id)  *whereclause*) Konami_Sales left join ( select outlet_skey, 1 as outlet_dimjoin_key from shipdw.hvtb_mart_dim_outlet where outlet_name = 'Casino' limit 1) outlet_dim on (Konami_Sales.outlet_srcjoin_key == outlet_dim.outlet_dimjoin_key) left join ( select voyage_skey, voyage_number, voyage_start_date, voyage_end_date, ship_code from shipdw.hvtb_mart_dim_voyage where src_active_flag = true and src_deleted_flag = false) dim_voyage on (to_date(Konami_Sales.dateinserted) between to_date(dim_voyage.voyage_start_date) and to_date(dim_voyage.voyage_end_date) and dim_voyage.ship_code = Konami_Sales.shipcode) left join shipdw.hvtb_mart_dim_itinerary dim_itinerary on (dim_itinerary.src_deleted_flag == false and dim_itinerary.src_active_flag == true and to_date(Konami_Sales.dateinserted)== date(dim_itinerary.itinerary_day_date) and dim_voyage.voyage_number == dim_itinerary.voyage_number) ) knm where rn = 1 )konami_src

spark.persondimsource.sql select UPPER(dim.person_guid) as person_guid,count_person.booking_cruise_number,person_count as guest_count,voyage.voyage_length from shipdw.hvtb_mart_dim_person dim inner join  (select count(person_guid) as person_count,booking_cruise_number from shipdw.hvtb_mart_dim_person  where  person_type = '1'  group by hvtb_mart_dim_person.booking_cruise_number) count_person  on(count_person.booking_cruise_number==dim.booking_cruise_number)  inner join shipdw.hvtb_mart_dim_voyage voyage on   (dim.booking_cruise_number == voyage.voyage_number)

