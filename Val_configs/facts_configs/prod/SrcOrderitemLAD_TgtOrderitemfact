spark.source.sql select * from (Select orderid,voyage_id, ship_code, voyage_skey,order_detail_skey,menu_item_skey,order_item_sequence,order_item_quantity,order_item_cancelled_quantity,orderitem_price,batchtime,part_date from (select order.orderid,NVL(order.voyageid,'N/A') as voyage_id, NVL(dim_voyage.ship_code,'N/A') as ship_code, NVL(dim_voyage.voyage_skey ,-1) as voyage_skey, NVL(cast(dim_orderdetail.order_detail_skey as bigint),-1) as order_detail_skey, NVL(cast(dim_menuitem.menu_item_skey as bigint),-1) as menu_item_skey, order_detail.orderitemsequence as order_item_sequence, order_detail.orderqty as order_item_quantity,order_cancel.cancelledquantity as order_item_cancelled_quantity, menuitemprice.price as orderitem_price, order_detail.BatchTime as batchtime, order_detail.Part_Date as part_date from  (select * from (select * , row_number() over(partition by orderid order by modifieddate desc) as rn    from shipdw.hvtb_parse_vxp_foodnbev_order_orderitem_lad )ordr where ordr.rn=1 ) order   left join (select * from (select * ,row_number ()over (partition by reservationguestid order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_reservationguest)reguest where reguest.rn=1)   rguest on(UPPER(order.guestid) == UPPER(rguest.reservationguestid)) left join  ( select * from (select *, row_number() over (partition by reservationid order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_reservation )reser where reser.rn=1 )    reserv     on(UPPER(rguest.reservationid)== UPPER(reserv.reservationid))left join  (select * from shipdw.hvtb_mart_dim_voyage where src_active_flag = 'true' ) dim_voyage on  (UPPER(reserv.voyagenumber)==UPPER(dim_voyage.voyage_number))   left join shipdw.hvtb_mart_dim_order_detail dim_orderdetail on(dim_orderdetail.order_id==order.orderid) left join ( select * from (select   * ,row_number() over(partition by orderid,orderdetailid order by lastmodifieddate desc) as rn  from shipdw.hvtb_parse_vxp_foodnbev_orderdetail)od where od.rn=1)order_detail on(order_detail.orderid==order.orderid) left join shipdw.hvtb_mart_dim_menu_item dim_menuitem on(dim_menuitem.menu_item_id==order_detail.menuitemid) left join (select * from (select * ,row_number() over (partition by orderdetailid order by lastmodifieddate desc) as rn from shipdw.hvtb_parse_vxp_foodnbev_orderdetailcancel)oc where oc.rn=1) order_cancel on(order_cancel.orderdetailid==order_detail.orderdetailid) left join (select * from (select * , row_number() over (partition by price.menuitemid order by nvl(enddate,cast('2099-12-31' as date))desc,startdate desc ) as rn from shipdw.hvtb_parse_vxp_foodandbeverage_menuitemprice price)a where a.rn=1 ) menuitemprice on( order.orderdate between menuitemprice.startdate and NVL(menuitemprice.enddate,cast('2099-12-31' as date)) and menuitemprice.menuitemid==order_detail.menuitemid ) where order.status !=0 )a )orderitemfact


