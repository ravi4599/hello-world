spark.source.sql SELECT *,-1 as device_skey,0 as time_on_device_seconds,0.0 as avg_wager_amount,0 as casino_game_dph,0.0 as theoritical_winnings ,-1 as activity_skey, NVL((((debit_amount-credit_amount)* sale_quantity)-discount_amount),0) as total_collected_sales_amount, NVL((((debit_amount-credit_amount)* sale_quantity)-discount_amount)/(guest_count*voyage_length),0) as total_collected_sales_ap, NVL((((debit_amount-credit_amount)* sale_quantity)-discount_amount),0) as total_shared_revenue_amount , NVL((((debit_amount-credit_amount)* sale_quantity)-discount_amount)/(guest_count*voyage_length),0) as total_shared_revenue_ap  from ( SELECT person_account_detail_id,'FOLIO' as source_type,accnt_item.voyageid as voyage_id,NVL(sale_detail.sale_detail_skey, -1) as sale_detail_skey, -1 as pos_item_skey,  NVL(dim_voyage.voyage_skey,-1) as voyage_skey,  dim_voyage.ship_code as ship_code,NVL(folio_item.folio_item_skey, -1)as folio_item_skey, NVL(person_skey, -1) as person_skey,  NVL(itinerary.itinerary_skey, -1)itinerary_skey, -1 as outlet_skey, NVL(dd.date_id, -1) as sale_date_skey,  NVL(time_skey, -1) as sale_time_skey,-1 as venue_skey,-1 as charge_skey,accnt_item.quantity as sale_quantity, 0 as item_list_price_amount,NVL(accnt_item.credit_amount, 0) as credit_amount,   NVL(accnt_item.debit_amount, 0) as debit_amount, 0 as tax_amount,-1 as wearable_skey,NVL(accnt_item.discount_amount, 0) as discount_amount,0 as discount_value,0 as cost_of_goods,CASE when (UPPER(person_dim.person_type)=='COMPANY ACCOUNT')   THEN NVL((((NVL(debit_amount, 0)-NVL(credit_amount, 0)-NVL(discount_amount, 0))* quantity)),0) ELSE 0  end as manual_adjustment_amount,NVL(guest_count.voyage_length, 0) as voyage_length, NVL(guest_count,0) as guest_count,accnt_item.external_reference as booking_reference_number,accnt_item.batchtime as batchtime,accnt_item.part_date as part_date from   (select * from (select *,row_number() over (partition by person_account_detail_id order by last_changed desc) rn from shipdw.hvtb_parse_mxp_person_account_items_lad)acc_item_tb where acc_item_tb.rn=1) accnt_item    inner join  shipdw.hvtb_mart_lkp_revenue_category_rel revenue_rel on (   category_type='FOLIO_QUICKCODE'and accnt_item.org_unit_quick_code==revenue_rel.category_value) left join shipdw.hvtb_mart_dim_sale_detail sale_detail  on ( accnt_item.person_account_detail_id == sale_detail.sale_id) left join shipdw.hvtb_mart_dim_folio_item folio_item   on (accnt_item.org_unit_quick_code = folio_item.folio_item_quickcode) left join (select cruise_id,cruise_number from (select cruise_id,cruise_number,row_number() over (partition by cruise_id order by last_changed desc) rn from shipdw.hvtb_parse_mxp_cruise)cruise_tb where cruise_tb.rn=1) cruise on accnt_item.period_id=cruise.cruise_id  left join (select person_account_id,person_id from (select person_account_id,person_id,row_number() over (partition by person_account_id order by last_changed desc) rn from shipdw.hvtb_parse_mxp_person_account)acc_tb where acc_tb.rn=1)account_tb on  accnt_item.person_account_id=account_tb.person_account_id  left join (select person_id from (select person_id,row_number() over (partition by person_id order by last_changed desc) rn from shipdw.hvtb_parse_mxp_persons)person_tb where person_tb.rn=1)persons on  account_tb.person_id=persons.person_id  left join (select person_booking_id,person_id,cruise_id,rec_deleted from(select person_booking_id,person_id,cruise_id,rec_deleted,row_number() over (partition by person_booking_id order by last_changed desc) rn from shipdw.hvtb_parse_mxp_person_booking)person_boking_tb where person_boking_tb.rn=1) person_booking on  (person_booking.person_id=persons.person_id and cruise.cruise_id=person_booking.cruise_id and person_booking.rec_deleted=false)  left join (select person_skey,booking_id,person_id,person_type from shipdw.hvtb_mart_dim_person) person_dim on (person_booking.person_booking_id==person_dim.booking_id and persons.person_id = person_dim.person_id) left join  shipdw.hvtb_mart_dim_voyage dim_voyage  on(dim_voyage.src_active_flag=TRUE and dim_voyage.src_deleted_flag=FALSE and cruise.cruise_number == dim_voyage.voyage_number) left join shipdw.hvtb_mart_dim_date dd on date(accnt_item.business_day) = dd.`date`  left join shipdw.hvtb_nbx_core_time_dim dt on dt.second_of_day = hour(accnt_item.business_day)* 60 * 60 + minute(accnt_item.business_day)* 60 + second(accnt_item.business_day) left join (select src_active_flag,src_deleted_flag,voyage_number,itinerary_day_date,itinerary_skey from shipdw.hvtb_mart_dim_itinerary)  itinerary   on (itinerary.src_active_flag=True and itinerary.src_deleted_flag=False and itinerary.voyage_number == cruise.cruise_number and date(accnt_item.business_day) == date(itinerary.itinerary_day_date)) left join (  select count(*) as guest_count, voyage_number ,abs(voyage_length) as voyage_length  from shipdw.hvtb_mart_dim_voyage voyage inner join shipdw.hvtb_mart_dim_person person on (voyage.voyage_number==person.booking_cruise_number) where person_type='1'  group by voyage_number,abs(voyage_length))guest_count  on (guest_count.voyage_number==cruise.cruise_number)   )FOLIO_FACT
