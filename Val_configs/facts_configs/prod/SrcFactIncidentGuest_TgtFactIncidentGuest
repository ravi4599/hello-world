spark.source.sql SELECT incdent.incidentid, vdim.voyage_id as voyage_id, incdent.propertyid as ship_code, NVL(vdim.voyage_skey, -1) as voyage_skey, NVL(incdent_dtl.incident_detail_skey, -1) as incident_detail_skey, NVL(pdim.person_skey, -1) as impacted_guest_person_skey from ( select voyagenumber, incidentid, inci.impactedgues, propertyid, lastmodifieddate, batchtime, part_date from ( SELECT voyagenumber, incidentid, impactedgues, propertyid, lastmodifieddate, batchtime, part_date, row_number() over (partition by incidentid, impactedgues order by lastmodifieddate desc) as rn FROM ( select voyagenumber, incidentid, impactedgues, propertyid, lastmodifieddate, batchtime, part_date FROM shipdw.hvtb_parse_vxp_dxp_incident LATERAL VIEW explode(split(impactedguest, ',')) as impactedgues) ) inci where rn = 1)incdent LEFT JOIN ( SELECT * FROM ( SELECT voyage_id, voyage_skey, voyage_number, src_active_flag, src_deleted_flag, upd_dt, row_number() over(partition by voyage_number order by upd_dt desc)rn FROM shipdw.hvtb_mart_dim_voyage WHERE src_active_flag = true AND src_deleted_flag = false) where rn = 1)vdim ON incdent.voyagenumber = vdim.voyage_number LEFT JOIN ( SELECT incident_id, incident_detail_skey FROM shipdw.hvtb_mart_dim_incident_detail)incdent_dtl ON incdent.incidentid = incdent_dtl.incident_id LEFT JOIN ( SELECT * FROM ( SELECT person_skey, reservationguest_guid, upd_dt, row_number() over (partition by reservationguest_guid order by upd_dt desc)rn FROM shipdw.hvtb_mart_dim_person) where rn = 1)pdim ON incdent.impactedgues = pdim.reservationguest_guid *whereclause*
spark.source.columns voyage_id,ship_code,voyage_skey,incident_detail_skey,impacted_guest_person_skey
spark.pond.allColumns voyage_id as pond_voyage_id,ship_code as pond_ship_code,voyage_skey as pond_voyage_skey,incident_detail_skey as pond_incident_detail_skey ,impacted_guest_person_skey as pond_impacted_guest_person_skey,load_dt as pond_load_dt, upd_dt as pond_upd_dt,primaryhash as pond_primaryhash, md5_hash as pond_md5_hash,part_dt as pond_part_dt
