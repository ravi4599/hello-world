spark.source.sql select * from (select NVL(order_dim.order_detail_skey, -1) as order_detail_skey, cast(-1 as long) as menu_item_skey, cast(-1 as long) dining_reservation_detail_skey, NVL(person_dim.person_skey , -1) as person_skey, NVL(allergy_dim.allergy_skey, -1) as allergy_skey, 'Order' as allergy_details_category, orderallergy.isdeleted as src_deleted_flg, order.VoyageId as voyage_id, order.BatchTime as batchtime, order.Part_Date as part_dt from (select * from (select * , row_number() over(partition by orderid order by modifieddate desc) rn from shipdw.hvtb_parse_vxp_foodnbev_order ) where rn = 1) order join ( select * from (select * , row_number() over(partition by orderallergyid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_foodandbeverage_orderallergy ) where rn = 1) orderallergy on order.orderid  = orderallergy.orderid and order.status <> 0 left join shipdw.hvtb_mart_dim_order_detail order_dim on order.orderid  = order_dim.order_id left join shipdw.hvtb_mart_dim_person person_dim on order.delivertoguestid = person_dim.reservationguest_guid left join shipdw.hvtb_mart_dim_allergy allergy_dim on orderallergy.allergyid = allergy_dim.allergy_id) *whereclause* union select * from (select NVL(order_dim.order_detail_skey, -1) as order_detail_skey, NVL(menu_dim.menu_item_skey , -1) as menu_item_skey, cast(-1 as long) dining_reservation_detail_skey, NVL(person_dim.person_skey , -1) as person_skey, NVL(allergy_dim.allergy_skey, -1) as allergy_skey, 'Menu_Item' as allergy_details_category, cast(false as boolean) as src_deleted_flg, order.VoyageId as voyage_id, order.BatchTime as batchtime, order.Part_Date as part_dt from (select * from (select * , row_number() over(partition by orderid order by modifieddate desc) rn from shipdw.hvtb_parse_vxp_foodnbev_order ) where rn = 1) order join ( select * from (select * , row_number() over(partition by orderdetailid order by lastmodifieddate desc) rn from shipdw.hvtb_parse_vxp_foodnbev_orderdetail ) where rn = 1) orderdetail on order.orderid  = orderdetail.orderid and order.status <> 0 left join ( select * from (select * , row_number() over(partition by menuitemallergyid order by addeddate desc) rn from shipdw.hvtb_parse_vxp_foodandbeverage_menuitemallergy ) where rn = 1) menuitem on orderdetail.menuitemid = menuitem.menuitemid left join shipdw.hvtb_mart_dim_order_detail order_dim on order.orderid  = order_dim.order_id left join shipdw.hvtb_mart_dim_menu_item menu_dim on menuitem.menuitemid = menu_dim.menu_item_id left join shipdw.hvtb_mart_dim_person person_dim on order.delivertoguestid = person_dim.reservationguest_guid left join shipdw.hvtb_mart_dim_allergy allergy_dim on menuitem.allergyid = allergy_dim.allergy_id) *whereclause*
