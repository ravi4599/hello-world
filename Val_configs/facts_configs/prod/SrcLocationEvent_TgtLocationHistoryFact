spark.source.sql select * from  (select  voyage_id,  ship_code,  voyage_skey,  person_skey,  venue_skey,  event_skey,  capture_date_utc_skey,  capture_time_utc_skey,  capture_datetime_utc,  capture_date_local_skey,  capture_time_local_skey,  capture_datetime,  location_event_type,  location_room,  location_level,  location_tags,  logicalplace,  src_locationeventid,  batchtime,  part_date    from  (select  *,  row_number () over (partition by capture_datetime order by batchtime desc,voyage_start_date asc) as rn    from    (SELECT  vdim.voyage_id AS voyage_id,  loc.ship_code,  NVL(vdim.voyage_skey,-1) AS voyage_skey,  NVL(pdim.person_skey,-1) AS person_skey,  NVL(venueDim.venue_skey,  -1) AS venue_skey,  NVL(eventDim.event_skey,-1) AS event_skey,  NVL(ddim.date_id,-1) AS capture_date_utc_skey,  NVL(tdim.time_skey,-1) AS capture_time_utc_skey,  loc.capturedate AS capture_datetime_utc,  vdim.voyage_start_date,  NVL(ddim.date_id,-1) AS capture_date_local_skey,  NVL(tdim.time_skey + utcoffset * 60,-1) AS capture_time_local_skey,  CAST(unix_timestamp(capturedate) + loc.utcoffset * 60 AS TIMESTAMP) AS capture_datetime,  loc.eventtype AS location_event_type,  loc.room AS location_room,  loc.level AS location_level,  loc.roomtags AS location_tags,  loc.logicalplace AS logicalplace,  loc.locationeventid AS src_locationeventid,  loc.batchtime as batchtime,  loc.part_date as part_date  FROM  (  select  hostid,  room,  capturedate,  utcoffset,  NVL  (CASE WHEN structure = 'Scarlet_Lady' THEN 'SC'  ELSE structure  END,  -1) AS ship_code,  structure,  eventtype,  room,  level,  roomtags,  logicalplace,  locationeventid,  batchtime,  part_date  from  (  select  hostid,  room,  capturedate,  utcoffset,  structure,  eventtype,  room,  level,  roomtags,  logicalplace,  locationeventid,  batchtime,  part_date,  row_number() over (partition by hostid,  room  order by  capturedate desc) as rn  from  shipdw.hvtb_parse_vxp_loca_locationevent  where  hosttype = 'RG'  and eventtype in ('Enter', 'Exit'))  where  rn = 1) AS loc  LEFT JOIN (  select  voyage_number,  voyage_skey,  ship_code,  voyage_start_date,  voyage_end_date,  src_active_flag,  src_deleted_flag,  voyage_id  from  (  select  voyage_number,  voyage_skey,  ship_code,  voyage_start_date,  voyage_end_date,  src_active_flag,  src_deleted_flag,  voyage_id,  row_number() over (partition by cruise_id  order by  upd_dt desc,voyage_start_date desc) rn  from  shipdw.hvtb_mart_dim_voyage where src_active_flag = true  and src_deleted_flag = false)  where  rn = 1) AS vdim ON  (to_date(loc.capturedate) BETWEEN to_date(vdim.voyage_start_date) AND to_date(vdim.voyage_end_date)  AND loc.ship_code = vdim.ship_code)    LEFT JOIN (  select  person_skey,  reservationguest_guid    from  (  select person_skey, person_id, reservationguest_guid,  row_number() over (partition by person_id,reservationguest_guid order by booking_departure_date desc) as rn  from  shipdw.hvtb_mart_dim_person)  where  rn = 1) AS pdim ON  loc.hostid = pdim.reservationguest_guid  LEFT JOIN (  select  venue_name,  venue_skey  from  (  select  venue_name,  venue_skey,  row_number() over(partition by venue_name  order by  upd_dt desc)rn  from  shipdw.hvtb_mart_dim_venue)  where  rn = 1) AS venueDim ON  venueDim.venue_name = loc.room  LEFT JOIN shipdw.hvtb_mart_dim_event eventDim ON  (eventDim.venue_skey = venueDim.venue_skey) AND  (to_date(loc.capturedate) = to_date(eventDim.event_start_time) AND  loc.capturedate > eventDim.event_start_time AND  loc.capturedate < CAST(unix_timestamp(eventDim.event_start_time) + eventDim.event_duration_minutes * 60 AS TIMESTAMP)  )    INNER JOIN shipdw.hvtb_mart_dim_date ddim ON  ddim.date = to_date(loc.capturedate)  INNER JOIN shipdw.hvtb_nbx_core_time_dim tdim ON  (tdim.second_of_day = hour(loc.capturedate)* 3600 + minute(loc.capturedate)* 60 + second(loc.capturedate))  ) location) location1 where rn = 1  ) loc
