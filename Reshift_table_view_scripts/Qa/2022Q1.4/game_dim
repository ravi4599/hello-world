CREATE EXTERNAL TABLE hive_schema_stg.game_dim(
    voyage_id varchar(100),
    game_skey bigint,
    game_id varchar(100),
    game_name varchar(100),
    game_master_prom varchar(100),
    game_is_bet_type_flag boolean,
    load_dt timestamp,
    upd_dt timestamp,
    primaryhash varchar(100),
    md5_hash varchar(100)
)
STORED AS PARQUET LOCATION 's3://vv-qa-emr-cluster/data/mart/hvtb_mart_dim_game';


create or replace view shipdw.game_dim as select * from hive_schema_stg.game_dim with no schema binding;