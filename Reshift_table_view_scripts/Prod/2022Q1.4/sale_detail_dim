CREATE EXTERNAL TABLE hive_schema_stg.sale_detail_dim(sale_detail_skey bigint
, voyage_id varchar(256)
, sale_id bigint
, sale_detail_src varchar(256)
, sale_operator_num int
, receipt_number int
, check_status varchar(256)
, sales_voyagenumber varchar(256)
, "location" varchar(256)
, line_type varchar(256)
, line_status varchar(256)
, line_description varchar(256)
, sale_group_description varchar(256)
, load_dt timestamp
, upd_dt timestamp
, primaryhash varchar(256)
, md5_hash varchar(256)
)
ROW FORMAT SERDE 'org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe'
WITH SERDEPROPERTIES ( 'serialization.format'='1')
STORED AS INPUTFORMAT 'org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat' OUTPUTFORMAT 'org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat'
LOCATION 's3://vv-prod-emr-cluster/data/mart/hvtb_mart_dim_sale_detail';

CREATE OR REPLACE VIEW shipdw.sale_detail_dim AS SELECT * FROM hive_schema_stg.sale_detail_dim with no schema binding;