CREATE EXTERNAL TABLE hive_schema_stg.terminal_checkin_fact (
    voyage_id varchar(100),
	voyage_skey bigint,
	ship_code varchar(10),
	checkin_id varchar(100),
	checkin_type varchar(20),
	person_skey bigint,
	person_type varchar(20),
	checkin_start_date timestamp,
	checkin_end_date timestamp,
	checkin_time_in_seconds timestamp,
	load_dt timestamp,
	upd_dt timestamp,
	part_dt date
)
STORED AS PARQUET LOCATION 's3://vv-prod-emr-cluster/data/mart/terminal_checkin_fact';

create or replace view shipdw.terminal_checkin_fact as select * from hive_schema_stg.terminal_checkin_fact with no schema binding;



