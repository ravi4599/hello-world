CREATE EXTERNAL TABLE hive_schema_stg.preference_dim(
preference_skey int8 ,
	voyage_id varchar(50),
	preference_id int4,
	person_id int4 ,
	preference_category_code varchar(50),
	category varchar(50),
	description varchar(50),
	comment varchar(50),
	allergy varchar(50),
	allergy_code varchar(50),
	preference_upd_date timestamp ,
	src_deleted_flag boolean,
  load_dt timestamp, 
  upd_dt timestamp, 
  primaryhash varchar(50), 
  md5_hash varchar(50))
STORED AS PARQUET  
LOCATION
  's3://vv-prod-emr-cluster/data/mart/hvtb_mart_dim_preference' 
  
CREATE OR REPLACE VIEW shipdw.preference_dim AS SELECT * FROM hive_schema_stg.preference_dim with no schema binding;