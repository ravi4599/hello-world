CREATE VIEW `vv_db.tmp_pricing_detail` AS select
    `hvtb_nbx_core_pricing_detail`.`src_sail_id`,
    `hvtb_nbx_core_pricing_detail`.`sail_id`,
    `hvtb_nbx_core_pricing_detail`.`price_code`,
    `hvtb_nbx_core_pricing_detail`.`num_of_adults_passed`,
    `hvtb_nbx_core_pricing_detail`.`max_available_capacity`,
    `hvtb_nbx_core_pricing_detail`.`guestseq`,
    `hvtb_nbx_core_pricing_detail`.`amount`,
    `hvtb_nbx_core_pricing_detail`.`category`,
    `hvtb_nbx_core_pricing_detail`.`currency`,
    `hvtb_nbx_core_pricing_detail`.`price_totals`,
    `hvtb_nbx_core_pricing_detail`.`sail_date_from`,
    `hvtb_nbx_core_pricing_detail`.`sail_date_to`,
    `hvtb_nbx_core_pricing_detail`.`load_dt`
from
    `vv_db`.`hvtb_nbx_core_pricing_detail`
where
     `hvtb_nbx_core_pricing_detail`.`num_of_adults_passed` = `hvtb_nbx_core_pricing_detail`.`max_available_capacity`;