CREATE EXTERNAL TABLE vv_db.hvtb_lnd_vxp_shipping_company(
	shippingcompanyid string,
	name string,
	trackingurl string,
	isdeleted boolean,
	addeddate timestamp,
	addedby string,
	lastmodifieddate timestamp,
	lastmodifiedby string,
  voyageid string, 
  batchtime timestamp)
PARTITIONED BY ( 
  part_date date)
ROW FORMAT SERDE 
  'org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe' 
STORED AS INPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat' 
OUTPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat'
LOCATION
  's3://vv-qa-emr-cluster/data/landing/VXP/hvtb_lnd_vxp_shipping_company'
  
  
 ##############################################################
 
 create view vv_db.hvtb_parse_vxp_shipping_company as select * from vv_db.hvtb_lnd_vxp_shipping_company  ;