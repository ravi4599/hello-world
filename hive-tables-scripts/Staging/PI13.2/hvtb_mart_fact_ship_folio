spark.sql(""" CREATE EXTERNAL TABLE shipdw.hvtb_mart_fact_ship_folio(
	voyage_id string,
	folio_detail_skey bigint,
	folio_item_skey bigint,
	person_skey bigint,
	ship_code string,
	voyage_skey bigint,
	itinerary_skey bigint,
	sale_date_skey bigint,
	sale_time_skey bigint,
	booking_reference_number string,
	sale_quantity int,
	debit_amount double,
	credit_amount double,
	discount_amount double,
	total_collected_sales_amount double,
	load_dt timestamp,
	upd_dt timestamp,
	primaryhash string, 
	md5_hash string
	)
PARTITIONED BY ( 
		part_dt date)
	ROW FORMAT SERDE 
	'org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe'
	WITH SERDEPROPERTIES (
	'serialization.format' = '1'
	)   
	STORED AS INPUTFORMAT 
	'org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat' 
	OUTPUTFORMAT 
	'org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat'
	LOCATION
	's3://vv-staging-emr-cluster/data/mart/hvtb_mart_fact_ship_folio' """)