CREATE EXTERNAL TABLE shipdw.hvtb_lnd_vxp_dxp_statustype(
	statustypeid string,
	code string,
	namekey string,
	isdeleted boolean,
	addeddate timestamp,
	addedby string,
	lastmodifieddate timestamp,
	lastmodifiedby string,
	VoyageId string, 
	BatchTime timestamp, 
	ShipCode string)
	PARTITIONED BY (Part_Date date)
ROW FORMAT SERDE 
  'org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe' 
STORED AS INPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat' 
OUTPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat'
LOCATION
  's3://vv-staging-emr-cluster/data/landing/vxp/hvtb_lnd_vxp_dxp_statustype';
  
CREATE OR REPLACE VIEW shipdw.hvtb_parse_vxp_dxp_statustype as select * from shipdw.hvtb_lnd_vxp_dxp_statustype;