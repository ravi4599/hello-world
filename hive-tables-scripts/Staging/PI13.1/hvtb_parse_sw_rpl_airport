CREATE EXTERNAL TABLE vv_db.hvtb_parse_sw_rpl_airport (
	airport_id int,
	airport_code string,
	airport_name_typed string,
	airport_name string,
	state_code string,
	country_code string,
	is_active string,
	comments string,
	active_cng_timestamp timestamp)
PARTITIONED BY ( 
  part_date date)
ROW FORMAT SERDE 
  'org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe' 
STORED AS INPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat' 
OUTPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat'
LOCATION
  's3://vv-staging-emr-cluster/data/parse/seaware/hvtb_parse_sw_rpl_airport';