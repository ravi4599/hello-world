CREATE EXTERNAL TABLE vv_db.hvtb_lnd_vxp_shipment(
	shipmentid string,
	shippedto string,
	trackingnumber string,
	shippingcompanyid string,
	statuscode string,
	shippeddate timestamp,
	fulfilmentlocationid string,
	isdeleted boolean,
	addeddate timestamp,
	addedby string,
	lastmodifieddate timestamp,
	lastmodifiedby string,
	statuschangedby string,
	statuschangeddate timestamp ,
  voyageid string, 
  batchtime timestamp)
PARTITIONED BY ( 
  part_date date)
ROW FORMAT SERDE 
  'org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe' 
STORED AS INPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat' 
OUTPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat'
LOCATION
  's3://vv-staging-emr-cluster/data/landing/VXP/hvtb_lnd_vxp_shipment'
 
############################################################

create view vv_db.hvtb_parse_vxp_shipment as select * from vv_db.hvtb_lnd_vxp_shipment  ;