CREATE EXTERNAL TABLE shipdw.hvtb_mart_fact_incident_guest(
	voyage_id string,
	ship_code string,
	voyage_skey int,
	incident_detail_skey bigint,
	impacted_guest_person_skey bigint,
	load_dt timestamp,
	upd_dt timestamp,
	primaryhash string, 
	md5_hash string)
	PARTITIONED BY ( 
		part_dt date)
	ROW FORMAT SERDE 
	'org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe'
	WITH SERDEPROPERTIES (
	'serialization.format' = '1'
	)   
	STORED AS INPUTFORMAT 
	'org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat' 
	OUTPUTFORMAT 
	'org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat'
	LOCATION
	's3://vv-dev-emr-cluster/data/mart/hvtb_mart_fact_incident_guest';
