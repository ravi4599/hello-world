CREATE EXTERNAL TABLE vv_db.hvtb_lnd_vxp_trackable(
trackableid string,
	trackablelotid string,
	rfid string,
	companyname string,
	uuid string,
	major int,
	minor int,
	doorlockid string,
	lastallocateddate date ,
	isdamaged boolean,
	islost boolean,
	addeddate timestamp,
	addedby string,
	lastmodifieddate timestamp,
	lastmodifiedby string,
	isdeleted boolean,
	trackabletypeid string,
	beaconid string,
	statuscode string,
  voyageid string, 
  batchtime timestamp)
PARTITIONED BY ( 
  part_date date)
ROW FORMAT SERDE 
  'org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe' 
STORED AS INPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat' 
OUTPUTFORMAT 
  'org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat'
LOCATION
  's3://vv-prod-emr-cluster/data/landing/VXP/hvtb_lnd_vxp_trackable'


create view vv_db.hvtb_parse_vxp_trackable as select * from vv_db.hvtb_lnd_vxp_trackable ;
  
  