CREATE OR REPLACE EXTERNAL TABLE hive_schema_stg.virtual_queue_fact (

    voyage_id String,

    ship_code String,

    voyage_skey bigint,

    virtual_queue_detail_skey bigint,

    virtual_queue_definition_skey bigint,

    person_skey bigint,

    queue_joined_datetime timestamp,

    queue_canceled_datetime timestamp,

    queue_notified_datetime timestamp,

    queue_completed_datetime timestamp,

    queue_total_wait_time_seconds int,
	
    load_dt timestamp,

    upd_dt timestamp,

    primaryhash String,

    md5_hash String,

    part_dt date

)
OPTIONS (
  format = 'PARQUET',
  uris = ['gs://vv-dev-nbx-cluster/data/mart/hvtb_mart_fact_virtual_queue/*']
);


CREATE OR REPLACE EXTERNAL TABLE hive_schema_stg.virtual_queue_fact
WITH PARTITION COLUMNS
OPTIONS (
  uris=['gs://vv-dev-nbx-cluster/data/mart/hvtb_mart_fact_virtual_queue/*'],
  format=PARQUET,
  hive_partition_uri_prefix='gs://vv-dev-nbx-cluster/data/mart/hvtb_mart_fact_virtual_queue/'
);

CREATE OR REPLACE VIEW shipdw.virtual_queue_fact AS SELECT * FROM hive_schema_stg.virtual_queue_fact;