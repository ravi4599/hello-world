CREATE OR REPLACE EXTERNAL TABLE hive_schema_stg.game_dim(voyage_id string                               
, game_skey bigint                                                                                  
, game_id string                                                                              
, game_name string                                                                            
, game_master_prom string                                                                     
, game_is_bet_type_flag boolean                                                                     
, load_dt timestamp                                                                                 
, upd_dt timestamp                                                                                  
, primaryhash string                                                                          
, md5_hash string                                                                             
)                                     
OPTIONS (
  format = 'PARQUET',
  uris = ['gs://vv-cert-nbx-cluster/data/mart/hvtb_mart_dim_game/*']
);


CREATE OR REPLACE VIEW shipdw.game_dim AS SELECT * FROM hive_schema_stg.game_dim;
