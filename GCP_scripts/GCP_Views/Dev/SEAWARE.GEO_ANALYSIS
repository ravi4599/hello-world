CREATE or replace EXTERNAL TABLE hive_schema_stg.geo_analysis (
    geo_flag string,
    country string,
    state string,
    zip string,
    lat_sailor float64,
    long_sailor float64,
    lat_miami float64,
    long_miami float64,
    distance_miles float64,
    distance_group float64,
    msa string,
    mapped_msa string,
    msa_personal_income float64,
    target_population_quantity float64,
    total_population_quantity float64)
	OPTIONS(
	format="CSV",
	uris=["gs://vv-dev-nbx-cluster/data/core/util/Geo_Analysis/*.csv"],
	field_delimiter=',',
  skip_leading_rows = 1
	); 


CREATE or replace EXTERNAL TABLE hive_schema_stg.geography_dim (
    geo_id int,
    country string,
    zip string,
    latitude float64,
    longitude float64,
    state_code string,
    state_name string,
    city string,
    county_no string,
    county_name string,
    msa_no string,
    msa_name string,
    region_center string,
    region_name string,
    miles_from_miami float64,
    miles_group int,
    total_population int,
    target_population int,
   )OPTIONS(
	format="CSV",
	uris=["gs://vv-dev-nbx-cluster/data/core/util/Geo/*.csv"],
	field_delimiter=';'
	)



create or replace view seaware.Geo_Analysis as 
select * from (
SELECT 'geo_analysis' AS source, 
       ga.country, 
       ga.state, 
       ga.zip, 
       ga.lat_sailor, 
       ga.long_sailor, 
       ga.lat_miami, 
       ga.long_miami, 
       ga.distance_miles, 
       ga.distance_group, 
       ga.msa, 
       ga.mapped_msa, 
       ga.msa_personal_income, 
       ga.target_population_quantity, 
       ga.total_population_quantity 
FROM   hive_schema_stg.geo_analysis ga 
UNION ALL
SELECT 'geography_dim' AS source, 
       gd.country, 
       gd.state_code, 
       gd.zip, 
       gd.latitude, 
       gd.longitude, 
       25.7745         AS Lat_Miami, 
       -80.1709        AS Long_Miami, 
       gd.miles_from_miami, 
       gd.miles_group, 
       gd.msa_name, 
       gd.msa_name, 
       NULL            AS MSA_Personal_Income, 
       gd.target_population, 
       gd.total_population 
FROM   hive_schema_stg.geography_dim gd )
except distinct 
SELECT 'geography_dim' AS source, 
       gd.country, 
       gd.state_code, 
       gd.zip, 
       gd.latitude, 
       gd.longitude, 
       25.7745         AS Lat_Miami, 
       -80.1709        AS Long_Miami, 
       gd.miles_from_miami, 
       gd.miles_group, 
       gd.msa_name, 
       gd.msa_name, 
       NULL            AS MSA_Personal_Income, 
       gd.target_population, 
       gd.total_population 
FROM   hive_schema_stg.geo_analysis ga 
       JOIN hive_schema_stg.geography_dim gd 
         ON ga.country = gd.country 
            AND ga.state = gd.state_code 
            AND ga.zip = gd.zip 
;