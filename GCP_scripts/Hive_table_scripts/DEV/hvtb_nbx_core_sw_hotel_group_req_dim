import spark.sqlContext.implicits._
val srcPKCols ="HOTEL_GROUP_REQ_ID"
val srcColsPKList = srcPKCols.split(",")
val srcPKColSEQ = srcColsPKList.map(x => col(x)).toSeq
val srcAllColList = "HOTEL_GROUP_REQ_ID,rec_start_dttm,rec_end_dttm,effective_date,start_date,end_date,request_type,occupancy,quantity,n_of_guests,city_code,hotel_id,hotel_category,room_category,room_type,hotel_space_type,is_land_component"
val srcAllColArray = srcAllColList.split(",")
val srcAllColSEQ = srcAllColArray.map(x => col(x)).toSeq
val srcDF = spark.read.format("parquet").option("header","true").load("gs://vv-dev-nbx-cluster/data/core/seaware/hvtb_nbx_core_sw_hotel_group_req_dim/*")
val HashedSrcDF = srcDF.withColumn("md5_hash", md5(concat_ws(",", srcDF.select(srcAllColSEQ: _*).columns.map(c => col(c)): _*))).as("srh")

val HashedSrcPrimaryDF = HashedSrcDF.withColumn("primaryhash", md5(concat_ws(",", HashedSrcDF.select(srcPKColSEQ: _*).columns.map(c => col(c)): _*)))
val fd = HashedSrcPrimaryDF.withColumn("rec_start_dttm",lit(current_timestamp)).withColumn("rec_end_dttm",lit("9999-12-31 00:00:00"))
val w = Window.orderBy(monotonically_increasing_id())
var tempDf = fd.withColumn("rowId", monotonically_increasing_id())
tempDf = tempDf.withColumn("SRC_HOTEL_GROUP_REQ_ID", row_number().over(w) + 0).drop("rowId")
tempDf.createOrReplaceTempView("temp")
val finaldf = spark.sql("select cast(HOTEL_GROUP_REQ_ID as bigint ) as HOTEL_GROUP_REQ_ID,SRC_HOTEL_GROUP_REQ_ID,rec_start_dttm,cast(rec_end_dttm as timestamp) as rec_end_dttm,effective_date,start_date,end_date,request_type,occupancy,quantity,n_of_guests,city_code,hotel_id,hotel_category,room_category,room_type,hotel_space_type,is_land_component,etl_ld_dt as load_dt,etl_upd_dt as upd_dt,primaryhash,md5_hash from temp")
finaldf.write.mode("Overwrite").parquet("gs://vv-dev-nbx-cluster/data/temp/hvtb_nbx_core_sw_hotel_group_req_dim/")
finaldf.write.mode("Overwrite").parquet("gs://vv-dev-nbx-cluster/data/mart/hvtb_nbx_core_sw_hotel_group_req_dim/")
