sion_insurance_usd, cf.bonus_commission_voyagefare_regular_usd, cf.bonus_commission_voyagefare_protected_usd, cf.bonus_commission_voyagefare_manual_usd, cf.bonus_commission_usd, cf.voyagefare_commission_usd, cf.gsa_commission_voyagefare_usd, cf.gsa_commission_taxesandfees_usd, cf.gsa_commission_insurance_usd, cf.gsa_commission_shorex_usd, cf.gsa_commission_sailorloot_usd, cf.protected_commission_usd, cf.base_protected_commission_usd, cf.base_commission_other_bookable_usd,*/    
		seaware_invoice_item_type_lkp.invoice_item_type invoice_item_type,
