pipeline {

  agent {
      node {
          label 'master'
      }
  }

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }

  stages {
		stage('Checkout') {
			steps {
                cleanWs()
				    checkout([$class: 'GitSCM',
                    branches: [[name: "${branch}"]],
					userRemoteConfigs: [[
					credentialsId: 'jenkins-cicd',
					url: 'git@bitbucket.org:VirginVoyages/bigdata-scripts.git']]
					])
            }
        }        
    }
}
